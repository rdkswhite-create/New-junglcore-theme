{% doc %}
The NUBE buy box: the argument, the numbers, 1 or 3 bags, straight to checkout, or the same order over WhatsApp.
@param {object} product - The NUBE product.
@param {string} form_id - Unique form id.
@param {boolean} [show_title] - Show the big headline.
{% enddoc %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign per_glass = v.price | divided_by: 30
  assign three = v.price | times: 3
  assign price_one = v.price | money_without_trailing_zeros
  assign price_three = three | money_without_trailing_zeros
  assign wa_one = 'Hola, quiero pedir NUBE: 1 bolsa (' | append: price_one | append: '). Estoy en Bogotá.'
  assign wa_three = 'Hola, quiero pedir NUBE: 3 bolsas (' | append: price_three | append: '). Estoy en Bogotá.'
-%}
<div class="jcs-buy">
  <p class="jcs-eyebrow">NUBE · Barras congeladas de sacha inchi</p>
  {% if show_title %}<h2 class="jcs-buy__title">Tu bebida vegetal.<br>El agua la pones tú.</h2>{% endif %}
  <p class="jcs-buy__versus"><strong>Por vaso de 200 ml: 6,3 g de proteína frente a 1,0 g de la almendra más barata del súper.</strong> Con 3 bolsas y envío gratis, {{ per_glass | money_without_trailing_zeros }} frente a $1.650.</p>
  <ul class="jcs-facts">
    <li><strong>6,3 g</strong><span>Proteína por vaso</span></li>
    <li><strong>1,4 g</strong><span>Fibra</span></li>
    <li><strong>3</strong><span>Ingredientes</span></li>
  </ul>
  <p class="jcs-buy__together">Es comida, no un suplemento. Sin tarro, sin sobrecito.</p>
  <p class="jcs-buy__without">Ligera · 0 g de azúcar · Sin lácteos · Sin aceites añadidos</p>
  {% if settings.jc_sale_mode != 'a_la_venta' %}
    {% render 'jc-waitlist', product: product, form_id: form_id %}
  {% elsif v and v.price > 0 %}
    {% form 'product', product, id: form_id, class: 'jcs-buy__form' %}
      <input type="hidden" name="id" value="{{ v.id }}">
      <input type="hidden" name="return_to" value="/checkout">
      <fieldset class="jcs-options">
        <legend class="visually-hidden">Elige cuántas bolsas</legend>
        <label class="jcs-option">
          <input type="radio" name="quantity" value="1" checked>
          <span><span class="jcs-option__name">1 bolsa</span><span class="jcs-option__meta">30 vasos · {% render 'jc-delivered-total', variant: v, qty: 1 %} con envío · {% render 'jc-glass-price', variant: v, qty: 1 %} por vaso</span></span>
          <span class="jcs-option__price">{{ v.price | money_without_trailing_zeros }}</span>
        </label>
        <label class="jcs-option">
          <span class="jcs-option__tag">Envío gratis</span>
          <input type="radio" name="quantity" value="3">
          <span><span class="jcs-option__name">3 bolsas</span><span class="jcs-option__meta">90 vasos · envío gratis · {% render 'jc-glass-price', variant: v, qty: 3 %} por vaso</span></span>
          <span class="jcs-option__price">{{ three | money_without_trailing_zeros }}</span>
        </label>
      </fieldset>
      {% render 'jc-eta' %}
      <button type="submit" class="jcs-btn jcs-btn--full" {% unless v.available %}disabled{% endunless %}>
        {% if v.available %}<span>Comprar</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span>{% else %}<span>Agotada. Volvemos pronto.</span>{% endif %}
      </button>
    {% endform %}
    <a class="jcs-buy__wa" id="{{ form_id }}-wa" href="https://wa.me/573011571039?text={{ wa_one | url_encode }}" data-wa-1="https://wa.me/573011571039?text={{ wa_one | url_encode }}" data-wa-3="https://wa.me/573011571039?text={{ wa_three | url_encode }}" target="_blank" rel="noopener">¿Prefieres pedir por WhatsApp? <span aria-hidden="true">&rarr;</span></a>
    <script>
      (function () {
        var form = document.getElementById({{ form_id | json }});
        var wa = document.getElementById({{ form_id | append: '-wa' | json }});
        if (!form || !wa) return;
        form.addEventListener('change', function (e) {
          if (e.target.name !== 'quantity') return;
          wa.href = wa.getAttribute('data-wa-' + e.target.value) || wa.href;
        });
      })();
    </script>
  {% endif %}
  {%- assign check_id = form_id | append: '-check' -%}
  {% render 'jc-delivery-check', id: check_id %}
  <div class="jcs-buy__notes">
    <p><strong>Solo en Bogotá, por ahora.</strong> Lunes a sábado, sin festivos. Envío $20.000 · gratis desde $100.000.</p>
    <p><strong>Sacha inchi, agua y goma gelana.</strong> Los contamos con una mano y nos sobraron dos dedos.</p>
    <p><strong>¿A qué sabe?</strong> <img class="jcs-face" src="{{ 'jc-face-dato.jpg' | asset_url }}" width="80" height="80" loading="lazy" alt="Dato">Dato, nuestro robot, dice que a avena. Dato no tiene lengua. Los humanos: suave, un poco a nuez, sin dulce añadido. ¿La quieres más espesa? Menos agua.</p>
  </div>
  {%- assign city_id = form_id | append: '-city' -%}
  {% render 'jc-other-city', id: city_id %}
</div>
