{% doc %}
Invites a deliberate NUBE preparation ritual, followed by optional texture choices.
@param {string} heading_id - Unique heading identifier for this page.
@param {boolean} [show_film] - Show an expandable preparation film.
@param {boolean} [concise] - Omit repeated introduction and pricing on the homepage.
{% enddoc %}
<div class="jc-ritual-choice">
  <div class="jc-ritual-choice__opening"><h2 id="{{ heading_id | escape }}">{{ 'jc_ritual.title' | t }}<br>{{ 'jc_ritual.title_end' | t }}</h2><p class="jc-ritual-choice__moment">{{ 'jc_ritual.moment_intro' | t }}</p></div>
  <ol class="jc-ritual-choice__steps">
    <li><span aria-hidden="true">01</span><h4>{{ 'jc_ritual.take' | t }}</h4><p>{{ 'jc_ritual.take_copy' | t }}</p></li>
    <li><span aria-hidden="true">02</span><h4>{{ 'jc_ritual.blend' | t }}</h4><p>{{ 'jc_ritual.moment_blend' | t }}</p></li>
    <li><span aria-hidden="true">03</span><h4>{{ 'jc_ritual.enjoy' | t }}</h4><p>{{ 'jc_ritual.moment_enjoy' | t }}</p></li>
  </ol>
  {% if show_film %}
    <details class="jc-ritual-choice__film">
      <summary>{{ 'jc_ritual.film' | t }} <span aria-hidden="true">↓</span></summary>
      <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-landscape-loop.webp?v=1793647871" alt="{{ 'jc_ritual.film_alt' | t }}" width="910" height="512" loading="lazy">
    </details>
  {% endif %}
  <details class="jc-ritual-choice__options">
    <summary>{{ 'jc_breakfast.customise' | t }} <span aria-hidden="true">↓</span></summary>
    <p class="jc-ritual-choice__intro">{{ 'jc_ritual.intro' | t }}</p>
  <figure class="jc-ritual-choice__photo">
    <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-dos-preparaciones-nov2026.png?v=1793729269&width=1400" srcset="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-dos-preparaciones-nov2026.png?v=1793729269&width=600 600w, https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-dos-preparaciones-nov2026.png?v=1793729269&width=1000 1000w, https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-dos-preparaciones-nov2026.png?v=1793729269&width=1400 1400w" sizes="(max-width: 749px) 92vw, 1090px" width="1536" height="1024" loading="lazy" alt="{{ 'jc_ritual.image_alt' | t }}">
    <figcaption>
      <div><strong>{{ 'jc_ritual.thick' | t }}</strong><span>{{ 'jc_ritual.thick_prep' | t }}</span></div>
      <div><strong>{{ 'jc_ritual.light' | t }}</strong><span>{{ 'jc_ritual.light_prep' | t }}</span></div>
    </figcaption>
  </figure>
    {% unless concise %}<p class="jc-ritual-choice__statement">{{ 'jc_ritual.statement' | t }}</p>{% endunless %}
  </details>
  {% unless concise %}<p class="jc-ritual-choice__value"><span>{{ 'jc_ritual.value' | t }}</span><strong>{{ 'jc_ritual.portion_price' | t }}</strong></p>{% endunless %}
</div>
{% stylesheet %}
.jc-v2 .jc-ritual-choice__opening{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin:28px 0 0}
.jc-v2 .jc-ritual-choice__opening h2{margin:0}
.jc-v2 .jc-ritual-choice__moment{font-size:18px;font-weight:400;line-height:1.6;color:#41433f;max-width:460px;margin:0}
@media(max-width:749px){.jc-v2 .jc-ritual-choice__opening{grid-template-columns:1fr;gap:20px;margin-top:26px}.jc-v2 .jc-ritual-choice__moment{font-size:16px;max-width:36ch}}

.jc-v2 .jc-ritual-choice h2{font-size:clamp(30px,4vw,52px);font-weight:500;line-height:1.15;letter-spacing:-.025em;margin:32px 0 22px}
.jc-v2 .jc-ritual-choice__intro{font-size:clamp(16px,1.8vw,20px);line-height:1.6;color:#555951;max-width:720px;margin:0 0 36px}
.jc-v2 .jc-ritual-choice__photo{margin:0}
.jc-v2 .jc-ritual-choice__photo>img{display:block;width:100%;height:auto}
.jc-v2 .jc-ritual-choice__photo figcaption{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;padding:24px 0;border-bottom:1px solid #d4d4ce;text-align:center}
.jc-v2 .jc-ritual-choice__photo figcaption>div{display:flex;flex-direction:column;gap:8px}
.jc-v2 .jc-ritual-choice__photo strong{font-size:14px;font-weight:500;letter-spacing:.06em}
.jc-v2 .jc-ritual-choice__photo span{font-size:14px;line-height:1.5;color:#62645f}
.jc-v2 .jc-ritual-choice__statement{font-size:clamp(21px,2.6vw,32px);font-weight:500;letter-spacing:-.02em;line-height:1.35;max-width:850px;margin:42px 0 54px}
.jc-v2 .jc-ritual-choice__routine h3{font-size:clamp(23px,3vw,38px);font-weight:500;line-height:1.2;letter-spacing:-.02em;margin:0 0 18px}
.jc-v2 .jc-ritual-choice__routine>p{font-size:16px;line-height:1.65;color:#555951;margin:0;max-width:650px}
.jc-v2 .jc-ritual-choice__steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px;padding:0;margin:40px 0;list-style:none}
.jc-v2 .jc-ritual-choice__steps li{border-top:1px solid #bfc1b9;padding-top:20px}
.jc-v2 .jc-ritual-choice__steps li>span{display:block;font-size:12px;letter-spacing:.08em;color:#62645f;margin-bottom:18px}
.jc-v2 .jc-ritual-choice__steps h4{font-size:22px;font-weight:500;line-height:1.3;margin:0 0 14px}
.jc-v2 .jc-ritual-choice__steps p{font-size:15px;line-height:1.65;color:#555951;margin:0}
.jc-v2 .jc-ritual-choice__value{border-block:1px solid #d4d4ce;display:flex;flex-wrap:wrap;gap:12px 24px;padding:22px 0;margin:0;font-size:16px;line-height:1.5}
.jc-v2 .jc-ritual-choice__value strong{font-weight:500}
.jc-v2 .jc-ritual-choice__film{margin:24px 0 0}
.jc-v2 .jc-ritual-choice__film summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer;list-style:none;padding:16px 0;font-size:12px;letter-spacing:.06em}
.jc-v2 .jc-ritual-choice__film summary::-webkit-details-marker{display:none}
.jc-v2 .jc-ritual-choice__film img{display:block;width:100%;height:auto;margin-top:12px}
@media(max-width:749px){
.jc-v2 .jc-ritual-choice h2{font-size:clamp(29px,7.5vw,42px);margin:26px 0 20px}
.jc-v2 .jc-ritual-choice__intro{font-size:16px;margin-bottom:26px}
.jc-v2 .jc-ritual-choice__photo figcaption{gap:12px;padding:18px 0}
.jc-v2 .jc-ritual-choice__photo strong{font-size:11px}
.jc-v2 .jc-ritual-choice__photo span{font-size:12px}
.jc-v2 .jc-ritual-choice__statement{font-size:23px;margin:30px 0 38px}
.jc-v2 .jc-ritual-choice__steps{grid-template-columns:1fr;gap:24px;margin:32px 0}
.jc-v2 .jc-ritual-choice__steps li{padding-top:18px}
.jc-v2 .jc-ritual-choice__steps li>span{margin-bottom:10px}
.jc-v2 .jc-ritual-choice__steps h4{font-size:21px;margin-bottom:10px}
.jc-v2 .jc-ritual-choice__value{flex-direction:column;gap:6px;font-size:15px}
}
.jc-v2 .jc-ritual-choice__options{margin:28px 0;border-top:1px solid #d4d4ce}
.jc-v2 .jc-ritual-choice__options>summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer;list-style:none;padding:20px 0;font-size:12px;font-weight:500;line-height:1.6;letter-spacing:.055em}
.jc-v2 .jc-ritual-choice__options>summary::-webkit-details-marker{display:none}
.jc-v2 .jc-ritual-choice__options[open]>summary>span{transform:rotate(180deg)}
.jc-v2 .jc-ritual-choice__options .jc-ritual-choice__statement{margin-bottom:28px}
{% endstylesheet %}
