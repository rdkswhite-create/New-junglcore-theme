{% doc %}
JUNGLCORE header with announcement and a buy button on every page.
@param {string} [buy_href] - Where COMPRAR points. Defaults to the NUBE buy box.
{% enddoc %}
{%- liquid
  if buy_href == blank
    assign buy_href = routes.root_url | append: 'products/nube#jc-buy'
  endif
-%}
<p class="jcs-announce">{% if settings.jc_sale_mode != 'a_la_venta' %}Primera tanda: {{ settings.jc_launch_label | default: '20 de noviembre' }} · Solo en Bogotá{% else %}Solo en Bogotá, por ahora · Envío gratis desde 3 bolsas{% endif %}</p>
<header class="jcs-header">
  <div class="jcs-header__inner">
    <a class="jcs-header__logo" href="{{ routes.root_url }}" aria-label="JUNGLCORE inicio">
      <img src="{{ 'jc-wordmark-refined-black.svg' | asset_url }}" alt="junglcore" width="1329" height="313" loading="eager">
    </a>
    <nav class="jcs-header__nav" aria-label="Navegación">
      <a href="{{ routes.root_url }}products/nube">NUBE</a>
      <a href="{{ routes.root_url }}pages/exploraciones">JUNGLCORE LAB</a>
      <a href="{{ routes.root_url }}#jc-faq">Preguntas</a>
    </nav>
    <div class="jcs-header__actions">
      <a class="jcs-btn jcs-header__buy" href="{{ buy_href }}">{% if settings.jc_sale_mode != 'a_la_venta' %}Apúntate{% else %}Comprar{% endif %}</a>
      <button type="button" class="jcs-header__menu" aria-expanded="false" aria-controls="jcs-mobile-nav" aria-label="Abrir menú">
        <span class="jcs-header__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
  <nav class="jcs-mobile-nav" id="jcs-mobile-nav" aria-label="Menú" hidden>
    <a href="{{ routes.root_url }}products/nube"><span>NUBE</span><em>La bebida</em></a>
    <a href="{{ routes.root_url }}pages/exploraciones"><span>JUNGLCORE LAB</span><em>La bitácora de la nave</em></a>
    <a href="{{ routes.root_url }}#jc-faq"><span>Preguntas</span><em>Lo que nos preguntan</em></a>
    <a href="https://wa.me/573011571039" target="_blank" rel="noopener"><span>WhatsApp</span><em>Escríbenos</em></a>
  </nav>
  <script>
    (function () {
      var b = document.currentScript.parentNode.querySelector('.jcs-header__menu');
      var n = document.getElementById('jcs-mobile-nav');
      if (!b || !n) return;
      function set(open) {
        b.setAttribute('aria-expanded', String(open));
        b.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        n.hidden = !open;
        document.documentElement.classList.toggle('jcs-menu-open', open);
      }
      b.addEventListener('click', function () { set(b.getAttribute('aria-expanded') !== 'true'); });
      n.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    })();
  </script>
</header>
