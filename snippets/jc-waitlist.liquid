{% doc %}
Lote 001 · la lista. No buying until the batch opens: email + city, tagged lista-lote-001 and ciudad-<name> (fuera-bogota when not Bogotá), so the customer list shows who asked and from where. No free reservations.
@param {object} product - The NUBE product.
@param {string} form_id - Unique id.
{% enddoc %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign launch = settings.jc_launch_label | default: 'diciembre'
  assign per_glass = v.price | divided_by: 30
  assign email_id = form_id | append: '-email'
-%}
<div class="jcs-wait jcs-list" id="{{ form_id }}">
  <div class="jcs-wait__head">
    <p class="jcs-wait__tag">Lote 001</p>
    <p class="jcs-wait__date">{{ launch }}</p>
  </div>
  <p class="jcs-wait__lead"><strong>Lote 001 llega en {{ launch }}.</strong> No apartamos bolsas sin pago. Pero los que están en la lista se enteran primero y compran primero.</p>
  {% if v and v.price > 0 %}<p class="jcs-wait__price"><strong>{{ per_glass | money_without_trailing_zeros }} el vaso</strong> · 2 bolsas · 60 vasos · envío incluido</p><p class="jcs-wait__price jcs-wait__single">¿Solo una? {{ v.price | money_without_trailing_zeros }} la bolsa, más envío.</p>{% endif %}
  <p class="jcs-list__month"><strong>1 bolsa = hasta 6 cajas de 1 litro de bebida vegetal.</strong> Pesa 600 gramos.</p>

  {% form 'customer', id: email_id, class: 'jcs-wait__form' %}
    {% if form.posted_successfully? %}
      <p class="jcs-wait__ok" role="status"><strong>Estás en la lista.</strong> Te avisamos primero, un día antes que a nadie.</p>
    {% else %}
      <input type="hidden" name="contact[tags]" value="newsletter,lista-lote-001,ciudad-bogota" data-list-tags>
      <div class="jcs-list__fields">
        <label class="visually-hidden" for="{{ email_id }}-input">Tu correo</label>
        <input type="email" id="{{ email_id }}-input" name="contact[email]" placeholder="tu@correo.com" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        <label class="visually-hidden" for="{{ email_id }}-city">Tu ciudad</label>
        <select id="{{ email_id }}-city" data-list-city>
          <option selected>Bogotá</option>
          <option>Medellín</option>
          <option>Cali</option>
          <option>Barranquilla</option>
          <option>Bucaramanga</option>
          <option>Cartagena</option>
          <option>Pereira</option>
          <option>Manizales</option>
          <option>Cúcuta</option>
          <option>Ibagué</option>
          <option>Villavicencio</option>
          <option>Santa Marta</option>
          <option>Otra</option>
        </select>
        <button type="submit" class="jcs-btn jcs-btn--full"><span>Avísame</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></button>
      </div>
      {% if form.errors %}<p class="jcs-wait__err" role="alert">Revisa el correo. {{ form.errors.messages['email'] }}</p>{% endif %}
      <p class="jcs-wait__legal">Te avisamos del próximo lote y de cuándo llegamos a tu ciudad. Solo eso. Puedes salirte cuando quieras.{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">Política de datos</a>.{% endif %}</p>
    {% endif %}
  {% endform %}
  <a class="jcs-buy__wa jcs-buy__wa--quiet" href="https://wa.me/573011571039?text={{ 'Hola, tengo una duda sobre NUBE: ' | url_encode }}" target="_blank" rel="noopener">¿Dudas sobre el sabor, la preparación o la entrega? Escríbenos <span aria-hidden="true">&rarr;</span></a>
</div>
<script>
  (function () {
    var box = document.getElementById({{ form_id | json }}); if (!box) return;
    var sel = box.querySelector('[data-list-city]'), tags = box.querySelector('[data-list-tags]');
    if (!sel || !tags) return;
    /* Tags: the list, the city, and the pains tapped in "¿Cuáles te pasan?" (dolor-*), so December's email can speak to each one. */
    function setTags() {
      var slug = sel.value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-');
      var pains = [].slice.call(document.querySelectorAll('.jcs-pains button[aria-pressed="true"]')).map(function (b) { return b.dataset.tag; });
      tags.value = ['newsletter', 'lista-lote-001', 'ciudad-' + slug].concat(slug !== 'bogota' ? ['fuera-bogota'] : []).concat(pains).join(',');
    }
    sel.addEventListener('change', setTags);
    var form = tags.form; if (form) form.addEventListener('submit', setTags);
  })();
</script>
