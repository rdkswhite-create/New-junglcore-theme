{% doc %}
Primera tanda. With stock: Págala ya (paid only, 1–10 bags). Without stock: email list only, no free reservation. Email lands in Shopify Customers with the tag primera-tanda.
@param {object} product - The NUBE product.
@param {string} form_id - Unique id.
{% enddoc %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign launch = settings.jc_launch_label | default: '20 de noviembre'
  assign perk = settings.jc_waitlist_perk
  assign contact_day = settings.jc_contact_label | default: '19 de noviembre'
  assign per_glass = v.price | divided_by: 30
  assign wa_text = 'Hola, quiero NUBE de la primera tanda (' | append: launch | append: '). Estoy en el barrio: '
  assign email_id = form_id | append: '-email'
-%}
<div class="jcs-wait" id="{{ form_id }}">
  <div class="jcs-wait__head">
    <p class="jcs-wait__tag">Primera tanda</p>
    <p class="jcs-wait__date">{{ launch }}</p>
  </div>
  <p class="jcs-wait__lead">Estamos produciendo la primera tanda. Entregamos en Bogotá desde el {{ launch }}.</p>
  {% if v and v.price > 0 %}<p class="jcs-wait__price"><strong>{{ v.price | money_without_trailing_zeros }}</strong> · 30 vasos · desde {{ per_glass | money_without_trailing_zeros }} por vaso con 3 bolsas y envío gratis</p>{% endif %}
  {% if settings.jc_waitlist_count > 0 %}<p class="jcs-wait__count"><strong>{{ settings.jc_waitlist_count }}</strong> {% if settings.jc_waitlist_count == 1 %}persona ya apartó su bolsa.{% else %}personas ya apartaron su bolsa.{% endif %}</p>{% endif %}
  {% if perk != blank %}<p class="jcs-wait__perk"><span>De regalo</span>{{ perk }}</p>{% endif %}

  {%- if v and v.available -%}
  <div class="jcs-prepay" data-variant="{{ v.id }}">
    <p class="jcs-prepay__k">Págala ya <span>· asegurada en la primera tanda</span></p>
    <div class="jcs-prepay__row">
      <label class="visually-hidden" for="{{ form_id }}-qty">Bolsas</label>
      <select id="{{ form_id }}-qty" class="jcs-prepay__qty">
        {%- for q in (1..10) -%}
          <option value="{{ q }}" data-total="{% render 'jc-delivered-total', variant: v, qty: q %}" data-ship="{% if q >= 3 %}envío gratis{% else %}con envío{% endif %}" data-glass="{% render 'jc-glass-price', variant: v, qty: q %}">{{ q }} {% if q == 1 %}bolsa{% else %}bolsas{% endif %}{% if q >= 3 %} · envío gratis{% endif %}</option>
        {%- endfor -%}
      </select>
      <a class="jcs-btn jcs-prepay__btn" href="{{ routes.root_url }}cart/{{ v.id }}:1"><span>Págala ya</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
    </div>
    <p class="jcs-prepay__total" data-prepay-total><strong>{% render 'jc-delivered-total', variant: v, qty: 1 %}</strong> con envío · {% render 'jc-glass-price', variant: v, qty: 1 %} por vaso</p>
    <p class="jcs-prepay__small">Pago seguro con Bold. Envío en Bogotá $20.000; gratis desde $100.000.</p>
  </div>
  <script>
    (function () {
      var box = document.currentScript.previousElementSibling; if (!box) return;
      var sel = box.querySelector('.jcs-prepay__qty'), btn = box.querySelector('.jcs-prepay__btn'), id = box.dataset.variant;
      var tot = box.querySelector('[data-prepay-total]');
      sel.addEventListener('change', function () {
        btn.href = '{{ routes.root_url }}cart/' + id + ':' + sel.value;
        var o = sel.options[sel.selectedIndex];
        if (tot && o.dataset.total) { tot.innerHTML = '<strong>' + o.dataset.total.trim() + '</strong> ' + o.dataset.ship + ' · ' + o.dataset.glass.trim() + ' por vaso'; }
      });
    })();
  </script>
  {%- else -%}
  <p class="jcs-wait__or">Esta tanda se agotó. Déjanos tu correo y te avisamos cuando salga la siguiente, antes que a nadie.</p>

  {% form 'customer', id: email_id, class: 'jcs-wait__form' %}
    {% if form.posted_successfully? %}
      <p class="jcs-wait__ok" role="status"><strong>Estás en la lista.</strong> Te avisamos primero.</p>
    {% else %}
      <input type="hidden" name="contact[tags]" value="newsletter,primera-tanda">
      <label class="jcs-wait__label" for="{{ email_id }}-input">Tu correo</label>
      <div class="jcs-wait__row">
        <input type="email" id="{{ email_id }}-input" name="contact[email]" placeholder="tu@correo.com" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        <button type="submit">Apártamela</button>
      </div>
      {% if form.errors %}<p class="jcs-wait__err" role="alert">Revisa el correo. {{ form.errors.messages['email'] }}</p>{% endif %}
      <p class="jcs-wait__legal">Solo te escribimos sobre NUBE y JUNGLCORE. Puedes salirte cuando quieras.{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">Política de datos</a>.{% endif %}</p>
    {% endif %}
  {% endform %}
  {%- endif -%}
</div>
