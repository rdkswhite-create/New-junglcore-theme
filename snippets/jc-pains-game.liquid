    function pick(arr, key) { if (!arr || !arr.length) return ''; var i, n = 0; do { i = Math.floor(Math.random() * arr.length); n++; } while (arr.length > 1 && prev[key] === i && n < 6); prev[key] = i; return arr[i]; }
    function shuffle(a) { a = a.slice(); for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)), t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
    var FORTUNES = ["No eres débil. El paquete lo diseñó un equipo de 200 personas. Tú estás solo.", "Si algo necesita 23 ingredientes para saber a algo, sospecha.", "El sistema no te quiere flaco ni gordo. Te quiere comprando.", "El paquete dice «porción: 3 galletas». El paquete sabe que mientes.", "Cuando la caja grita «saludable», lee la parte de atrás.", "Ninguna fruta ha necesitado un comercial.", "La comida de verdad se daña. Eso es buena señal.", "Si dura dos años en la alacena, pregúntate qué le hicieron.", "Menos paquetes. Más platos.", "Lo que no compras no te lo comes a las 11 p. m.", "Tu abuela no contaba macros. Tampoco tenía paquetes de 20.", "Nadie se ha arrepentido de una arepa con huevo.", "Caldo, arepa y café. Tu abuela ya sabía de saciedad.", "La abuela servía en plato hondo. El paquete no tiene fondo.", "Tu abuela no tenía antojo a las 11. Tenía sueño a las 9.", "Si viene de una mata, ya vas bien.", "Dato observa: compran agua en caja y tienen agua en la llave.", "Lupa anotó: «solo una» significa, en promedio, todas.", "Chispa no entiende por qué le hablan a la nevera a medianoche.", "Dato calculó que un antojo dura menos que una canción. Ponte una.", "Lupa vio a un humano leer la etiqueta y devolverlo. Lo aplaudió.", "En el planeta de los robots no hay paquetes familiares para una persona.", "Dato encontró miles de plantas en Colombia y cinco en el pasillo. Sigue buscando.", "Los robots vinieron buscando la jungla. Encontraron un pasillo. Tú encuentra la jungla.", "El hambre de verdad acepta cualquier cosa. El antojo solo acepta galletas.", "Un antojo dura minutos. Tú duras más.", "El aburrimiento se disfraza de hambre. Quítale el disfraz.", "Dormir poco da más hambre al día siguiente. Acostarte temprano también es comer bien.", "Lo que tienes a la vista es lo que te comes. Guarda el paquete.", "Un desayuno con proteína aguanta más que uno de puro azúcar.", "El antojo de la noche empieza en el almuerzo que no comiste.", "A buen hambre no hay pan