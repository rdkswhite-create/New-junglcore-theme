        bots: [['dato', 'Probé lo del Tetris. Perdí. El antojo también.'], ['lupa', '¿Por qué los venden de a 20 si se come una?'], ['chispa', 'Abrí la nevera cuatro veces. Seguía igual. Yo también.']] }
    };
    var PROFILES = {
      etiqueta: { title: 'El que no come cuento',
        roast: ['En el supermercado te demoras más leyendo que pagando.', 'Tú no compras: haces auditoría.', 'Lees etiquetas como otros leen el horóscopo. Con más fe.'],
        rule: ['Si no cabe en una mano, no entra a tu casa.', 'Si no lo puedes pronunciar, no lo tienes que tomar.'],
        moment: ['Tu momento NUBE: lee la nuestra. Sacha inchi, agua, goma gelana. Ya.', 'Tu momento NUBE: cualquier mañana. Tres ingredientes, cero diccionario.'] },
      proteina: { title: 'El que busca proteína',
        roast: ['Lees «proteína» en grande y la buscas en la tabla como quien busca las llaves.', 'Cuentas gramos como otros cuentan likes.', 'El frente de la caja te grita proteína. La tabla te la susurra.'],
        rule: ['Mira los gramos por vaso, no la palabra en grande.', 'La proteína se cuenta en gramos, no en letras.'],
        moment: ['Tu momento NUBE: fría, en el desayuno. 6,2 g de proteína por vaso.', 'Tu momento NUBE: con la avena de la mañana, con 150 ml de agua. 6,2 g por vaso.'] },
      dulce: { title: 'Cansado de lo dulce',
        roast: ['Pediste desayuno y te sirvieron cumpleaños.', 'Lo «saludable» de tu alacena sabe a pastelería.', 'Ya no sabes qué es desayuno y qué es postre.'],
        rule: ['Lo de todos los días no tiene que saber a postre.', 'El dulce lo pones tú, no la fábrica.'],
        moment: ['Tu momento NUBE: sin azúcares añadidos. Si quieres dulce, le pones fruta tú.', 'Tu momento NUBE: con un banano en la licuadora. El dulce lo decides tú.'] },
      caja: { title: 'El que no da papaya',
        roast: ['Abres un litro por un vaso y el resto se queda esperando turno.', 'Tu nevera es un cementerio de cajas a medio tomar.', 'Compras por litro y botas por mitades.'],
        rule: ['Paga lo que te tomas, no lo que botas.', 'Abre solo lo que te vas a tomar.'],
        moment: ['Tu momento NUBE: una barra, un vaso. Las otras 29 esperan en el congelador.', 'Tu momento NUBE: cuando quieras. Nada abierto, nada esperando.'] },
      noche: { title: 'El visitante de la nevera',
        roast: ['A las 11 p. m. tu nevera tiene más visitas que tu Instagram.', 'Tu nevera te conoce mejor de noche que de día.', 'Abres la nevera como quien revisa el celular: sin esperar nada, por si acaso.'],
        rule: ['El antojo grita. Tú decides si contestas.', 'A las 11, primero pregúntate qué buscas.'],
        moment: ['Tu momento NUBE: caliente, a las 11 p. m., con el celular boca abajo.', 'Tu momento NUBE: una barra en agua bien caliente. Despacio, sin licuadora.'] }
    };
    var PAIRS = {
      'etiqueta+proteina': ['El auditor de la tabla', ['Lees ingredientes y gramos. El supermercado te tiene miedo.', 'Le das la vuelta a todo. La caja ya sabe que la vas a pillar.']],
      'etiqueta+dulce':    ['Ni cuento ni azúcar', ['Si no lo entiendes o sabe a torta, vuelve a la estantería.', 'No te engaña la letra pequeña ni el sabor a vainilla.']],
      'etiqueta+caja':     ['El auditor del supermercado', ['Revisas etiqueta y fecha. Y aun así algo se daña en la nevera.', 'Lees todo antes de comprar. La caja abierta no te lee a ti.']],
      'etiqueta+noche':    ['Lo leíste y te lo comiste', ['Viste el sello negro. Lo miraste a los ojos. Te lo comiste igual.', 'De día auditor. A las 11, cómplice.']],
      'proteina+dulce':    ['Proteína sin cumpleaños', ['Quieres proteína. Te ofrecen batido sabor a torta.', 'Buscas gramos y te encuentras glaseado.']],
      'proteina+caja':     ['El que hace cuentas', ['Cuentas gramos y cuentas pesos. La caja no pasa ninguna de las dos.', 'Pagas un litro, botas medio y la proteína ni apareció.']],
      'proteina+noche':    ['Desayuno corto, noche larga', ['Por la mañana buscas proteína. A las 11, la nevera.', 'Cuentas gramos de día y pasos hasta la nevera de noche.']],
