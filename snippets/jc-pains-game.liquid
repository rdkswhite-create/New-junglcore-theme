{% doc %}
"¿Cuáles te pasan?": the front door of La lista.
Five cards. Each tap shows a line written for that exact combination (31 combinations, three lines each).
From two taps on: "Ver mi resultado" gives a profile (five singles, ten pairs, and El combo completo), the robot, a rule,
tips, a sugar-free fortune cookie and the NUBE moment, with save / share / play again.
The tapped cards go into the sign-up as dolor-* tags (see jc-waitlist).
{% enddoc %}
<div class="jcs-pains" id="jc-pains">
  <h3 class="jcs-pains__title" id="juego">¿Cuáles te pasan?</h3>
  <p class="jcs-pains__ask">Toca las tuyas. Cada combinación tiene su propia respuesta.</p>
  <ul class="jcs-pains__list">
    <li><button type="button" aria-pressed="false" data-tag="dolor-etiqueta">Lees la etiqueta y no entiendes la mitad.</button></li>
    <li><button type="button" aria-pressed="false" data-tag="dolor-proteina">Buscas proteína y tu bebida vegetal casi no trae.</button></li>
    <li><button type="button" aria-pressed="false" data-tag="dolor-dulce">Todo lo «saludable» sabe a postre.</button></li>
    <li><button type="button" aria-pressed="false" data-tag="dolor-caja">Abres una caja y se te daña antes de terminarla.</button></li>
    <li><button type="button" aria-pressed="false" data-tag="dolor-noche">A las 11 p.&nbsp;m. abres la nevera buscando algo.</button></li>
  </ul>
  <div class="jcs-pains__combo" hidden aria-live="polite" aria-atomic="true">
    <p class="jcs-pains__combo-k"><b>0</b> de 5 · Bitácora de los humanos</p>
    <p class="jcs-pains__combo-q"></p>
    <button type="button" class="jcs-pains__combo-again">Otra respuesta <span aria-hidden="true">&#8635;</span></button>
  </div>
  <div class="jcs-pains__score">
    <button type="button" class="jcs-btn jcs-pains__reveal" hidden><span>Ver mi resultado</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></button>
  </div>
      <div class="jcs-thinking" hidden aria-live="polite">
        <img class="jcs-thinking__face" src="{{ 'jc-face-dato.jpg' | asset_url }}" width="80" height="80" alt="Dato">
        <p class="jcs-thinking__t">Dato está revisando tu caso<span>.</span><span>.</span><span>.</span></p>
      </div>
      <div class="jcs-result" hidden aria-live="polite">
        <div class="jcs-result__card">
          <div class="jcs-result__head">
            <img class="jcs-result__face" src="" width="80" height="80" alt="">
            <div><p class="jcs-result__kicker">Te salió</p><p class="jcs-result__title"></p><p class="jcs-result__roast"></p></div>
          </div>
          <p class="jcs-result__bot"></p>
          <p class="jcs-result__rule-k">Tu regla</p>
          <p class="jcs-result__rule"></p>
          <details class="jcs-result__fold" open>
            <summary class="jcs-result__take-k">Para llevar</summary>
            <ul class="jcs-result__take"></ul>
          </details>
          <p class="jcs-result__fortune-k">Tu galleta de la fortuna <span>(sin azúcar)</span></p>
          <p class="jcs-result__fortune"></p>
          <p class="jcs-result__moment"></p>
          <p class="jcs-result__sig">junglcore.com · ¿Cuáles te pasan?</p>
        </div>
        <div class="jcs-result__actions">
          <a class="jcs-btn jcs-result__buy" href="#jcs-home-list"><span>{% if settings.jc_sale_mode == 'a_la_venta' %}Pide tu bolsa{% else %}Avísame · Lote 001{% endif %}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
          <button type="button" class="jcs-btn jcs-btn--line jcs-result__save"><span>Guardar mi tarjeta</span><span class="jcs-arrow" aria-hidden="true">&darr;</span></button>
          <button type="button" class="jcs-link jcs-result__share">Mándaselo a alguien &rarr;</button>
          <button type="button" class="jcs-link jcs-result__again">Juega por alguien más &rarr;</button>
        </div>
      </div>
</div>
<script>
  (function () {
    var root = document.getElementById('jc-pains'); if (!root) return;
    var FACES = { dato: "{{ 'jc-face-dato.jpg' | asset_url }}", lupa: "{{ 'jc-face-lupa.jpg' | asset_url }}", chispa: "{{ 'jc-face-chispa.jpg' | asset_url }}" };
    var NAMES = { dato: 'Dato', lupa: 'Lupa', chispa: 'Chispa' };
    /* One line for every combination of taps. Key = sum of 1 (etiqueta), 2 (proteína), 4 (dulce), 8 (caja), 16 (noche). */
    var BANK = {"1": ["Si necesitas un traductor para desayunar, algo se nos ha ido de las manos.", "Hubo un tiempo en que la lista de ingredientes era bastante más corta que las instrucciones del microondas.", "La etiqueta parece una novela rusa. Y tú solo querías desayunar."], "2": ["A veces hay más entusiasmo por la proteína en el envase que proteína en el vaso.", "Es extraordinario cuánto puede hablar un cartón de proteína sin comprometerse a llevar demasiada.", "Compras una bebida vegetal. Luego descubres que la proteína estaba, sobre todo, en la publicidad."], "3": ["Quieres proteína y una etiqueta comprensible. En algunas tiendas eso parece pedir dos productos distintos.", "Es fascinante: sabemos fabricar bebidas complicadísimas que apenas explican qué estamos bebiendo.", "Primero necesitas leer química. Después, buscar proteína. Y todavía no has desayunado."], "4": ["¿En qué momento desayunar empezó a parecerse a una fiesta de cumpleaños?", "La industria consiguió algo admirable: convertir hasta la palabra «natural» en un sabor.", "No todo lo que comes por la mañana necesita saber a torta con velitas."], "5": ["La etiqueta tiene veinte palabras que no reconoces, pero al menos promete saber a pastel. Qué alivio.", "Cuesta leer lo que lleva, pero sabe a cumpleaños. El triunfo del departamento creativo.", "Una bebida puede parecer un postre y tener una lista de ingredientes que parece una tesis doctoral."], "6": ["Querías proteína. Te dieron una tarta de cumpleaños que se bebe.", "Proteína y sabor a pastel: una combinación magnífica, suponiendo que quieras celebrar tu cumpleaños todos los días.", "Resulta que el sabor a postre puede ser más evidente que la proteína que saliste a buscar."], "7": ["Una lista larguísima, un sabor a postre y poca proteína. Desde luego, no les faltó imaginación.", "El producto ha conseguido ser complicado, dulce y nutricionalmente desconcertante. Tres departamentos celebrando a la vez.", "Para algo que se llama «bebida vegetal», a veces cuesta encontrar la planta, la sencillez y la proteína."], "8": ["Querías un vaso. Abriste un litro. Ahora tienes una fecha límite.", "Una sed de doscientos mililitros acaba de convertirse en una obligación de un litro.", "Lo curioso es que el cartón decide cuánto debes terminar, aunque tú solo hayas querido un vaso."], "9": ["Una etiqueta que no entiendes y un litro que no querías abrir. La experiencia completa.", "El cartón trae instrucciones complicadas y, de regalo, una pequeña carrera contra el calendario.", "Has comprado la bebida. Ahora debes descifrarla y terminarla antes del viernes."], "10": ["Poca proteína y demasiado líquido abierto. Es una peculiar definición de eficiencia.", "Te faltan proteínas, pero te sobran ochocientos mililitros en la nevera.", "El vaso trae poca proteína; el envase trae una obligación a largo plazo."], "11": ["Lees la etiqueta, buscas proteína y descubres que debes terminar el litro. Una compra con deberes.", "Hay una aventura entera escondida en un cartón: descifrarlo, compararlo y acabarlo a tiempo.", "El producto exige investigación previa y disciplina posterior. Todo para beber un vaso."], "12": ["Te vendieron un postre bebible en tamaño familiar. Tú solo querías acompañar el desayuno.", "Un litro de algo que sabe a tarta. Lo verdaderamente extraordinario es que lo llamemos una bebida cotidiana.", "Sabe a cumpleaños y tienes que terminarlo antes de que pierda la gracia. Qué celebración."], "13": ["Etiqueta de enciclopedia, sabor a tarta, un litro abierto. Alguien ha optimizado demasiadas cosas equivocadas.", "Entre leer la fórmula y terminar el envase, se te pasa el cumpleaños.", "La industria resolvió el problema del sabor y creó otros dos: entenderlo y acabarlo."], "14": ["Buscas proteína, recibes sabor a pastel y te comprometes a un litro. Menuda negociación.", "Querías alimentarte. El cartón propone una celebración diaria y una obligación semanal.", "Un producto que sabe a postre, trae menos proteína de la esperada y ocupa la nevera. Polivalente, desde luego."], "15": ["La bebida pide que la estudies, la termines y celebres tu cumpleaños. Lo de la proteína sigue pendiente.", "Cuatro molestias en un solo envase. Es casi admirable lo mucho que cabe en un litro.", "El cartón parece diseñado por cuatro departamentos que nunca se conocieron."], "16": ["La nevera no ha cambiado desde hace una hora. Pero vuelves a comprobarlo.", "A las once de la noche, la nevera se convierte en una página web que actualizas esperando noticias.", "Lo curioso no es abrir la nevera. Es la esperanza de que esta vez haya aparecido algo extraordinario."], "17": ["Ni siquiera entiendes del todo lo que desayunaste, pero a las once tu nevera vuelve a pedirte atención.", "Pasaste la mañana descifrando una etiqueta y terminas el día descifrando un antojo.", "Por la mañana, la pregunta es qué lleva. Por la noche, por qué sigues buscando algo."], "18": ["Buscabas proteína al desayunar. A las once buscas algo en la nevera. Quizá haya una pregunta interesante entre las dos cosas.", "Tu vaso prometía nutrición. Tu nevera recibe una visita nocturna. Esto merece investigarse, no adivinarse.", "Dos preguntas bastante humanas: ¿qué estoy tomando? y ¿por qué sigo mirando dentro de la nevera?"], "19": ["Etiqueta confusa, poca proteína, visita nocturna a la nevera. Tenemos preguntas para una investigación entera.", "Por la mañana te falta información; por la noche, alguna respuesta. No es precisamente un sistema sencillo.", "El día empieza con una etiqueta que no entiendes y acaba mirando una nevera que no tiene respuestas."], "20": ["Una bebida que sabe a postre por la mañana y una búsqueda de algo más por la noche. La vida es bastante curiosa.", "Desayunas algo con sabor a cumpleaños. A las once de la noche sigues preguntándole cosas a la nevera.", "El antojo nocturno no consulta cuántos aromas de pastel había en el desayuno."], "21": ["Etiqueta interminable, sabor a postre y nevera nocturna. Parece el argumento de una comedia nutricional.", "Qué curioso: el producto es complicadísimo, el sabor es sencillísimo y el apetito sigue haciendo preguntas.", "Por la mañana intentas leer el envase. Por la noche relees el contenido de la nevera."], "22": ["Querías proteína, no un pastel bebible. Y a las once el refrigerador vuelve a intervenir en la negociación.", "Proteína, aroma de cumpleaños y visita nocturna a la nevera. Hay una buena pregunta científica escondida ahí.", "Es curioso lo poco que sabemos de un día de comida cuando lo reducimos a gramos de proteína y sabores."], "23": ["El envase promete, la etiqueta desconcierta, el sabor celebra y la nevera recibe otra visita. Falta el detective.", "Cuatro señales de que necesitamos hablar de comida como experiencia, no solo como una lista de ingredientes.", "Todo parece calculado para impresionar a la etiqueta. Pero el estómago no lee etiquetas."], "24": ["Abres un litro durante el día y la nevera por la noche. Qué relación tan comprometida con una caja.", "El cartón sigue ahí, abierto. Tú vuelves a abrir la nevera. Ambos esperando algo.", "Primero el envase te impone un calendario. Después tu apetito decide no seguirlo."], "25": ["Un cartón que debes terminar, una etiqueta que debes descifrar y una nevera que te llama a las once. Vaya jornada.", "La etiqueta te confunde de día; el cartón te vigila desde la nevera por la noche.", "El litro viene con dos obligaciones: entender qué compraste y recordar por qué lo abriste."], "26": ["Te faltaba proteína, te sobraba cartón y acabaste mirando la nevera de noche. Una ecuación muy humana.", "Podemos optimizar gramos por litro. El comportamiento de las once de la noche es bastante menos obediente.", "El supermercado vende litros y gramos. Tu vida funciona en vasos, momentos y preguntas."], "27": ["Buscas proteína, lees una novela en la etiqueta, abres un litro y vuelves a la nevera. Parece un trabajo a tiempo parcial.", "Una bebida con deberes de química, matemáticas y gestión de nevera. ¿Dónde está la parte de beber?", "La industria contó los gramos, imprimió la etiqueta y envió el cartón. Nadie preguntó por las once de la noche."], "28": ["Un litro de sabor a postre abierto y tú mirando la nevera a las once. Es casi una relación sentimental.", "La bebida sabe a celebración; el cartón se queda abierto; la nevera recibe visitas. Extraña vida doméstica.", "El antojo nocturno y el cartón a medio terminar parecen mantener una conversación que nadie ha estudiado."], "29": ["Etiqueta complicada, sabor a pastel, cartón abierto y visita nocturna. No sé si es desayuno o una serie de suspense.", "Cuando hasta elegir una bebida tiene cuatro capítulos, quizás convenga cambiar la pregunta.", "El desayuno tenía demasiada explicación; la noche trae demasiadas preguntas."], "30": ["Proteína escasa, sabor a tarta, litro abierto y nevera nocturna. Alguien debería estudiar el proceso completo.", "De día te vendieron números y sabor a cumpleaños. De noche, tu nevera sigue siendo el escenario principal.", "Cuatro molestias y un solo cartón. Quizás no sea cuestión de añadir otro aroma de vainilla."], "31": ["Las cinco. Enhorabuena: acabas de convertir un vaso de bebida vegetal en una tesis sobre la vida moderna.", "Todo marcado. La industria se pasó décadas perfeccionando el cartón y quizás olvidó mirar a la persona.", "Cinco de cinco. Fantástico. La buena noticia es que no tenemos que aceptar que las cosas sean así."]};
    /* Every card: its profile, several tips and several robot lines. Each result picks at random, so the same taps give a different card each time. Edit freely. */
    var CARDS = {
      'dolor-etiqueta': { p: 'etiqueta',
        take: ['Mira el primer ingrediente de la lista: es del que más hay.', 'Si no reconoces una palabra, búscala antes de comprar, no después.', 'Compara dos marcas por la lista de atrás, no por el frente del empaque.'],
        bots: [['dato', 'Hoy devolvieron 47 a la estantería. Los anoté.'], ['lupa', 'Conté los ingredientes. Me cansé antes que la lista.'], ['chispa', 'Leí la etiqueta en voz alta. El perro se fue.']] },
