    var BANK = {"1": ["Lees la etiqueta como contrato de arriendo: despacio, con miedo y sin entender.", "Si para desayunar necesitas Google, algo salió mal.", "Veinte ingredientes para una bebida. Ni el ajiaco lleva tantos."], "2": ["La caja dice PROTEÍNA en grande. La tabla dice 1 gramo, en chiquito.", "Buscas proteína y te encuentras agüita de buena familia.", "Mucho anuncio y poquito gramo."], "3": ["No entiendes la lista y la proteína no aparece. Dos misterios por el precio de uno.", "Le diste la vuelta a la caja buscando proteína y encontraste un trabalenguas.", "Lees todo, entiendes la mitad y la proteína ni se asoma."], "4": ["Pediste desayuno y te sirvieron ponqué.", "Si lo «saludable» sabe a fiesta infantil, alguien te está mamando gallo.", "Tu bebida vegetal sabe más a arequipe que a planta."], "5": ["No entiendes qué lleva, pero sabe a torta. Ahí está el truco.", "Veinte ingredientes y todos se pusieron de acuerdo en saber a vainilla.", "Si no la entiendes y sabe a postre, no es desayuno: es piñata."], "6": ["Buscabas proteína y te tocó batido de ponqué.", "Mucho sabor a galleta y poquito gramo.", "Querías algo que te sostuviera y te dieron algo que te endulzara."], "7": ["No se entiende, no trae proteína y sabe a postre. Tres de tres.", "Lees, buscas, pruebas. Y sigues sin saber qué te tomaste.", "Para ser «vegetal», la planta se perdió por el camino."], "8": ["Querías un vaso. Abriste un litro. Ahora la caja manda.", "El martes abriste la caja. El domingo la botaste. Clásico.", "Pagas el litro entero y te tomas medio. El otro medio se lo toma la caneca."], "9": ["La leíste, no la entendiste y al final la botaste. Plata perdida, pero con estudio.", "Tanto leer la etiqueta para que la caja se dañe en la nevera.", "Le estudiaste los ingredientes. Ella te estudió la fecha de vencimiento."], "10": ["Poca proteína y mucha caja. Encima se te daña lo poco que trae.", "Pagaste un litro de casi nada y botaste la mitad.", "Ni proteína ni rendimiento. Por donde la mires, te salió cara."], "11": ["No la entiendes, no te llena la tabla y encima la botas. Mercado con tres goles en contra.", "Investigas como detective y terminas botando la evidencia.", "Leíste, comparaste, compraste… y la caneca se quedó con la mitad."], "12": ["Un litro sabor a postre, abierto el lunes. El jueves nadie lo quiere.", "Lo dulce empalaga y la caja no se acaba. Mal matrimonio.", "Tan dulce que ni tú te la terminas."], "13": ["Rara, dulce y a medio tomar. Así viven las cajas en tu nevera.", "No sabes qué lleva, sabe a torta y se daña. La trilogía del mercado.", "Le diste tres oportunidades: la etiqueta, el sabor y la fecha. Perdió las tres."], "14": ["Querías proteína, te dieron postre y encima un litro que se daña. Uy, no.", "Sabe a ponqué, no llena la tabla y se vence. Ni la abuela le tiene tanta fe.", "Mucho azúcar, poco gramo y media caja en la caneca."], "15": ["Cuatro de cinco. Esa caja te debe plata.", "No se entiende, no alimenta, empalaga y se daña. ¿Qué más le pides? Nada. Ya.", "Esa caja tiene más defectos que el TransMilenio en hora pico."], "16": ["Son las 11. Abres la nevera. No hay nada nuevo. La vuelves a abrir.", "La nevera no cambió desde las 9. Tú sí cambiaste de opinión.", "A las 11 de la noche, la nevera es la única que te contesta."], "17": ["De día lees etiquetas. De noche, la nevera te lee a ti.", "Por la mañana, muy auditor. A las 11, cómplice.", "Tanto revisar ingredientes para terminar comiendo lo primero que encuentres."], "18": ["Desayunaste poquito gramo y a las 11 la nevera te está esperando.", "Por la mañana buscas proteína. Por la noche buscas lo que sea.", "Por la mañana cuentas gramos. Por la noche cuentas viajes a la nevera."], "19": ["Etiqueta rara, poca proteína y visita de medianoche. Día completo.", "Te pasaste el día leyendo tablas y terminaste leyendo la nevera.", "De día, contador. De noche, explorador de nevera."], "20": ["A las 11 la nevera te ofrece postre y tú le dices que sí, por educación.", "Desayunaste postre y de noche sigues buscando postre. Así no se puede.", "Lo dulce de la mañana llama a lo dulce de la noche."], "21": ["No sabes qué desayunaste, sabía a torta y a las 11 sigues buscando.", "Mañana confusa, noche golosa.", "Lees etiquetas de día y te comes el arequipe a cucharadas de noche."], "22": ["Proteína poquita, postre mucho y nevera a las 11. Todo cuadra.", "Desayunaste galleta líquida. A las 11 vas por la galleta de verdad.", "Buscaste gramos, encontraste azúcar y de noche, la nevera."], "23": ["Cuatro de cinco. Tu nevera ya te tiene en favoritos.", "Confusa, flojita, dulce y a las 11 otra vez. Esto pide un cambio.", "De la etiqueta a la nevera: un día muy largo para un vaso."], "24": ["De día abres cajas. De noche abres la nevera. Abres mucho y cierras poco.", "A las 11 encuentras la caja del martes. Ni ella te quiere.", "Tu nevera tiene más cosas abiertas que tu navegador."], "25": ["Leíste la caja, la abriste, la olvidaste y a las 11 la volviste a mirar. Romance.", "La caja vencida te mira desde el fondo de la nevera cada noche.", "De día lees, de noche buscas y la caja sigue ahí, juzgándote."], "26": ["Poca proteína, caja abierta y visita a las 11. Todo termina en la nevera.", "Te falta gramo y te sobra caja. A las 11 eso no lo arregla nadie.", "El litro está abierto. La nevera también."], "27": ["Cuatro de cinco. Te salvaste del dulce, por ahora.", "Lees, comparas, abres, botas y a las 11 vuelves. Rutina olímpica.", "Tu mercado necesita abogado."], "28": ["Caja dulce abierta y tú frente a la nevera a las 11. Esa relación es tóxica.", "El postre del desayuno sigue en la nevera. Te llama de noche.", "Lo dulce no se acaba y la noche tampoco."], "29": ["Cuatro de cinco. Lo único que no te pasa es la proteína… porque ya ni la buscas.", "Rara, dulce, abierta y a medianoche. Parece telenovela.", "Tu nevera tiene más drama que la novela de las 9."], "30": ["Cuatro de cinco. Por lo menos la etiqueta sí la entiendes.", "Poquito gramo, mucho azúcar, caja abierta y nevera a las 11. Cliente premium.", "Tu nevera trabaja turno de noche por tu culpa."], "31": ["Las cinco. Felicitaciones: eres el cliente que todo el pasillo estaba esperando.", "Cinco de cinco. No eres tú, es el pasillo entero.", "Todas. Tranquilo: para eso hicimos NUBE."]};
