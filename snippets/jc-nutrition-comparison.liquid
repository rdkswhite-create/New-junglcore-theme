{% doc %}
Renders NUBE and named plant drinks using declared nutrition per 200 ml finished beverage.
{% enddoc %}
<section class="jc-nutrition" id="jc-nutrition" aria-labelledby="jc-nutrition-heading">
<p class="jc-product__eyebrow">03 / {{ 'jc_nutrition.section_label' | t }}</p>
<h2 id="jc-nutrition-heading">{{ 'jc_nutrition.title' | t }}</h2>
<p class="jc-nutrition__intro">{{ 'jc_nutrition.intro' | t }}</p>
<p class="jc-nutrition__swipe">{{ 'jc_nutrition.swipe' | t }}</p>
<div class="jc-nutrition__scroll" role="region" aria-labelledby="jc-nutrition-heading" tabindex="0">
<table>
<caption class="visually-hidden">{{ 'jc_nutrition.caption' | t }}</caption>
<thead><tr><th scope="col">{{ 'jc_nutrition.measure' | t }}</th><th scope="col"><span class="jc-nutrition__brand">NUBE</span><span class="jc-nutrition__type">{{ 'jc_nutrition.nube_type' | t }}</span><span class="jc-nutrition__pack">30 barras · 600 g</span></th><th scope="col"><span class="jc-nutrition__brand">{{ 'jc_compare_labels.almond' | t }}</span><span class="jc-nutrition__type">{{ 'jc_compare_labels.economy' | t }}</span><span class="jc-nutrition__pack">1.000 ml</span></th><th scope="col"><span class="jc-nutrition__brand">{{ 'jc_compare_labels.almond' | t }}</span><span class="jc-nutrition__type">{{ 'jc_compare_labels.mid' | t }}</span><span class="jc-nutrition__pack">1.000 ml</span></th><th scope="col"><span class="jc-nutrition__brand">{{ 'jc_compare_labels.almond' | t }}</span><span class="jc-nutrition__type">{{ 'jc_compare_labels.high' | t }}</span><span class="jc-nutrition__pack">946 ml</span></th><th scope="col"><span class="jc-nutrition__brand">{{ 'jc_compare_labels.oat' | t }}</span><span class="jc-nutrition__type">{{ 'jc_compare_labels.oat_detail' | t }}</span><span class="jc-nutrition__pack">946 ml</span></th></tr></thead>
<tbody>
<tr><th scope="row">{{ 'jc_nutrition.protein' | t }}</th><td>6,3 <span>g</span></td><td>1,0 <span>g</span></td><td>1,4 <span>g</span></td><td>0,8 <span>g</span></td><td>2,9 <span>g</span></td></tr>
<tr><th scope="row">{{ 'jc_nutrition.carbs' | t }}</th><td>0,4 <span>g</span></td><td>2,0 <span>g</span></td><td>0,4 <span>g</span></td><td>1,0 <span>g</span></td><td>12,2 <span>g</span></td></tr>
<tr><th scope="row">{{ 'jc_nutrition.sugars' | t }}</th><td>0,0 <span>g</span></td><td>0,0 <span>g</span></td><td>0,2 <span>g</span></td><td>0,2 <span>g</span></td><td>7,5 <span>g</span></td></tr>
<tr><th scope="row">{{ 'jc_nutrition.fibre' | t }}</th><td>1,4 <span>g</span></td><td>0,0 <span>g</span></td><td>0,8 <span>g</span></td><td>0,6 <span>g</span></td><td>0,8 <span>g</span></td></tr>
<tr><th scope="row">{{ 'jc_nutrition.fat' | t }}</th><td>0,9 <span>g</span></td><td>1,4 <span>g</span></td><td>4,4 <span>g</span></td><td>1,8 <span>g</span></td><td>2,6 <span>g</span></td></tr>
<tr class="jc-nutrition__omega"><th scope="row">{{ 'jc_nutrition.omega3' | t }}</th><td><strong class="jc-nutrition__omega-value">0,45 <span>g</span></strong><span>{{ 'jc_nutrition.estimated' | t }}</span></td><td><span aria-hidden="true">—</span><span class="visually-hidden">{{ 'jc_nutrition.not_declared' | t }}</span></td><td><span aria-hidden="true">—</span><span class="visually-hidden">{{ 'jc_nutrition.not_declared' | t }}</span></td><td><span aria-hidden="true">—</span><span class="visually-hidden">{{ 'jc_nutrition.not_declared' | t }}</span></td><td><span aria-hidden="true">—</span><span class="visually-hidden">{{ 'jc_nutrition.not_declared' | t }}</span></td></tr>
<tr><th scope="row">{{ 'jc_nutrition.count' | t }}</th><td>3</td><td>13</td><td>10</td><td>15</td><td>10</td></tr>
</tbody>
</table>
</div>
<p class="jc-nutrition__note">{{ 'jc_nutrition.net_note' | t }}</p>
<p class="jc-nutrition__note">{{ 'jc_nutrition.note' | t }}</p>
<p class="jc-nutrition__note">{{ 'jc_nutrition.omega_note' | t }}</p>
<details class="jc-nutrition__detail">
<summary>{{ 'jc_nutrition.ingredients' | t }} <span aria-hidden="true">+</span></summary>
<p>{{ 'jc_nutrition.method' | t }}</p>
<div class="jc-nutrition__lists">
<div><h3>NUBE · {{ 'jc_nutrition.nube_type' | t }}</h3><p>{{ 'jc_nutrition.nube_list' | t }}</p></div>
<div><h3>{{ 'jc_compare_labels.almond' | t }} · {{ 'jc_compare_labels.economy' | t }}</h3><p>{{ 'jc_nutrition.d1_list' | t }}</p></div>
<div><h3>{{ 'jc_compare_labels.almond' | t }} · {{ 'jc_compare_labels.high' | t }}</h3><p>{{ 'jc_nutrition.silk_list' | t }}</p></div>
<div><h3>{{ 'jc_compare_labels.almond' | t }} · {{ 'jc_compare_labels.mid' | t }}</h3><p>{{ 'jc_nutrition.almendrola_list' | t }}</p></div>
<div><h3>{{ 'jc_compare_labels.oat' | t }}</h3><p>{{ 'jc_nutrition.oat_list' | t }}</p></div>
</div>
<p>{{ 'jc_nutrition.fortification' | t }}</p>
</details>
<details class="jc-nutrition__detail">
<summary>{{ 'jc_nutrition.sources' | t }} <span aria-hidden="true">+</span></summary>
<p>{{ 'jc_compare_labels.mapping_product' | t }}</p><p>{{ 'jc_compare_labels.price_basis' | t }}</p>
<p>{{ 'jc_nutrition.source_note' | t }}</p>
<p>{{ 'jc_nutrition.net_detail' | t }}</p>
<p>{{ 'jc_nutrition.omega_detail' | t }}</p>
<p>{{ 'jc_nutrition.portion' | t }}</p>
<ul>
<li><a href="https://tienda.makro.com.co/p/bebida-almendra-almendrola-sin-azucar-1l-100284" target="_blank" rel="noopener noreferrer">{{ 'jc_compare_labels.almendrola_price' | t }} ↗</a></li>
<li><a href="https://grasasyaceites.revistas.csic.es/index.php/grasasyaceites/article/view/1301/" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.omega_source' | t }} ↗</a></li>
<li><a href="https://www.aecoctrade.es/es/producto/ksafuXFUolgkFCUMeJ9p77" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.almendrola_source' | t }} ↗</a></li>
<li><a href="https://www.recetasnestle.com.co/natures-heart/productos/healthy-beverages/natures-heart-bebida-avena-se-12x946ml-co" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.oat_source' | t }} ↗</a></li>
<li><a href="https://d1tiendas.vtexassets.com/arquivos/ids/201818-1200-1200?aspect=true&amp;height=1200&amp;width=1200" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.d1_source' | t }} ↗</a></li>
<li><a href="https://d1tiendas.vtexassets.com/arquivos/ids/201817-1200-1200?aspect=true&amp;height=1200&amp;width=1200" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.d1_ingredients_source' | t }} ↗</a></li>
<li><a href="https://www.soriana.com/bebida-vegetal-sabor-almendra-de-california-silk-sin-azucar-946ml/11680708.html" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.silk_source' | t }} ↗</a></li>
<li><a href="https://ecomm-heb-web-dev.eastus.cloudapp.azure.com/silk-alimento-liquido-de-almendra-sin-azucar-946-ml-450322/p" target="_blank" rel="noopener noreferrer">{{ 'jc_nutrition.silk_available_source' | t }} ↗</a></li>
</ul>
</details>
</section>
{% stylesheet %}
.jc-nutrition{margin:48px 0 60px;scroll-margin-top:30px;color:#30352f}
.jc-product .jc-nutrition h2{font-size:clamp(32px,3.5vw,48px);line-height:1.1;margin:0 0 20px}
.jc-nutrition__intro{font-size:18px;line-height:1.6;margin:0 0 30px}
.jc-nutrition__scroll{overflow-x:auto;overscroll-behavior-x:contain}
.jc-nutrition__scroll:focus-visible{outline:2px solid #555a52;outline-offset:4px}
.jc-nutrition table{width:100%;min-width:960px;border-collapse:collapse;table-layout:fixed;box-shadow:none}
.jc-nutrition th,.jc-nutrition td{padding:22px 16px;border:0;border-bottom:1px solid #d2d4cb;vertical-align:middle;text-align:center}
.jc-nutrition thead th{background:#e9eae4;vertical-align:top;font-weight:400}
.jc-nutrition th:first-child{width:21%;text-align:left;font-size:15px;font-weight:500}
.jc-nutrition thead th:first-child{font-size:12px;letter-spacing:.05em;vertical-align:bottom}
.jc-nutrition th:nth-child(2),.jc-nutrition td:nth-child(2){background:#dedfd6}
.jc-nutrition__brand{display:block;font-size:19px;font-weight:500;letter-spacing:-.025em;line-height:1.2}
.jc-nutrition__type{display:block;font-size:13px;line-height:1.5;margin-top:12px}
.jc-nutrition__pack{display:block;font-size:12px;color:#62675e;margin-top:8px}
.jc-nutrition td{font-size:27px;font-weight:400;letter-spacing:-.025em;font-variant-numeric:tabular-nums;white-space:nowrap}
.jc-nutrition td:nth-child(2){font-weight:600}
.jc-nutrition td span{font-size:16px}
.jc-nutrition .jc-nutrition__omega td{white-space:normal;line-height:1.4;font-weight:400;letter-spacing:0}
.jc-nutrition .jc-nutrition__omega td span{display:block;font-size:14px}
.jc-nutrition__omega-value{display:block;font-size:27px;font-weight:600;letter-spacing:-.025em}
.jc-nutrition .jc-nutrition__omega td .jc-nutrition__omega-value span{display:inline;font-size:16px}
.jc-nutrition__note{font-size:13px;line-height:1.65;color:#62675e;margin:20px 0 0}
.jc-nutrition__detail{border-top:1px solid #d2d4cb;margin-top:24px}
.jc-nutrition__detail summary{display:flex;justify-content:space-between;gap:20px;list-style:none;padding:20px 0;font-size:13px;font-weight:500;letter-spacing:.04em;cursor:pointer}
.jc-nutrition__detail summary::-webkit-details-marker{display:none}
.jc-nutrition__detail p,.jc-nutrition__detail li{font-size:14px;line-height:1.65;color:#555a52}
.jc-nutrition__detail a{color:inherit;text-underline-offset:4px}
.jc-nutrition__lists{display:grid;grid-template-columns:1fr 1fr;gap:20px 40px;margin:25px 0}
.jc-nutrition__lists h3{font-size:16px;font-weight:500;line-height:1.5;margin:0 0 8px}
.jc-nutrition__lists p{margin:0}
.jc-nutrition__swipe{display:none}
@media(max-width:1000px){
.jc-nutrition__swipe{display:block;font-size:12px;margin-bottom:14px;color:#62675e}
.jc-nutrition th:first-child{position:sticky;left:0;background:#FCFBF8;z-index:1;width:190px}
.jc-nutrition thead th:first-child{background:#e9eae4}
}
@media(max-width:749px){.jc-nutrition{margin:32px 0 40px}.jc-nutrition__intro{font-size:16px}.jc-nutrition__lists{grid-template-columns:1fr}.jc-nutrition table{min-width:900px}.jc-nutrition th,.jc-nutrition td{padding:20px 14px}}
#jc-product-top .jc-nutrition{padding-top:60px;border-top:1px solid #d2d4cb}
#jc-product-top .jc-nutrition__intro{margin:0 0 32px}
#jc-product-top .jc-nutrition__note{margin:22px 0 0;max-width:92ch}
@media(max-width:749px){#jc-product-top .jc-nutrition{padding-top:40px}}
{% endstylesheet %}





