{%- comment -%} Textura: 150 ml más cremosa, 200 ml más ligera. Tested amounts from Russell (11 Nov 2026). {%- endcomment -%}
<section class="jcs-texture" id="jc-textura" aria-labelledby="jc-texture-title">
  <div class="jcs-frame">
    <p class="jcs-chapter"><span>{{ number }}</span>Elige tu NUBE</p>
    <div class="jcs-texture__head">
      <h2 class="jcs-title" id="jc-texture-title">Cremosa o Ligera.</h2>
      <p class="jcs-lead">Una barra. Tú decides la textura.</p>
    </div>
    <div class="jcs-texture__grid">
      <div class="jcs-texture__opt">
        <p class="jcs-texture__ml">150 <span>ml de agua</span></p>
        <p class="jcs-texture__name">Cremosa</p>
        <p class="jcs-texture__desc">Espesa, para la avena o el desayuno.</p>
      </div>
      <div class="jcs-texture__opt">
        <p class="jcs-texture__ml">200 <span>ml de agua</span></p>
        <p class="jcs-texture__name">Ligera</p>
        <p class="jcs-texture__desc">Fresca, para tomar sola.</p>
      </div>
    </div>
    <p class="jcs-texture__how">1 barra + agua · 30 segundos de licuadora. <em>Nota a avena tostada, final a nuez.</em></p>
  </div>
</section>
