{% doc %}
"¿No estás en Bogotá? Tráela a tu ciudad." — always visible; email or WhatsApp sign-up with the city, tagged fuera-bogota and ciudad-<name>, so the customer list shows which city asks most.
@param {string} id - Unique form id.
@param {boolean} [dark] - Light text, for dark bands.
{% enddoc %}
<div class="jcs-city jcs-city--open{% if dark %} jcs-city--dark{% endif %}" id="{{ id }}-wrap">
  <p class="jcs-city__head"><span class="jcs-city__q">¿No estás en Bogotá?</span> <span class="jcs-city__t">Tráela a tu ciudad.</span></p>
  <p class="jcs-city__lead">Llegamos muy pronto. Te avisamos primero.</p>
  {% form 'customer', id: id, class: 'jcs-city__form' %}
    {% if form.posted_successfully? %}
      <p class="jcs-city__ok">Anotado. Cuando tu ciudad llegue, eres de los primeros en saberlo.</p>
    {% else %}
      <input type="hidden" name="contact[tags]" value="newsletter,fuera-bogota" data-city-tags>
      <label class="visually-hidden" for="{{ id }}-city">Tu ciudad</label>
      <select class="jcs-city__select" id="{{ id }}-city" data-city-select required>
        <option value="">Tu ciudad</option>
        <option>Medellín</option>
        <option>Cali</option>
        <option>Barranquilla</option>
        <option>Bucaramanga</option>
        <option>Cartagena</option>
        <option>Pereira</option>
        <option>Manizales</option>
        <option>Cúcuta</option>
        <option>Ibagué</option>
        <option>Villavicencio</option>
        <option>Santa Marta</option>
        <option>Otra</option>
      </select>
      <label class="visually-hidden" for="{{ id }}-email">Tu correo</label>
      <div class="jcs-wait__row jcs-city__row">
        <input type="email" id="{{ id }}-email" name="contact[email]" placeholder="tu@correo.com" autocomplete="email" required>
        <button type="submit">Avísame</button>
      </div>
      <p class="jcs-wait__legal">Solo te escribimos sobre NUBE y JUNGLCORE. Puedes salirte cuando quieras.</p>
    {% endif %}
  {% endform %}
  <p class="jcs-city__wa"><a href="https://wa.me/573011571039?text={{ 'Hola, quiero NUBE en mi ciudad.' | url_encode }}" target="_blank" rel="noopener" data-city-wa>O escríbenos por WhatsApp <span aria-hidden="true">&rarr;</span></a></p>
</div>
<script>
  (function () {
    var wrap = document.getElementById({{ id | append: '-wrap' | json }});
    if (!wrap) return;
    var sel = wrap.querySelector('[data-city-select]');
    var tags = wrap.querySelector('[data-city-tags]');
    if (!sel || !tags) return;
    sel.addEventListener('change', function () {
      var slug = sel.value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
      tags.value = 'newsletter,fuera-bogota' + (slug ? ',ciudad-' + slug : '');
      var wa = wrap.querySelector('[data-city-wa]');
      if (wa) wa.href = 'https://wa.me/573011571039?text=' + encodeURIComponent(sel.value && sel.value !== 'Otra' ? 'Hola, quiero NUBE en ' + sel.value + '.' : 'Hola, quiero NUBE en mi ciudad.');
    });
  })();
</script>
