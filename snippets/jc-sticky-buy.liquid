{% doc %}
Mobile buy bar. Appears once the main buy box has scrolled out of view.
@param {object} product - The NUBE product.
@param {boolean} [always] - On phones, show from the first screen (product page).
{% enddoc %}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign pre = false -%}{%- if settings.jc_sale_mode != 'a_la_venta' -%}{%- assign pre = true -%}{%- endif -%}
{% if pre or v and v.price > 0 and v.available %}
<div class="jcs-sticky{% if always %} jcs-sticky--always{% endif %}" id="jcs-sticky" aria-hidden="true">
  {% if pre %}
  <div class="jcs-sticky__pre">
    <div class="jcs-sticky__info"><strong>NUBE{% if v and v.price > 0 %} · {{ v.price | money_without_trailing_zeros }}{% endif %}</strong><span>Lote 001 · {{ settings.jc_launch_label | default: 'diciembre' }} · Bogotá</span></div>
    <a class="jcs-btn" href="#jc-buy" tabindex="-1"><span>Avísame</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
  </div>
  {% else %}
  <div class="jcs-sticky__pre">
    <div class="jcs-sticky__info"><strong>NUBE · {{ v.price | money_without_trailing_zeros }}</strong><span>30 vasos · Bogotá · <span data-jc-eta-short>llega hoy</span></span></div>
    <a class="jcs-btn" href="#jc-buy" tabindex="-1"><span>Pídela</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
  </div>
  {% endif %}
</div>
<script>
(function () {
  var bar = document.getElementById('jcs-sticky');
  var box = document.querySelector('.jcs-buy');
  var hero = document.querySelector('.jcs-hero');
  if (bar && bar.classList.contains('jcs-sticky--always')) { bar.classList.add('is-visible'); bar.setAttribute('aria-hidden','false'); var b0 = bar.querySelector('.jcs-btn'); if (b0) b0.tabIndex = 0; return; }
  if (!bar || !box || !('IntersectionObserver' in window)) return;
  var boxVisible = false, heroVisible = !!hero, passedBox = false;
  function update() {
    var show = !boxVisible && !heroVisible && passedBox;
    bar.classList.toggle('is-visible', show);
    bar.setAttribute('aria-hidden', show ? 'false' : 'true');
    var btn = bar.querySelector('.jcs-btn'); if (btn) btn.tabIndex = show ? 0 : -1;
  }
  new IntersectionObserver(function (e) { boxVisible = e[0].isIntersecting; if (!boxVisible && e[0].boundingClientRect.top < 0) passedBox = true; if (boxVisible) passedBox = false; update(); }).observe(box);
  if (hero) new IntersectionObserver(function (e) { heroVisible = e[0].isIntersecting; update(); }).observe(hero);
})();
</script>
{% endif %}
