{% comment %}
  JUNGLCORE home copy layer (section 01 El producto).
  Adds the taste line, the price-vs-almond line, the 3-bag offer and the new delivery note
  into section 01 without touching jc-nube-v2.liquid. Bake into that file later if wanted.
{% endcomment %}
<style>
  #jc-v2-nube .jc-nube-offer__versus{font-size:clamp(19px,2vw,24px);font-weight:500;line-height:1.3;letter-spacing:-.01em;margin:22px 0 10px;color:#141414}
  #jc-v2-nube .jc-nube-offer__bundle{font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;margin:0 0 26px;color:#343630}
  .shopify-section:has(> .jc-home-patch){display:none}
</style>
<div class="jc-home-patch" hidden></div>
<script>
(function(){
  function el(tag, cls, text){ var n=document.createElement(tag); n.className=cls; if(text){ n.textContent=text; } return n; }
  function run(){
    var root=document.getElementById('jc-v2-nube');
    if(!root || root.getAttribute('data-jc-patched')){ return; }
    root.setAttribute('data-jc-patched','1');
    var proof=root.querySelector('.jc-nube-offer__proof');
    if(proof){ proof.insertAdjacentElement('afterend', el('p','jc-nube-offer__choice jc-nube-offer__taste','¿A qué sabe? Quienes la prueban dicen que se parece a la avena.')); }
    var value=root.querySelector('.jc-bio__nube-value');
    if(value){
      var versus=el('p','jc-nube-offer__versus');
      versus.appendChild(document.createTextNode('Por vaso, menos que una bebida de almendra.'));
      versus.appendChild(document.createElement('br'));
      versus.appendChild(document.createTextNode('Seis veces la proteína.'));
      var bundle=el('p','jc-nube-offer__bundle','3 bolsas · 119.700 COP · 90 vasos · envío gratis');
      value.insertAdjacentElement('afterend', bundle);
      value.insertAdjacentElement('afterend', versus);
    }
    var fine=root.querySelector('.jc-v2__fineprint');
    if(fine){ fine.textContent='Solo en Bogotá, por ahora. Llega congelada, como debe ser. Envío: $20.000 COP. Gratis en pedidos desde $100.000 COP.'; }
  }
  if(document.readyState!=='loading'){ run(); } else { document.addEventListener('DOMContentLoaded', run); }
})();
</script>

{% schema %}
{
  "name": "JC home copy layer",
  "settings": []
}
{% endschema %}
