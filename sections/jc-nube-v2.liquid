{% comment %}
  JUNGLCORE NUBE editorial home.
  Sharp square-dot logo SVG assets; 16:9 preparation loop on desktop and
  portrait original on mobile. Shopify trial cannot accept native MP4 uploads,
  so animated WebP loops are used until native video media is enabled.
  A Shopify-hosted video selected in the theme editor still takes precedence.
{% endcomment %}
{{ 'jc-nube-v2.css' | asset_url | stylesheet_tag }}

{% liquid
  assign selected_nube = section.settings.nube_product
  assign selected_one = section.settings.one_product
  assign selected_oil = section.settings.oil_product
  assign message = section.settings.whatsapp_message | url_encode
  assign contact = 'https://wa.me/' | append: section.settings.whatsapp_number | append: '?text=' | append: message
  assign order_url = contact
  assign order_label = 'PEDIR NUBE'
  if section.settings.order_mode == 'product' and selected_nube != blank
    assign order_url = selected_nube.url
    assign order_label = 'VER NUBE'
  endif
%}

<div class="jc-v2">
  <header class="jc-v2__header" aria-label="Junglcore">
    <a class="jc-v2__header-logo" href="{{ routes.root_url }}" aria-label="junglcore inicio">
      <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-approved-master-black-no-r.svg?v=1793662575" alt="junglcore" width="1377" height="369" loading="eager">
    </a>
    <nav class="jc-v2__header-links" aria-label="Navegación">
      <a href="#jc-v2-nube">NUBE</a>
      <a href="#jc-v2-ritual">CÓMO FUNCIONA</a>
      <a href="#jc-v2-collection">PRODUCTOS</a>
    </nav>
    <a class="jc-v2__header-order" href="#jc-v2-nube">EXPLORAR <span aria-hidden="true">↗</span></a>
  </header>

  <section class="jc-v2__film" aria-label="Preparación de NUBE">
    <div class="jc-v2__film-media">
      {% if section.settings.hero_video != blank %}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'jc-v2__film-picture' }}
      {% elsif section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'jc-v2__film-picture', loading: 'eager', fetchpriority: 'high', alt: 'Preparación de NUBE en licuadora' }}
      {% else %}
        <picture class="jc-v2__film-responsive">
          <source media="(max-width: 749px)" srcset="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-portrait-loop.webp?v=1793647878" type="image/webp">
          <img class="jc-v2__film-picture" src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-landscape-loop.webp?v=1793647871" alt="Preparación de NUBE: sacha inchi, agua, licuadora y bebida terminada" width="910" height="512" loading="eager" fetchpriority="high" decoding="async">
        </picture>
      {% endif %}
    </div>
    <div class="jc-v2__film-shade" aria-hidden="true"></div>
    <div class="jc-v2__film-top"><span>NUBE / COLOMBIA</span><span>UNA NUEVA FORMA DE PREPARAR TU BEBIDA VEGETAL</span></div>
    <div class="jc-v2__film-bottom">
      <img class="jc-v2__film-logo" src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-approved-master-white-no-r.svg?v=1793662580" alt="junglcore" width="1377" height="369" fetchpriority="high">
      <div class="jc-v2__film-bottomline">
        <span>NUBE. UNA BEBIDA VEGETAL DIFERENTE.</span>
        <a href="#jc-v2-nube">DESCUBRIR <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="jc-v2__nube" id="jc-v2-nube" aria-labelledby="jc-v2-nube-heading">
    <div class="jc-v2__frame">
      <div class="jc-v2__chapter"><span>01</span><span>EL PRODUCTO</span></div>
      <div class="jc-v2__nube-photo">
        {% if section.settings.nube_image != blank %}
          {{ section.settings.nube_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '360, 640, 960, 1280, 1600', alt: 'Bolsa JUNGLCORE NUBE' }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-approved-white-shadow-nov2026.jpg?v=1793661639" alt="JUNGLCORE NUBE, bolsa blanca con la marca junglcore en minúsculas" width="660" height="724" loading="eager">
        {% endif %}
      </div>
      <div class="jc-v2__nube-identity">
        <p class="jc-v2__eyebrow">BASE CONGELADA DE SACHA INCHI</p>
        <h1 id="jc-v2-nube-heading">NUBE</h1>
        <p class="jc-v2__nube-lead">Tu bebida vegetal empieza en el congelador.</p>
        <p class="jc-v2__nube-copy">Un tab de sacha inchi. Añade agua, licúa y prepara tu bebida cuando quieras. Tres ingredientes: pasta de sacha inchi, agua y goma gelana.</p>
        <div class="jc-v2__nube-facts">
          <div><strong>{{ section.settings.protein_value | escape }}</strong><span>PROTEÍNA POR TAB*</span></div>
          <div><strong>{{ section.settings.fibre_value | escape }}</strong><span>FIBRA POR TAB*</span></div>
          <div><strong>3</strong><span>INGREDIENTES</span></div>
        </div>
        <div class="jc-v2__nube-actions">
          <a class="jc-v2__button" href="{{ order_url | strip | escape }}">{{ order_label }} <span aria-hidden="true">↗</span></a>
          <a class="jc-v2__textlink" href="#jc-v2-ritual">CÓMO FUNCIONA <span aria-hidden="true">↓</span></a>
        </div>
        <p class="jc-v2__fineprint">*Valores de la propuesta de etiqueta; confirmar con el análisis del producto final antes de publicar. Mantener congelado. Entregas iniciales en Bogotá.</p>
      </div>
    </div>
  </section>

  <section class="jc-v2__ritual jc-v2__frame" id="jc-v2-ritual" aria-labelledby="jc-v2-ritual-heading">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>02</span><span>EL RITUAL</span></div>
    <h2 id="jc-v2-ritual-heading">UN TAB.<br>AGUA.<br>LICUADORA.</h2>
    <div class="jc-v2__ritual-grid">
      <div><span>01</span><h3>SACA</h3><p>Saca un tab del congelador.</p></div>
      <div><span>02</span><h3>AÑADE</h3><p>Añade agua a la licuadora.<br>150 ml para una bebida espesa.<br>200 ml para una bebida refrescante.</p></div>
      <div><span>03</span><h3>LICÚA</h3><p>Licúa durante 30 segundos para una bebida recién preparada.</p></div>
    </div>
  </section>

  {% if section.settings.show_nutrition_comparison %}
    <section class="jc-v2__comparison jc-v2__frame" id="jc-v2-comparison" aria-labelledby="jc-v2-comparison-heading">
      <div class="jc-v2__chapter jc-v2__chapter--rule"><span>03</span><span>COMPARACIÓN NUTRICIONAL</span></div>
      <h2 id="jc-v2-comparison-heading">¿QUÉ HAY EN TU BEBIDA VEGETAL?</h2>
      <p class="jc-v2__comparison-lead">Datos por preparación indicada; no son dos bebidas de volumen final equivalente.</p>
      <div class="jc-v2__comparison-scroll" role="region" aria-label="Comparación entre NUBE y bebida de almendra" tabindex="0">
        <table class="jc-v2__comparison-table">
          <thead>
            <tr>
              <th scope="col">DATOS POR PREPARACIÓN</th>
              <th scope="col"><strong>NUBE</strong><span>1 tab preparado con 200 ml de agua</span></th>
              <th scope="col"><strong>ALMENDRA SIN AZÚCAR</strong><span>Nature's Heart · 200 ml</span></th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">Proteína</th><td>6,3 g†</td><td>0,8 g</td></tr>
            <tr><th scope="row">Fibra</th><td>1,4 g†</td><td>1,0 g</td></tr>
            <tr><th scope="row">Grasa total</th><td>0,7 g†</td><td>2,5 g</td></tr>
            <tr class="jc-v2__comparison-omega"><th scope="row">Omega-3 (ALA)</th><td>≈ 0,34 g*</td><td class="jc-v2__comparison-muted">No declarado</td></tr>
          </tbody>
        </table>
      </div>
      <div class="jc-v2__comparison-notes">
        <p>† Valores provisionales de NUBE por 1 tab, sin confirmación de laboratorio del producto terminado. Una preparación con 200 ml de agua puede superar 200 ml de volumen final: esta tabla no compara iguales volúmenes y no debe interpretarse como superioridad por 200 ml.</p>
        <p>*Estimación de omega-3 ALA: 0,7 g de grasa por tab × aproximadamente 48 % de ALA según referencias sobre aceite de sacha inchi. No es un análisis de NUBE terminado. «No declarado» significa que la etiqueta de Nature's Heart no informa omega-3; no significa cero.</p>
        <p>Nature's Heart: información nutricional del producto colombiano Almendra Sin Azúcar, por 200 ml. <a href="https://www.recetasnestle.com.co/natures-heart/productos/healthy-beverages/natures-heart-beb-alm-sazr-12x946ml-co" target="_blank" rel="noopener noreferrer">Consultar etiqueta y fuente ↗</a></p>
      </div>
    </section>
  {% endif %}

  <section class="jc-v2__manifesto" aria-labelledby="jc-v2-manifesto-heading">
    <div class="jc-v2__frame">
      <div class="jc-v2__chapter"><span>{% if section.settings.show_nutrition_comparison %}04{% else %}03{% endif %}</span><span>NUESTRA IDEA</span></div>
      <h2 id="jc-v2-manifesto-heading">SER VEGETAL<br>NO ES<br>SUFICIENTE.</h2>
      <div class="jc-v2__manifesto-bottom">
        <p>La comida tiene que alimentar. Por eso empezamos por una semilla, no por una lista interminable de ingredientes.</p>
        <p>La sacha inchi se cultiva en Colombia. NUBE es una forma distinta de llevarla a tu mesa.</p>
      </div>
    </div>
  </section>

  <section class="jc-v2__collection jc-v2__frame" id="jc-v2-collection" aria-labelledby="jc-v2-collection-heading">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>{% if section.settings.show_nutrition_comparison %}05{% else %}04{% endif %}</span><span>LA COLECCIÓN</span></div>
    <h2 id="jc-v2-collection-heading">MÁS DE<br>JUNGLCORE.</h2>
    <p class="jc-v2__collection-lead">Una semilla. Distintas posibilidades.</p>
    <div class="jc-v2__collection-grid">
      <article class="jc-v2__collection-card">
        <div class="jc-v2__collection-photo">
          {% if section.settings.one_image != blank %}
            {{ section.settings.one_image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '350, 650, 1000, 1300', alt: 'JUNGLCORE ONE' }}
          {% else %}
            <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-one-approved-white-shadow-nov2026.jpg?v=1793661672" alt="JUNGLCORE ONE, harina de sacha inchi en bolsa blanca" width="660" height="724" loading="lazy">
          {% endif %}
        </div>
        <div class="jc-v2__collection-body">
          <div><h3>ONE</h3><p>Proteína y fibra de una misma semilla. La sacha inchi.</p></div>
          {% if selected_one != blank %}
            <a href="{{ selected_one.url }}">VER ONE ↗</a>
          {% else %}
            <span>PRÓXIMAMENTE</span>
          {% endif %}
        </div>
      </article>
      <article class="jc-v2__collection-card">
        <div class="jc-v2__collection-photo">
          {% if section.settings.oil_image != blank %}
            {{ section.settings.oil_image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '350, 650, 1000, 1300', alt: 'JUNGLCORE OIL' }}
          {% else %}
            <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-oil-approved-white-shadow-nov2026.jpg?v=1793661645" alt="JUNGLCORE OIL, aceite de sacha inchi en botella blanca" width="660" height="724" loading="lazy">
          {% endif %}
        </div>
        <div class="jc-v2__collection-body">
          <div><h3>OIL</h3><p>Aceite de sacha inchi, prensado en frío.</p></div>
          {% if selected_oil != blank %}
            <a href="{{ selected_oil.url }}">VER OIL ↗</a>
          {% else %}
            <span>PRÓXIMAMENTE</span>
          {% endif %}
        </div>
      </article>
    </div>
  </section>

  <section class="jc-v2__faq jc-v2__frame" id="jc-v2-faq" aria-labelledby="jc-v2-faq-title">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>{% if section.settings.show_nutrition_comparison %}06{% else %}05{% endif %}</span><span>PREGUNTAS FRECUENTES</span></div>
    <h2 id="jc-v2-faq-title">LO ESENCIAL.</h2>
    <details><summary>¿Cómo se prepara NUBE?<span aria-hidden="true">+</span></summary><p>Saca un tab del congelador, añade 150 ml de agua para una bebida espesa o 200 ml para una bebida más ligera y licúa durante 30 segundos.</p></details>
    <details><summary>¿Cómo se conserva?<span aria-hidden="true">+</span></summary><p>NUBE es un producto congelado. Consérvalo en el congelador y sigue las instrucciones de conservación de su envase.</p></details>
    <details><summary>¿Dónde entregan?<span aria-hidden="true">+</span></summary><p>Las entregas iniciales de NUBE se coordinan directamente en Bogotá para mantener la cadena de frío. Contáctanos antes de hacer tu pedido.</p></details>
  </section>

  <footer class="jc-v2__footer" aria-label="Información de JUNGLCORE">
    <div class="jc-v2__footer-inner jc-v2__frame">
      <div class="jc-v2__footer-brand">
        <a href="{{ routes.root_url }}" aria-label="JUNGLCORE inicio"><img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-approved-master-black-no-r.svg?v=1793662575" alt="junglcore" width="1377" height="369" loading="lazy"></a>
        <p>De una semilla colombiana. Para nuevas formas de comer y beber.</p>
        <p class="jc-v2__footer-location">COLOMBIA · HECHO DE AQUÍ</p>
      </div>
      <nav class="jc-v2__footer-nav" aria-label="JUNGLCORE">
        <h3>JUNGLCORE</h3>
        <a href="#jc-v2-nube">NUBE</a>
        <a href="#jc-v2-collection">ONE Y OIL</a>
        <a href="#jc-v2-manifesto-heading">Nuestra historia</a>
      </nav>
      <nav class="jc-v2__footer-nav" aria-label="Ayuda y contacto">
        <h3>AYUDA</h3>
        <a href="#jc-v2-ritual">Cómo preparar NUBE</a>
        <a href="#jc-v2-faq">Preguntas frecuentes</a>
        {% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">Contacto</a>{% endif %}
        <a href="#jc-v2-faq">Envíos y entregas</a>
      </nav>
      <nav class="jc-v2__footer-nav" aria-label="Legal">
        <h3>LEGAL</h3>
        {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Términos y condiciones</a>{% endif %}
        {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Política de privacidad</a>{% endif %}
        {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Cambios y devoluciones</a>{% endif %}
        {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Política de envíos</a>{% endif %}
      </nav>
    </div>
    <div class="jc-v2__footer-bottom jc-v2__frame">
      <div class="jc-v2__footer-company">
        {% if section.settings.legal_name != blank %}<span>{{ section.settings.legal_name | escape }}</span>{% endif %}
        {% if section.settings.legal_nit != blank %}<span>NIT: {{ section.settings.legal_nit | escape }}</span>{% endif %}
        {% if section.settings.legal_address != blank %}<span>{{ section.settings.legal_address | escape }}</span>{% endif %}
        {% if section.settings.contact_phone != blank %}<span>Tel: {{ section.settings.contact_phone | escape }}</span>{% endif %}
        {% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>{% endif %}
      </div>
      <a class="jc-v2__backtop" href="#jc-v2-nube">VOLVER ARRIBA ↑</a>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Junglcore NUBE V2",
  "tag": "section",
  "class": "jc-v2-section",
  "settings": [
    {"type":"header","content":"Apertura y vídeo"},
    {"type":"video","id":"hero_video","label":"Vídeo de preparación (MP4 desde Shopify)"},
    {"type":"image_picker","id":"hero_image","label":"Imagen de portada (opcional)"},
    {"type":"header","content":"NUBE"},
    {"type":"image_picker","id":"nube_image","label":"Fotografía final del pouch NUBE"},
    {"type":"product","id":"nube_product","label":"Producto NUBE"},
    {"type":"select","id":"order_mode","label":"Botón principal","options":[{"value":"whatsapp","label":"Pedir por WhatsApp"},{"value":"product","label":"Ir al producto Shopify"}],"default":"whatsapp"},
    {"type":"text","id":"whatsapp_number","label":"WhatsApp (sin +)","default":"573011571039"},
    {"type":"text","id":"whatsapp_message","label":"Mensaje WhatsApp","default":"Hola, quiero pedir JUNGLCORE NUBE en Bogotá."},
    {"type":"text","id":"protein_value","label":"Proteína por tab (confirmar)","default":"6,3 g"},
    {"type":"text","id":"fibre_value","label":"Fibra por tab (confirmar)","default":"1,4 g"},
    {"type":"header","content":"Comparación nutricional"},
    {"type":"checkbox","id":"show_nutrition_comparison","label":"Mostrar tabla referencial (NUBE pendiente de laboratorio)","default":true},
    {"type":"header","content":"Datos de contacto y empresa"},
    {"type":"text","id":"contact_email","label":"Email de contacto","default":"hola@junglcore.com"},
    {"type":"text","id":"contact_phone","label":"Teléfono comercial"},
    {"type":"text","id":"legal_name","label":"Razón social"},
    {"type":"text","id":"legal_nit","label":"NIT"},
    {"type":"text","id":"legal_address","label":"Dirección de notificación"},
    {"type":"header","content":"La colección"},
    {"type":"image_picker","id":"one_image","label":"Foto de ONE"},
    {"type":"image_picker","id":"oil_image","label":"Foto de OIL"},
    {"type":"product","id":"one_product","label":"Producto ONE (cuando esté listo)"},
    {"type":"product","id":"oil_product","label":"Producto OIL (cuando esté listo)"}
  ],
  "presets":[{"name":"Junglcore NUBE V2"}]
}
{% endschema %}
