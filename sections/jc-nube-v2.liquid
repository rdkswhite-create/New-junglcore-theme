{{ 'jc-nube-v2.css' | asset_url | stylesheet_tag }}
{{ 'jc-lab.css' | asset_url | stylesheet_tag }}

{% liquid
  assign selected_nube = section.settings.nube_product
  assign selected_one = section.settings.one_product
  assign selected_oil = section.settings.oil_product
  assign order_url = routes.root_url | append: 'products/nube'
  assign order_label = 'junglcore_biodiversity.order' | t
  if section.settings.order_mode == 'product' and selected_nube != blank
    assign order_url = selected_nube.url
    assign order_label = 'junglcore_biodiversity.order' | t
  endif
%}

<div class="jc-v2 jc-bio jc-launch" id="jc-v2-top">
  <header class="jc-v2__header" aria-label="Junglcore">
    <a class="jc-v2__header-logo" href="{{ routes.root_url }}" aria-label="junglcore inicio">
      <img src="{{ 'jc-wordmark-refined-black.svg' | asset_url }}" alt="junglcore" width="1329" height="313" loading="eager">
    </a>
    <nav class="jc-v2__header-links" aria-label="Navegación">
      <a href="#jc-v2-nube">{{ 'junglcore_biodiversity.nav_products' | t }}</a>
      <a href="{{ routes.root_url }}pages/exploraciones">{{ 'junglcore_biodiversity.nav_explorations' | t }}</a>
      
    </nav>
    <a class="jc-v2__header-order" href="{{ order_url | strip | escape }}">{{ 'junglcore_biodiversity.order' | t }} <span aria-hidden="true">↗</span></a>
  </header>

  <section class="jc-v2__film" aria-label="Preparación de NUBE">
    <div class="jc-v2__film-media">
      {% if section.settings.hero_video != blank %}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'jc-v2__film-picture' }}
      {% elsif section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'jc-v2__film-picture', loading: 'eager', fetchpriority: 'high', alt: 'Preparación de NUBE en licuadora' }}
      {% else %}
        <picture class="jc-v2__film-responsive">
          <source media="(max-width: 749px)" srcset="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-portrait-loop.webp?v=1793647878" type="image/webp">
          <img class="jc-v2__film-picture" src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-landscape-loop.webp?v=1793647871" alt="Preparación de NUBE: sacha inchi, agua, licuadora y bebida terminada" width="910" height="512" loading="eager" fetchpriority="high" decoding="async">
        </picture>
      {% endif %}
    </div>
    <div class="jc-v2__film-shade" aria-hidden="true"></div>
    <div class="jc-v2__film-top"><span>{{ 'junglcore_biodiversity.hero_origin' | t }}</span><span>{{ 'junglcore_biodiversity.hero_start' | t }}</span></div>
    <h1 class="jc-bio__hero-title">{{ 'junglcore_biodiversity.nube_lead' | t }}</h1>
    <div class="jc-v2__film-bottom">
      <img class="jc-v2__film-logo" src="{{ 'jc-wordmark-refined-white.svg' | asset_url }}" alt="junglcore" width="1329" height="313" fetchpriority="high">
      <div class="jc-v2__film-bottomline">
        <span>{{ 'junglcore_biodiversity.hero_product' | t }}</span>
        <a href="#jc-v2-nube">{{ 'junglcore_biodiversity.discover_nube' | t }} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="jc-v2__nube" id="jc-v2-nube" aria-labelledby="jc-v2-nube-heading">
    <div class="jc-v2__frame">
      <div class="jc-v2__chapter"><span>01</span><span>EL PRODUCTO</span></div>
      <div class="jc-v2__nube-photo">
        {% if section.settings.nube_image != blank %}
          {{ section.settings.nube_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '360, 640, 960, 1280, 1600', alt: 'Bolsa JUNGLCORE NUBE' }}
        {% else %}
          {% render 'jc-premium-pack', product_code: 'NUBE', instance_id: 'home-nube-1', description: 'JUNGLCORE NUBE, base congelada de sacha inchi' %}
        {% endif %}
      </div>
      <div class="jc-v2__nube-identity">
        <p class="jc-nube-offer__name">NUBE</p>
        <h2 class="jc-nube-offer__headline" id="jc-v2-nube-heading">{{ 'jc_home_offer.headline' | t }}<br>{{ 'jc_home_offer.headline_end' | t }}</h2>
        <p class="jc-nube-offer__description">{{ 'jc_home_offer.description' | t }}</p>
        <p class="jc-nube-offer__choice">{{ 'jc_home_offer.choice' | t }}</p>
        <div class="jc-nube-offer__proof"><span class="jc-nube-offer__ingredient-label">{{ 'jc_home_offer.ingredients_label' | t }}</span><p>{{ 'jc_home_offer.proof' | t }}</p></div>
        <p class="jc-nube-offer__choice jc-nube-offer__taste">{{ 'jc_home_offer.taste' | t }}</p>
        <div class="jc-bio__nube-value">
          <p>{{ 'junglcore_biodiversity.nube_home_pack' | t }}</p>
          <p><strong>{{ 'junglcore_biodiversity.value_price' | t }}</strong><span>{{ 'junglcore_biodiversity.value_portion' | t }}</span></p>
        </div>
        <p class="jc-nube-offer__versus">{{ 'jc_home_offer.versus' | t }}<br>{{ 'jc_home_offer.versus_end' | t }}</p>
        <p class="jc-nube-offer__bundle">{{ 'jc_home_offer.bundle' | t }}</p>
        <div class="jc-v2__nube-actions">
          <a class="jc-v2__button" href="{{ order_url | strip | escape }}">{{ order_label }} <span aria-hidden="true">↗</span></a>
          <a class="jc-v2__textlink" href="#jc-v2-ritual">CÓMO FUNCIONA <span aria-hidden="true">↓</span></a>
        </div>
        <p class="jc-v2__fineprint">{{ 'jc_nube_product.delivery_short' | t }}</p>
      </div>
    </div>
  </section>

  <section class="jc-v2__ritual jc-v2__frame" id="jc-v2-ritual" aria-labelledby="jc-v2-ritual-heading">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>02</span><span>EL RITUAL</span></div>
    {% render 'jc-nube-ritual', heading_id: 'jc-v2-ritual-heading', show_film: false, concise: true %}
  </section>

  <section class="jc-v2__uses" id="jc-v2-uses" aria-labelledby="jc-home-breakfast-title">
    <div class="jc-v2__frame">
      <div class="jc-v2__chapter jc-v2__chapter--rule"><span>03</span><span>FORMAS DE DISFRUTAR NUBE</span></div>
      {% render 'jc-nube-breakfast', heading_id: 'jc-home-breakfast-title' %}
      {% render 'jc-price-protein', context_id: 'home' %}
      <div class="jc-launch__order">
        <a class="jc-v2__button" href="{{ order_url | strip | escape }}">{{ 'junglcore_biodiversity.order' | t }} <span aria-hidden="true">↗</span></a>
        <p>{{ 'jc_nube_product.delivery_short' | t }}</p>
      </div>
    </div>
  </section>

  <section class="jc-v2__roots" id="jc-v2-roots" aria-labelledby="jc-v2-roots-heading">
    <div class="jc-v2__frame">
      <div class="jc-v2__chapter jc-v2__chapter--rule jc-v2__roots-top"><span>04</span><span>{{ 'jc_home_refined.plant_label' | t }}</span></div>
      <div class="jc-story-intro">
        <h2>{{ 'jc_story.headline' | t }}</h2>
        <p>{{ 'jc_story.lead' | t }}</p>
      </div>
      <div class="jc-v2__roots-layout">
        <figure class="jc-v2__roots-image">
          <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-sacha-inchi-seed-leaf-roots-biodiversity-2026.jpg?v=1793696362" alt="Fruto seco de sacha inchi de cuatro puntas junto a una hoja verde sobre fondo claro" width="1126" height="729" loading="lazy" decoding="async">
        </figure>
        <div class="jc-v2__roots-story">
          <p class="jc-v2__eyebrow">{{ 'jc_plant_story.label' | t }}</p>
          <h2 id="jc-v2-roots-heading">{{ 'jc_plant_story.title' | t }}</h2>
          <p>{{ 'jc_plant_story.intro' | t }}</p>
          <p>{{ 'jc_plant_story.possibilities' | t }}</p>
          <p>{{ 'jc_plant_story.closing' | t }}</p>
          <details class="jc-bio__details">
            <summary class="jc-bio__fold-toggle"><span class="jc-bio__fold-closed">{{ 'jc_plant_story.open' | t }}</span><span class="jc-bio__fold-open">{{ 'junglcore_biodiversity.fold_close' | t }}</span><span class="jc-bio__fold-arrow" aria-hidden="true">↓</span></summary>
            <div class="jc-bio__detail-copy"><p>{{ 'jc_story.growers' | t }}</p><p>{{ 'jc_story.relationships' | t }}</p><p>{{ 'jc_story.pilot' | t }}</p></div>
          </details>
          
        </div>
      </div>
    </div>
  </section>


  <section class="jc-lab-home jc-v2__frame" id="jc-v2-explorations" aria-labelledby="jc-lab-home-title">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>05</span><span>{{ 'jc_lab.brand' | t }}</span></div>
    <div class="jc-lab-home__intro">
      <h2 id="jc-lab-home-title">{{ 'jc_home_research.title' | t }}</h2>
      <p>{{ 'jc_lab.home_intro' | t }}</p>
    </div>
    <div id="jc-v2-collection">
      <section class="jc-lab-home__investigation" aria-labelledby="jc-home-satiety-title">
        <div class="jc-lab-home__question">
          <div><p class="jc-lab-eyebrow">{{ 'jc_lab.satiety_label' | t }}</p><h3 id="jc-home-satiety-title">{{ 'jc_home_research.satiety_hook' | t }}</h3></div>
          <div><p>{{ 'jc_home_research.satiety_copy' | t }}</p><a class="jc-lab-textlink" href="{{ routes.root_url }}pages/exploraciones#jc-exp-001">{{ 'jc_lab.visit_satiety' | t }} ↗</a></div>
        </div>
        {% render 'jc-lab-products', investigation: 'satiety', context_id: 'home' %}
      </section>
      <section class="jc-lab-home__investigation" aria-labelledby="jc-home-oil-title">
        <div class="jc-lab-home__question">
          <div><p class="jc-lab-eyebrow">{{ 'jc_lab.oil_label' | t }}</p><h3 id="jc-home-oil-title">{{ 'jc_home_research.oil_hook' | t }}</h3></div>
          <div><p>{{ 'jc_home_research.oil_copy' | t }}</p><a class="jc-lab-textlink" href="{{ routes.root_url }}pages/exploraciones#jc-exp-002">{{ 'jc_lab.visit_oil' | t }} ↗</a></div>
        </div>
        {% render 'jc-lab-products', investigation: 'oil', context_id: 'home' %}
      </section>
    </div>
  </section>

  <section class="jc-v2__hallazgos jc-v2__frame" id="jc-v2-hallazgos" aria-labelledby="jc-v2-hallazgos-title">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>06</span><span>{{ 'jc_hallazgos.label' | t }}</span></div>
    <div class="jc-hallazgos">
      <h2 id="jc-v2-hallazgos-title">{{ 'jc_hallazgos.title' | t }}</h2>
      <p>{{ 'jc_hallazgos.copy' | t }}</p>
      {% if section.settings.hallazgos_url != blank %}<a class="jc-hallazgos__link" href="{{ section.settings.hallazgos_url }}" target="_blank" rel="noopener">{{ 'jc_hallazgos.link' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  </section>

  <section class="jc-v2__faq jc-v2__frame" id="jc-v2-faq" aria-labelledby="jc-v2-faq-title">
    <div class="jc-v2__chapter jc-v2__chapter--rule"><span>07</span><span>PREGUNTAS FRECUENTES</span></div>
    <h2 id="jc-v2-faq-title">LO ESENCIAL.</h2>
<details><summary>{{ 'jc_lab.frozen_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'jc_lab.frozen_a' | t }}</p></details>
    <details><summary>{{ 'jc_lab.gellan_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'jc_lab.gellan_a' | t }}</p></details>
    <details><summary>{{ 'junglcore_biodiversity.faq_brand_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'junglcore_biodiversity.faq_brand_a' | t }}</p></details>
    <details><summary>¿Cómo se prepara NUBE?<span aria-hidden="true">+</span></summary><p>{{ 'jc_breakfast.faq_preparation' | t }}</p></details>
    <details><summary>{{ 'jc_faq.taste_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'jc_faq.taste_a' | t }}</p></details>
    <details><summary>{{ 'jc_faq.hot_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'jc_faq.hot_a' | t }}</p></details>
    <details><summary>¿Cómo se conserva?<span aria-hidden="true">+</span></summary><p>NUBE es un producto congelado. Consérvalo en el congelador y sigue las instrucciones de conservación de su envase.</p></details>
    <details><summary>¿Dónde entregan?<span aria-hidden="true">+</span></summary><p>{{ 'jc_faq.delivery_a' | t }}</p></details>
  </section>

  <footer class="jc-v2__footer" aria-label="Información de JUNGLCORE">
    <div class="jc-v2__footer-inner jc-v2__frame">
      <div class="jc-v2__footer-brand">
        <a href="{{ routes.root_url }}" aria-label="JUNGLCORE inicio"><img src="{{ 'jc-wordmark-refined-black.svg' | asset_url }}" alt="junglcore" width="1329" height="313" loading="lazy"></a>
        <p>Exploramos lo que la biodiversidad hace posible.</p>
        <p class="jc-v2__footer-location">COLOMBIA · HECHO DE AQUÍ</p>
      </div>
      <nav class="jc-v2__footer-nav" aria-label="JUNGLCORE">
        <h3>JUNGLCORE</h3>
        <a href="#jc-v2-nube">{{ 'junglcore_biodiversity.footer_products' | t }}</a>
        <a href="{{ routes.root_url }}pages/exploraciones">{{ 'junglcore_biodiversity.footer_explorations' | t }}</a>
        <a href="#jc-v2-roots">{{ 'jc_home_refined.nav_plant' | t }}</a>
        
      </nav>
      <nav class="jc-v2__footer-nav" aria-label="Ayuda y contacto">
        <h3>AYUDA</h3>
        <a href="#jc-v2-ritual">Cómo preparar NUBE</a>
        <a href="#jc-v2-faq">Preguntas frecuentes</a>
        {% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">Contacto</a>{% endif %}
        <a href="#jc-v2-faq">Envíos y entregas</a>
      </nav>
      <nav class="jc-v2__footer-nav" aria-label="Legal">
        <h3>LEGAL</h3>
        {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">Términos y condiciones</a>{% endif %}
        {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">Política de privacidad</a>{% endif %}
        {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Cambios y devoluciones</a>{% endif %}
        {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Política de envíos</a>{% endif %}
      </nav>
    </div>
    <div class="jc-v2__footer-bottom jc-v2__frame">
      <div class="jc-v2__footer-company">
        {% if section.settings.legal_name != blank %}<span>{{ section.settings.legal_name | escape }}</span>{% endif %}
        {% if section.settings.legal_nit != blank %}<span>NIT: {{ section.settings.legal_nit | escape }}</span>{% endif %}
        {% if section.settings.legal_address != blank %}<span>{{ section.settings.legal_address | escape }}</span>{% endif %}
        {% if section.settings.contact_phone != blank %}<span>Tel: {{ section.settings.contact_phone | escape }}</span>{% endif %}
        {% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>{% endif %}
      </div>
      <a class="jc-v2__backtop" href="#jc-v2-top">VOLVER ARRIBA ↑</a>
    </div>
  </footer>
</div>

{% style %}
.jc-v2.jc-bio .jc-bio__invitation-intro{max-width:760px;margin:0 0 36px;font-size:16px;line-height:1.7;color:#50534f}


.jc-v2__faq { padding-bottom: clamp(85px, 10vw, 125px); }
.jc-v2__faq h2 { font-size: clamp(35px, 5.3vw, 74px); font-weight: 650; line-height: 1.13; margin: 35px 0 50px; }
.jc-v2__faq details { border-bottom: 1px solid #d5d5d5; }
.jc-v2__faq details:first-of-type { border-top: 1px solid #d5d5d5; }
.jc-v2__faq summary { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:24px 2px; cursor:pointer; font-size:clamp(17px,2vw,24px); font-weight:450; list-style:none; }
.jc-v2__faq summary::-webkit-details-marker { display:none; }
.jc-v2__faq summary span { font-size:26px; font-weight:300; color:#666; transition:transform .2s; }
.jc-v2__faq details[open] summary span { transform:rotate(45deg); }
.jc-v2__faq details p { max-width:700px; padding:0 0 28px; color:#555; font-size:16px; line-height:1.7; }
.jc-v2__footer { display:block; background:#FCFBF8; border:0; padding:clamp(70px,9vw,110px) 0 0; }
.jc-v2__footer-inner { display:grid; grid-template-columns: minmax(250px,1.65fr) repeat(3,minmax(125px,.7fr)); column-gap:clamp(25px,4vw,75px); row-gap:50px; align-items:start; }
.jc-v2__footer-brand > a { display:block; width:min(100%,220px); line-height:0; }
.jc-v2__footer-brand img { display:block; width:100%; height:auto; margin:0; }
.jc-v2__footer-brand p { margin-top:25px; max-width:285px; color:#525252; font-size:15px; line-height:1.7; }
.jc-v2__footer-brand .jc-v2__footer-location { font-size:10px; font-weight:550; letter-spacing:.15em; margin-top:29px; }
.jc-v2__footer-nav { display:flex; flex-direction:column; gap:14px; align-items:flex-start; min-width:0; }
.jc-v2__footer-nav h3 { margin:0 0 19px; font-size:12px; font-weight:650; letter-spacing:.13em; }
.jc-v2__footer-nav a { font-size:14px; font-weight:400; color:#484848; line-height:1.5; }
.jc-v2__footer-nav a:hover,.jc-v2__footer-bottom a:hover { text-decoration:underline; text-underline-offset:5px; }
.jc-v2__footer-bottom { border-top:1px solid #d0d0ce; margin-top:clamp(75px,9vw,110px); padding:25px 0 30px; display:flex; justify-content:space-between; align-items:center; gap:24px; }
.jc-v2__footer-company { display:flex; flex-wrap:wrap; gap:8px 20px; align-items:center; }
.jc-v2__footer-company span,.jc-v2__footer-company a,.jc-v2__backtop { font-size:11px; color:#666; letter-spacing:0; line-height:1.6; font-weight:400; }
.jc-v2__backtop { white-space:nowrap; letter-spacing:.12em; color:#1a1a1a; }
.jc-v2__comparison-lead { max-width:690px; }
.jc-v2__comparison-notes p:first-child { font-weight:500; color:#555; }
@media (max-width: 950px) {
  .jc-v2__footer-inner { grid-template-columns: repeat(3,minmax(0,1fr)); gap:46px 28px; }
  .jc-v2__footer-brand { grid-column:1/-1; }
}
@media (max-width: 749px) {
  .jc-v2__faq { padding-bottom:80px; }
  .jc-v2__faq h2 { font-size:clamp(28px, 8.6vw, 54px); margin:28px 0 35px; }
  .jc-v2__faq summary { padding:19px 0; font-size:18px; }
  .jc-v2__footer { padding-top:65px; }
  .jc-v2__footer-inner { grid-template-columns:repeat(2,minmax(0,1fr)); gap:45px 24px; }
  .jc-v2__footer-brand { grid-column:1/-1; }
  .jc-v2__footer-nav h3 { margin-bottom:9px; }
  .jc-v2__footer-nav { gap:12px; }
  .jc-v2__footer-nav:last-child { grid-column:2; }
  .jc-v2__footer-bottom { flex-direction:column; align-items:flex-start; margin-top:60px; padding-bottom:40px; }
  .jc-v2__footer-company { display:flex; flex-direction:column; align-items:flex-start; gap:4px; }
}




.jc-v2__comparison-subtitle-mobile { display: none !important; }
.jc-v2__comparison-mobile-break { display: none; }
@media (max-width: 749px) {
  .jc-v2__comparison-scroll {
    overflow-x: visible !important;
    width: 100%;
  }
  .jc-v2__comparison-table {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100%;
    table-layout: fixed;
  }
  .jc-v2__comparison-table thead th:first-child {
    width: 30% !important;
  }
  .jc-v2__comparison-table th,
  .jc-v2__comparison-table td {
    padding: 15px 5px !important;
    overflow-wrap: break-word;
    word-break: normal;
  }
  .jc-v2__comparison-table th:first-child,
  .jc-v2__comparison-table td:first-child {
    padding-left: 0 !important;
  }
  .jc-v2__comparison-table th:last-child,
  .jc-v2__comparison-table td:last-child {
    padding-right: 0 !important;
  }
  .jc-v2__comparison-table thead th {
    font-size: 9px;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .jc-v2__comparison-table thead th strong {
    font-size: clamp(10px, 3vw, 12px);
    line-height: 1.22;
    letter-spacing: .015em;
    overflow-wrap: normal;
  }
  .jc-v2__comparison-table thead th span {
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0;
    margin-top: 7px;
  }
  .jc-v2__comparison-subtitle-desktop { display: none !important; }
  .jc-v2__comparison-table thead th span.jc-v2__comparison-subtitle-mobile {
    display: block !important;
  }
  .jc-v2__comparison-mobile-break { display: initial; }
  .jc-v2__comparison-table tbody th {
    font-size: clamp(12px, 3.3vw, 15px);
    line-height: 1.32;
  }
  .jc-v2__comparison-table tbody td {
    font-size: clamp(16px, 4.45vw, 20px);
    letter-spacing: -.02em;
    white-space: nowrap;
  }
  .jc-v2__comparison-table .jc-v2__comparison-muted {
    font-size: clamp(10px, 2.75vw, 13px);
    white-space: normal;
  }
}



.jc-v2__collection-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 2.3vw, 29px);
  margin-top: 52px;
}
.jc-v2__collection-photo {
  width: 100%;
  height: clamp(310px, 32vw, 390px);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
