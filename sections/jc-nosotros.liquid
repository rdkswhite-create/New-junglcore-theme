{% assign story_destination = routes.root_url | append: '#jc-v2-roots' %}
<div class="jc-story-moved" data-destination="{{ story_destination }}">
  <h1>{{ 'jc_story.relocated' | t }}</h1>
  <a href="{{ story_destination }}">{{ 'jc_story.relocated_link' | t }} ↗</a>
</div>
{% javascript %}
const storyLink = document.querySelector('.jc-story-moved');
if (storyLink && storyLink.dataset.destination && !window.Shopify?.designMode) {
  window.location.replace(storyLink.dataset.destination);
}
{% endjavascript %}
{% stylesheet %}
.jc-story-moved{padding:80px 24px;max-width:1000px;margin:auto;color:#30352f}
.jc-story-moved h1{font-size:clamp(30px,5vw,54px);line-height:1.15;font-weight:500}
.jc-story-moved a{font-size:14px;text-underline-offset:5px}
{% endstylesheet %}
{% schema %}
{"name":"JUNGLCORE Historia","settings":[],"presets":[{"name":"JUNGLCORE Historia"}]}
{% endschema %}
