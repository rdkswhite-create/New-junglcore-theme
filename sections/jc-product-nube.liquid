#jc-product-top .jc-gallery__choice img,#jc-product-top .jc-gallery__choice .jc-premium-pack{width:100%;height:clamp(100px,10vw,150px);object-fit:cover}
#jc-product-top .jc-gallery__choice span{font-size:12px;letter-spacing:.04em}
