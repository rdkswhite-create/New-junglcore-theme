#jc-product-top .jc-product__details p{font-size:16px;line-height:1.65;margin:0;padding:0 0 22px;color:#454b42}
#jc-product-top .jc-gallery__stage{aspect-ratio:1 / 1.05}
#jc-product-top .jc-gallery__panel--pack .jc-premium-pack{transform:scale(1.12)}
