#jc-product-top .jc-product__ritual,#jc-product-top .jc-product__uses{padding:42px 0 48px}
#jc-product-top .jc-breakfast__grid{display:grid;grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:86%;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:16px}
#jc-product-top .jc-breakfast__grid figure{grid-column:auto;scroll-snap-align:start}
#jc-product-top .jc-breakfast__grid figure:first-child .jc-breakfast__scene{max-width:none}
#jc-product-top .jc-breakfast__grid figure:first-child figcaption{text-align:left}
#jc-product-top .jc-breakfast figcaption{font-size:12px}
}

#jc-product-top .jc-product__form{display:flex;flex-direction:column;gap:18px}
#jc-product-top .jc-product__purchase-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:510px}
#jc-product-top .jc-product__purchase-actions .jc-product__button{margin:0;width:100%;min-height:44px;padding:12px 14px;font-size:11px;line-height:1.5;letter-spacing:.035em;gap:8px}
#jc-product-top .jc-product__quantity-row{display:flex;align-items:center;gap:16px}
#jc-product-top .jc-product__quantity-row label{font-size:13px}
#jc-product-top .jc-product__quantity-row input[type=number]{width:72px;min-height:38px;height:38px;padding:7px;font-size:15px}
#jc-product-top .jc-product__ritual,#jc-product-top .jc-product__uses,#jc-product-top .jc-nutrition,#jc-product-top .jc-product__exploration{border:0}
#jc-product-top .jc-ritual-choice__steps{gap:20px;margin:36px 0 24px}
#jc-product-top .jc-ritual-choice__steps li{border:0;background:#eeefea;padding:28px;min-width:0}
#jc-product-top .jc-ritual-choice__steps li>span{font-size:12px;margin-bottom:28px}
#jc-product-top .jc-ritual-choice__steps h4{font-size:24px;margin-bottom:16px}
#jc-product-top .jc-ritual-choice__steps p{font-size:16px;line-height:1.6}
#jc-product-top .jc-ritual-choice__value{border:0;padding:18px 0 0;margin:0}
#jc-product-top .jc-ritual-choice__options{border:0;margin:12px 0 0}
#jc-product-top .jc-ritual-choice__film{margin:24px 0 0}
#jc-product-top .jc-ritual-choice__film>summary,#jc-product-top .jc-ritual-choice__options>summary{background:#f0f1ec;padding:18px 22px;border:0}
#jc-product-top .jc-ritual-choice__options[open]>.jc-ritual-choice__intro{margin-top:24px}
#jc-product-top .jc-ritual-choice h2,#jc-product-top .jc-breakfast h2,#jc-product-top .jc-nutrition h2{font-family:inherit;font-size:clamp(30px,4vw,52px);font-weight:500;line-height:1.15;letter-spacing:-.025em;margin:0 0 28px}
#jc-product-top .jc-ritual-choice__opening{margin-top:0}
#jc-product-top .jc-nutrition>.jc-product__eyebrow{margin:0 0 22px}
@media(max-width:749px){
#jc-product-top .jc-product__purchase-actions{gap:8px;max-width:none}
#jc-product-top .jc-product__purchase-actions .jc-product__button{font-size:10px;padding:12px 8px;min-height:46px;gap:4px;letter-spacing:.01em}
#jc-product-top .jc-ritual-choice__steps{gap:12px}
#jc-product-top .jc-ritual-choice__steps li{padding:24px}
#jc-product-top .jc-ritual-choice__steps li>span{margin-bottom:20px}
#jc-product-top .jc-ritual-choice h2,#jc-product-top .jc-breakfast h2,#jc-product-top .jc-nutrition h2{font-size:clamp(29px,7.5vw,42px);margin:0 0 24px}
}
{% endstylesheet %}
