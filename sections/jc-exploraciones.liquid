        {% if settings.jc_sale_mode != 'a_la_venta' %}
          <a class="jcs-btn" href="{{ routes.root_url }}products/nube#jc-buy"><span>Primera tanda · {{ settings.jc_launch_label | default: '20 de noviembre' }}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
        {% else %}
        {% form 'product', nube, id: 'jcs-lab-strip-form', class: 'jcs-lab-strip__form' %}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <button type="submit" class="jcs-btn" {% unless v.available %}disabled{% endunless %}>{% if v.available %}<span>Comprar</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span>{% else %}<span>Agotada</span>{% endif %}</button>
        {% endform %}
        {% endif %}
        <a class="jcs-link" href="{{ routes.root_url }}products/nube">Ver NUBE <span aria-hidden="true">&rarr;</span></a>
      </div>
      {% endif %}
      <div class="jcs-lab-small">
        <p class="jcs-lab-inst">Planta 001: sacha inchi, cultivada por pequeños agricultores colombianos. <a href="{{ routes.root_url }}pages/nosotros">Conoce a quienes la cultivan &rarr;</a></p>
        <p class="jcs-lab-inst">¿ONG, universidad, institución? Las plantas olvidadas y la saciedad son preguntas grandes. <a href="{{ wa }}{{ 'Hola, les escribo desde una organización sobre JUNGLCORE LAB:' | url_encode }}" target="_blank" rel="noopener">Escríbenos &rarr;</a></p>
      </div>
    </div>
  </section>

  {% render 'jc-footer' %}
</div>
<script>
  (function () {
    function openFromHash() {
      var id = location.hash.slice(1); if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName === 'DETAILS') { el.open = true; el.scrollIntoView({ block: 'start' }); }
    }
    openFromHash(); window.addEventListener('hashchange', openFromHash);
    document.querySelectorAll('.jcs-entries .jcs-entry').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (!d.open) { d.querySelectorAll('video').forEach(function (v) { v.pause(); }); return; }
        document.querySelectorAll('.jcs-entries .jcs-entry[open]').forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
  })();
</script>

