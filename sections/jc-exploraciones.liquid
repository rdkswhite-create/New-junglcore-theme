{{ 'jc-shop.css' | asset_url | stylesheet_tag }}
{{ 'jc-lab.css' | asset_url | stylesheet_tag }}
<div class="jc-exp" id="jc-exp-top">
  <div class="jcs">{% render 'jc-header' %}</div>
  <div class="jc-exp__main">
    <section class="jc-exp__opening jc-exp__frame" aria-labelledby="jc-exp-title">
      <div class="jc-exp__rule"><span>{{ 'jc_lab.research_label' | t }}</span><span>001 — 002 / EN CURSO</span></div>
      <h1 id="jc-exp-title">{{ 'jc_lab.brand' | t }}</h1>
      <div class="jc-exp__opening-bottom">
        <div class="jc-lab-page-intro"><p>{{ 'jc_lab.intro' | t }}</p><p>{{ 'jc_lab.method' | t }}</p></div>
        <nav class="jc-exp__index" aria-label="{{ 'junglcore_explorations.index_label' | t }}">
          <a href="#jc-exp-001"><span>001</span> SACIEDAD <span aria-hidden="true">↓</span></a>
          <a href="#jc-exp-002"><span>002</span> LAS GRASAS DE LAS SEMILLAS <span aria-hidden="true">↓</span></a>
        </nav>
      </div>
    </section>
    <section class="jc-exp__chapter" id="jc-exp-001" aria-labelledby="jc-exp-001-title">
      <div class="jc-editorial">
        <figure class="jc-editorial__image jc-editorial__image--satiety"><img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-saciedad-despues.png?v=1793709874&width=1600" srcset="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-saciedad-despues.png?v=1793709874&width=600 600w, https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-saciedad-despues.png?v=1793709874&width=1000 1000w, https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-saciedad-despues.png?v=1793709874&width=1536 1536w" sizes="(min-width: 990px) 46vw, 100vw" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" alt="Una mujer junto a la ventana al terminar de comer, fotografía en blanco y negro"></figure>
        <div class="jc-editorial__copy">
          <div class="jc-editorial__meta"><span>001 / SACIEDAD</span><span>EN CURSO</span></div>
          <h2 id="jc-exp-001-title">{{ 'jc_satiety.headline' | t }}</h2>
          <div class="jc-editorial__description"><p>{{ 'jc_satiety.intro' | t }}</p><p>{{ 'jc_satiety.investigation' | t }}</p></div>
        </div>
      </div>
      <details class="jc-exp__fold jc-exp__research-panel" id="jc-exp-satiety-research">
        <summary><span>{{ 'jc_satiety.open_research' | t }}</span><span class="jc-exp__fold-arrow" aria-hidden="true">↓</span></summary>
        <div class="jc-exp__research-content">
          <section class="jc-exp__research-row" aria-labelledby="jc-satiety-question-label">
            <h3 id="jc-satiety-question-label">{{ 'jc_satiety.question_label' | t }}</h3>
            <div>
              <p class="jc-exp__research-question">{{ 'jc_satiety.question' | t }}</p>
              <p>{{ 'jc_satiety.seed_reason' | t }}</p>
            </div>
          </section>
          <section class="jc-exp__research-row" aria-labelledby="jc-satiety-evidence-label">
            <h3 id="jc-satiety-evidence-label">{{ 'jc_satiety.evidence_label' | t }}</h3>
            <div>
              <p>{{ 'jc_satiety.evidence_intro' | t }}</p>
              
              <details class="jc-exp__fold jc-exp__paper">
              <summary><span>{{ 'junglcore_explorations.research.protein_title' | t }}</span><span class="jc-exp__fold-arrow" aria-hidden="true">↓</span></summary>
              <div class="jc-exp__fold-content">
                <p class="jc-exp__paper-type">{{ 'junglcore_explorations.research.protein_type' | t }}</p>
                <p>{{ 'junglcore_explorations.research.protein_summary' | t }}</p>
                <p class="jc-exp__research-note">{{ 'junglcore_explorations.research.protein_limit' | t }}</p>
                <p class="jc-exp__paper-ref">{{ 'junglcore_explorations.research.protein_ref' | t }}</p>
                <a class="jc-exp__paper-link" href="https://pubmed.ncbi.nlm.nih.gov/32768415/" target="_blank" rel="noopener noreferrer">{{ 'junglcore_explorations.research.read_study' | t }} &rarr;</a>
              </div>
            </details>

            </div>
          </section>
          <section class="jc-exp__research-row" aria-labelledby="jc-satiety-open-label">
            <h3 id="jc-satiety-open-label">{{ 'jc_satiety.unknown_label' | t }}</h3>
            <div>
              <p>{{ 'jc_satiety.unknown' | t }}</p>
              <p class="jc-exp__research-note">{{ 'jc_satiety.product_limit' | t }}</p>
            </div>
          </section>
        </div>
      </details>
      {% render 'jc-lab-products', investigation: 'satiety', context_id: 'lab' %}
    </section>
    <section class="jc-exp__chapter jc-exp__chapter--oil" id="jc-exp-002" aria-labelledby="jc-exp-002-title">
      <div class="jc-editorial">
        <figure class="jc-editorial__image jc-editorial__image--oil"><img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-aceite-cuchara.png?v=1793755044&width=1200" srcset="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-aceite-cuchara.png?v=1793755044&width=600 600w, https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-aceite-cuchara.png?v=1793755044&width=1000 1000w, https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-aceite-cuchara.png?v=1793755044&width=1536 1536w" sizes="(min-width: 990px) 46vw, 100vw" width="1536" height="1024" loading="lazy" decoding="async" alt="Composición editorial de una cuchara con aceite sobre fondo claro."></figure>
        <div class="jc-editorial__copy">
          <div class="jc-editorial__meta"><span>002 / GRASAS DE SEMILLAS</span><span>EN CURSO</span></div>
          <h2 id="jc-exp-002-title">{{ 'junglcore_explorations.oil_everyday_title' | t }}</h2>
          <div class="jc-editorial__description"><p>{{ 'junglcore_explorations.oil_everyday_copy' | t }}</p></div>
        </div>
      </div>
      <details class="jc-exp__fold jc-exp__research-panel" id="jc-exp-oil-research">
        <summary><span>{{ 'jc_satiety.open_research' | t }}</span><span class="jc-exp__fold-arrow" aria-hidden="true">↓</span></summary>
        <div class="jc-exp__research-content">
          <section class="jc-exp__research-row" aria-labelledby="jc-oil-question-label">
            <h3 id="jc-oil-question-label">{{ 'jc_satiety.question_label' | t }}</h3>
            <div>
              <p class="jc-exp__research-question">{{ 'junglcore_explorations.oil_everyday_title' | t }}</p>
              <p>{{ 'junglcore_explorations.oil_research.intro' | t }}</p>
            </div>
          </section>
          <section class="jc-exp__research-row" aria-labelledby="jc-oil-evidence-label">
            <h3 id="jc-oil-evidence-label">{{ 'jc_satiety.evidence_label' | t }}</h3>
            <div><p>{{ 'junglcore_explorations.oil_research.composition' | t }}</p><p class="jc-exp__research-note">{{ 'junglcore_explorations.oil_research.composition_ref' | t }}</p></div>
            <div>


            </div>
          </section>
          <section class="jc-exp__research-row" aria-labelledby="jc-oil-open-label">
            <h3 id="jc-oil-open-label">{{ 'jc_satiety.unknown_label' | t }}</h3>
            <div><p>{{ 'junglcore_explorations.oil_research.open_copy' | t }}</p></div>
          </section>
        </div>
      </details>
      {% render 'jc-lab-products', investigation: 'oil', context_id: 'lab' %}
    </section>
    <div class="jc-exp__frame">
      <section class="jc-exp__outro jc-story-future" aria-labelledby="jc-story-future-title">
        <div><h2 id="jc-story-future-title">{{ 'jc_story.future_title' | t }}</h2><p class="jc-story-future__copy">{{ 'jc_story.future_copy' | t }}</p><p class="jc-story-future__humour">{{ 'jc_story.future_humour' | t }}</p></div>
        <a href="{{ routes.root_url }}products/nube">{{ 'jc_story.products' | t }} <span aria-hidden="true">&rarr;</span></a>
      </section>
    </div>
  </div>
  <div class="jcs">{% render 'jc-footer' %}</div>
</div>
{% style %}
.jc-exp { --jc-paper:#FCFBF8; --jc-ink:#181918; --jc-muted:#63655f; --jc-rule:#d3d5cf; background:var(--jc-paper); color:var(--jc-ink); font-family:'Manrope',"Helvetica Neue",Arial,sans-serif; font-synthesis:none; }
.jc-exp * {box-sizing:border-box;}
.jc-exp a { color:inherit; text-decoration:none; }
.jc-exp img { max-width:100%; }
.jc-exp__frame { width:min(100% - 84px,1280px); margin-inline:auto; }
.jc-exp__header { min-height:95px; display:grid; grid-template-columns:minmax(156px,1fr) auto minmax(146px,1fr); align-items:center; gap:30px; padding:23px clamp(25px,4vw,60px); border-bottom:1px solid #e7e6e1; background:var(--jc-paper); }
.jc-exp__logo {display:block; width:154px; line-height:0;}
.jc-exp__logo img {width:100%;height:auto;display:block;}
.jc-exp__nav { display:flex; align-items:center; gap:clamp(16px,2.5vw,35px); }
.jc-exp__nav a {font-size:10px;font-weight:500;letter-spacing:.08em;white-space:nowrap;padding:10px 0;}
.jc-exp__nav a[aria-current="page"] {border-bottom:1px solid currentColor;}
.jc-exp__header-cta {justify-self:end;white-space:nowrap;font-size:10px;font-weight:550;letter-spacing:.075em;border-bottom:1px solid currentColor;padding-bottom:5px;}
.jc-exp__intro {padding:clamp(85px,10vw,148px) 0 clamp(100px,11vw,165px);}
.jc-exp__rule,.jc-exp__study-head {display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--jc-ink);padding-top:17px;font-size:10px;font-weight:550;letter-spacing:.14em;line-height:1.5;}
.jc-exp__intro h1 {max-width:900px;margin:clamp(58px,8vw,104px) 0 29px;font-size:clamp(41px,6.5vw,91px);font-weight:550;line-height:1.12;letter-spacing:-.035em;}
.jc-exp__intro>p {max-width:620px;font-size:clamp(17px,1.7vw,21px);font-weight:380;line-height:1.65;color:#4b4d48;}
.jc-exp__study {padding-bottom:clamp(110px,12vw,175px);scroll-margin-top:30px;}
.jc-exp__study-head {border-color:var(--jc-rule);margin-bottom:clamp(45px,5vw,72px);}
.jc-exp__study-grid {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(34px,6.3vw,105px);align-items:start;}
.jc-exp__image {margin:0;min-width:0;}
.jc-exp__image img {display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;background:#ebe9e3;}
.jc-exp__study--reverse .jc-exp__image img { aspect-ratio:4/3; object-fit:cover; }
.jc-exp__image figcaption {margin-top:14px;font-size:10px;letter-spacing:.12em;color:var(--jc-muted);line-height:1.5;}
.jc-exp__study-copy h2 {font-size:clamp(35px,4vw,62px);font-weight:520;line-height:1.15;letter-spacing:-.028em;margin:0 0 clamp(31px,4vw,58px);}
.jc-exp__study-copy h3 {max-width:530px;font-size:clamp(24px,2.5vw,36px);font-weight:450;line-height:1.3;letter-spacing:-.015em;margin:0 0 23px;}
.jc-exp__study-copy>p {max-width:540px;font-size:clamp(16px,1.35vw,18px);font-weight:380;line-height:1.68;color:#545750;margin:0 0 34px;}
.jc-exp__study--reverse .jc-exp__image {grid-column:2;grid-row:1;}
.jc-exp__study--reverse .jc-exp__study-copy {grid-column:1;grid-row:1;}
.jc-exp__linked {display:flex;flex-wrap:wrap;align-items:center;column-gap:17px;row-gap:13px;font-size:11px;font-weight:500;letter-spacing:.05em;padding:20px 0;border-top:1px solid var(--jc-rule);}
.jc-exp__linked>span {font-size:10px;color:#686b65;letter-spacing:.09em;margin-right:10px;}
.jc-exp__linked a {text-underline-offset:4px;}
.jc-exp__linked a:hover {text-decoration:underline;}
.jc-exp__fold {border-top:1px solid var(--jc-rule);margin-top:8px;}
.jc-exp__fold summary {list-style:none;cursor:pointer;padding:18px 0;min-height:54px;display:flex;align-items:center;gap:20px;font-size:11px;font-weight:520;letter-spacing:.1em;}
.jc-exp__fold summary::-webkit-details-marker {display:none;}
.jc-exp__fold-close {display:none;}
.jc-exp__fold[open] .jc-exp__fold-read {display:none;}
.jc-exp__fold[open] .jc-exp__fold-close {display:block;}
.jc-exp__fold-arrow {margin-left:auto;font-size:22px;font-weight:300;transition:transform .2s ease;}
.jc-exp__fold[open] .jc-exp__fold-arrow {transform:rotate(180deg);}
.jc-exp__fold-content {max-width:530px;padding:7px 0 25px;}
.jc-exp__fold-content p {margin:0 0 18px;color:#50534c;font-size:15px;line-height:1.7;}
.jc-exp__outro {padding:32px 0 clamp(110px,11vw,165px);border-top:1px solid var(--jc-rule);display:flex;justify-content:space-between;align-items:end;gap:30px;}
.jc-exp__outro p {font-size:clamp(19px,2.2vw,28px);line-height:1.4;max-width:650px;letter-spacing:-.01em;margin:0;}
.jc-exp__outro a {font-size:11px;font-weight:550;letter-spacing:.08em;border-bottom:1px solid currentColor;padding-bottom:6px;white-space:nowrap;}
.jc-exp__footer {background:var(--jc-paper);border-top:1px solid var(--jc-rule);padding:70px 0 55px;}
.jc-exp__footer-top {display:grid;grid-template-columns:minmax(280px,2fr) 1fr 1fr;gap:42px;}
.jc-exp__footer-brand>a {display:block;width:215px;line-height:0;}
.jc-exp__footer-brand img {width:100%;height:auto;display:block;}
.jc-exp__footer-brand p {font-size:14px;color:#555951;margin:23px 0 20px;}
.jc-exp__footer-brand>span {font-size:10px;font-weight:500;letter-spacing:.1em;}
.jc-exp__footer-links {display:flex;flex-direction:column;align-items:flex-start;gap:15px;}
.jc-exp__footer-links a {font-size:13px;color:#50534d;line-height:1.45;}
.jc-exp a:focus-visible,.jc-exp summary:focus-visible {outline:2px solid currentColor;outline-offset:5px;}
@media(max-width:950px){.jc-exp__header {grid-template-columns:1fr auto;gap:15px;padding:20px 24px;}.jc-exp__nav {grid-column:1/-1;grid-row:2;justify-content:space-between;gap:12px;}.jc-exp__header-cta {grid-row:1;grid-column:2;}.jc-exp__frame {width:calc(100% - 48px);}}
@media(max-width:749px){.jc-exp__header{padding:18px 18px 15px;gap:14px;}.jc-exp__logo{width:138px;}.jc-exp__nav a{font-size:9px;letter-spacing:.035em;}.jc-exp__header-cta{font-size:9px;}.jc-exp__frame{width:calc(100% - 36px);}.jc-exp__intro{padding:78px 0 96px;}.jc-exp__rule,.jc-exp__study-head{font-size:9px;letter-spacing:.06em;}.jc-exp__intro h1{font-size:clamp(37px,9vw,55px);line-height:1.15;margin:54px 0 25px;}.jc-exp__intro>p{font-size:17px;line-height:1.6;}.jc-exp__study{padding-bottom:100px;}.jc-exp__study-head{margin-bottom:33px;}.jc-exp__study-grid{grid-template-columns:1fr;gap:34px;}.jc-exp__image img{aspect-ratio:4/4.2;}.jc-exp__study-copy h2{font-size:clamp(33px,9vw,48px);margin:0 0 30px;}.jc-exp__study-copy h3{font-size:clamp(23px,6.4vw,29px);}.jc-exp__study-copy>p{font-size:16px;margin-bottom:27px;}.jc-exp__study--reverse .jc-exp__image,.jc-exp__study--reverse .jc-exp__study-copy{grid-column:1;grid-row:auto;}.jc-exp__outro{flex-direction:column;align-items:flex-start;padding:25px 0 95px;gap:28px;}.jc-exp__outro p{font-size:20px;}.jc-exp__footer{padding:54px 0;}.jc-exp__footer-top{grid-template-columns:1fr 1fr;gap:36px 20px;}.jc-exp__footer-brand{grid-column:1/-1;}.jc-exp__footer-links a{font-size:12px;}}
@media(prefers-reduced-motion:reduce){.jc-exp__fold-arrow{transition:none;}}

.jc-exp__opening{padding:65px 0 60px}
.jc-exp__opening h1{margin:50px 0 40px;font-size:clamp(38px,6.5vw,88px);font-weight:550;line-height:1.04;letter-spacing:-.045em;color:var(--jc-ink)}
.jc-exp__opening h1>span{color:#797b74}
.jc-exp__opening-bottom{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:end}
.jc-exp__opening-bottom>p{max-width:410px;font-size:17px;line-height:1.6;margin:0;color:#555951}
.jc-exp__index{display:grid;gap:0}
.jc-exp__index a{display:flex;align-items:center;gap:18px;border-bottom:1px solid var(--jc-rule);padding:14px 0;font-size:10px;letter-spacing:.08em}
.jc-exp__index a>span:first-child{color:#73766e}
.jc-exp__index a>span:last-child{margin-left:auto;font-size:20px}
.jc-exp__chapter{scroll-margin-top:20px}
.jc-exp__cinema{position:relative;min-height:580px;height:min(75vw,820px);max-height:90svh;background:#252522;isolation:isolate;overflow:hidden;color:#fff}
.jc-exp__cinema>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 55%;z-index:-2}
.jc-exp__cinema-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.36),transparent 75%),linear-gradient(180deg,rgba(0,0,0,.22),transparent 35%,rgba(0,0,0,.22));z-index:-1}
.jc-exp__cinema-content{height:100%;padding:34px clamp(24px,5vw,80px) 40px;display:flex;flex-direction:column}
.jc-exp__scene-meta{display:flex;justify-content:space-between;gap:20px;font-size:10px;letter-spacing:.13em;line-height:1.5}
.jc-exp__scene-title{font-size:clamp(42px,7.3vw,112px);line-height:1.02;letter-spacing:-.04em;font-weight:500;margin:auto 0;color:#fff;max-width:60%}
.jc-exp__scene-caption{font-size:10px;letter-spacing:.14em}
.jc-exp__chapter-detail{display:grid;grid-template-columns:.65fr 1.35fr;gap:clamp(30px,7vw,110px);padding-block:75px 100px}
.jc-exp__chapter-number{font-size:clamp(60px,10vw,145px);font-weight:350;letter-spacing:-.065em;line-height:1;color:#999c92}
.jc-exp__chapter-detail .jc-exp__study-copy h2{font-size:12px;letter-spacing:.14em;font-weight:550;margin:0 0 26px}
.jc-exp__chapter-detail .jc-exp__study-copy h2 br{display:none}
.jc-exp__chapter-detail .jc-exp__study-copy h3{font-size:clamp(28px,3.2vw,44px);max-width:680px;line-height:1.18;letter-spacing:-.025em}
.jc-exp__chapter-detail .jc-exp__study-copy>p{max-width:600px}
.jc-exp__botanical{padding-top:30px;padding-bottom:65px;border-top:1px solid var(--jc-rule)}
.jc-exp__botanical-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:35px;padding-top:45px}
.jc-exp__botanical-title{font-size:clamp(34px,4.8vw,70px);font-weight:500;line-height:1.08;letter-spacing:-.035em;margin:0}
.jc-exp__botanical-title span{color:#797b74}
.jc-exp__botanical figure{margin:0}
.jc-exp__botanical figure img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain}
.jc-exp__botanical figcaption{font-size:9px;letter-spacing:.12em;line-height:1.5;margin-top:17px;color:#63655f}
.jc-exp__oil-detail{background:#20231f;color:#f7f6f0}
.jc-exp__oil-detail .jc-exp__study-copy>p,.jc-exp__oil-detail .jc-exp__fold-content p{color:#c5c9bf}
.jc-exp__oil-detail .jc-exp__linked>span{color:#aeb5a7}
.jc-exp__oil-detail .jc-exp__linked,.jc-exp__oil-detail .jc-exp__fold{border-color:#50574b}
.jc-exp__oil-object{display:flex;flex-direction:column;align-items:flex-start}
.jc-exp__oil-object>img{width:min(100%,260px);height:auto;display:block;margin:15px auto 25px}
.jc-exp__oil-object>a{font-size:10px;letter-spacing:.12em;align-self:center;border-bottom:1px solid #858d7d;padding-bottom:9px}
.jc-exp__outro{padding-top:60px;margin-top:65px}
@media(max-width:749px){
.jc-exp__opening{padding:40px 0 35px}
.jc-exp__opening h1{font-size:clamp(32px,8.7vw,62px);line-height:1.08;margin:34px 0 27px;letter-spacing:-.035em}
.jc-exp__opening-bottom{grid-template-columns:1fr;gap:20px}
.jc-exp__opening-bottom>p{font-size:15px}
.jc-exp__index a{font-size:9px;padding:11px 0;gap:12px}
.jc-exp__cinema{height:650px;min-height:0;max-height:none}
