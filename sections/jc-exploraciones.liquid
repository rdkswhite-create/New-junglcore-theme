{{ 'jc-shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign nube = all_products['nube']
  assign v = nube.selected_or_first_available_variant
  assign wa = 'https://wa.me/573011571039?text='
  assign ig = settings.jc_instagram_url | default: 'https://www.instagram.com/tryjunglcore'
  assign latest_src = 'jc-lab-vinieron.mp4' | asset_url
  assign latest_poster = 'jc-lab-vinieron-poster.jpg' | asset_url
  if section.settings.latest_video != blank
    assign best_w = 0
    for source in section.settings.latest_video.sources
      if source.mime_type == 'video/mp4' and source.width <= 1080 and source.width > best_w
        assign latest_src = source.url
        assign best_w = source.width
      endif
    endfor
    assign latest_poster = section.settings.latest_video.preview_image | image_url: width: 900
  endif
  assign latest_number = section.settings.latest_number | default: '000'
  assign latest_title = section.settings.latest_title | default: 'Vinieron buscando la jungla'
  assign latest_line = section.settings.latest_line | default: 'Cuatro mil días de viaje… para esto.'
-%}
<div class="jcs jcs-log" id="top">
  {% render 'jc-header', buy_href: '#jc-nube' %}

  {%- comment -%} 1 · Who we are: one sentence and the film. {%- endcomment -%}
  <section class="jcs-log-intro" aria-labelledby="jc-log-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>LAB</span>Bitácora de la nave</p>
      <div class="jcs-lab-top">
        <div class="jcs-lab-top__copy">
          <h1 class="jcs-log-intro__title" id="jc-log-title">Vinieron buscando la jungla.</h1>
          <p class="jcs-log-intro__frame"><strong>JUNGLCORE LAB estudia lo que la biodiversidad puede hacer por tu salud.</strong> Empezamos por una semilla colombiana: la sacha inchi.</p>
          <p class="jcs-lab-budget">Misión: encontrar la jungla <span aria-hidden="true">·</span> Presupuesto: <span class="jcs-file__stamp">Agotado</span></p>
        </div>
        <div class="jcs-lab-top__video">
          <p class="jcs-lab-film__kicker">Película 1 · 1 min · Empieza aquí</p>
          {% unless latest_title == 'Vinieron buscando la jungla' %}<h2 class="jcs-lab-film__title">{{ latest_title }}</h2>{% endunless %}
          <p class="jcs-lab-film__what">Bajan a la Tierra a buscar la jungla. Encuentran un pasillo.</p>
          {% render 'jc-tap-video', id: 'jcs-lab-latest', src: latest_src, poster: latest_poster, label: 'Ver la película' %}
          <p class="jcs-lab-latest__line">«{{ latest_line }}»</p>
          <details class="jcs-lab-more-film">
            <summary>
              <span class="jcs-lab-more-film__text"><span class="jcs-lab-film__kicker">Película 2 · 2 min</span><span class="jcs-lab-more-film__q">¿Quieres entender la misión completa?</span></span>
              <span class="jcs-lab-more-film__plus" aria-hidden="true"></span>
            </summary>
            <p class="jcs-lab-film__what">Por qué vinieron: menos plantas, menos empresas, la tierra cansada. Y una semilla de la selva.</p>
            {%- capture vm -%}{{ 'jc-lab-la-mision.mp4' | asset_url }}{%- endcapture -%}
            {%- capture pm -%}{{ 'jc-lab-la-mision-poster.jpg' | asset_url }}{%- endcapture -%}
            {% render 'jc-tap-video', id: 'jcs-lab-mision', src: vm, poster: pm, label: 'Ver La misión' %}
          </details>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} 2 · What we make. Satiety comes out of it, next. {%- endcomment -%}
  <section class="jcs-lab-next jcs-lab-make" id="jc-viene" aria-labelledby="jc-hacemos-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>01</span>Lo que hacemos</p>
      <h2 class="jcs-title jcs-lab-make__title" id="jc-hacemos-title">Una semilla. Dos formas.</h2>
      <div class="jcs-lab-next__grid jcs-lab-make__grid">
        <div class="jcs-lab-next__item">
          <p class="jcs-eyebrow">NUBE · La bebida · <span class="jcs-lab-status jcs-lab-status--ok">{% if settings.jc_sale_mode != 'a_la_venta' %}Primera tanda · {{ settings.jc_launch_short | default: '20 nov' }}{% else %}A la venta{% endif %}</span></p>
          <h3>Una bebida vegetal que no viene de un monocultivo.</h3>
          <p>Sacha inchi, agua y goma gelana. 6,3 g de proteína por vaso. La comparamos con almendra, avena, arroz y soya. No siempre gana.</p>
          <a class="jcs-btn" href="{{ routes.root_url }}products/nube#jc-buy"><span>{% if settings.jc_sale_mode != 'a_la_venta' %}Apúntate a la primera tanda{% else %}Comprar NUBE{% endif %}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
          <a class="jcs-link" href="{{ routes.root_url }}products/nube#jc-nutrition">Ver la tabla completa <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="jcs-lab-next__item">
          <p class="jcs-eyebrow">ONE · La proteína · <span class="jcs-lab-status">Pronto</span></p>
          <h3>Una proteína hecha de la misma semilla.</h3>
          <p>Un solo ingrediente, para lo que ya comes.{% if settings.jc_sale_mode != 'a_la_venta' and settings.jc_waitlist_perk != blank %} {{ settings.jc_waitlist_perk }}{% endif %}</p>
          <a class="jcs-link" href="{{ wa }}{{ 'jc_lab.one_message' | t | url_encode }}" target="_blank" rel="noopener">Avísame <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <ul class="jcs-lab-also">
        <li><strong>OIL.</strong> El aceite de la semilla. Lo estudiamos por el corazón. <a href="{{ wa }}{{ 'jc_lab.oil_message' | t | url_encode }}" target="_blank" rel="noopener">Avísame &rarr;</a></li>
        <li><strong>Planta 002.</strong> ¿Conoces una planta que nadie mira, una que comía tu abuela? <a href="{{ wa }}{{ 'Hola, les propongo una planta para la bitácora:' | url_encode }}" target="_blank" rel="noopener">Cuéntanos &rarr;</a></li>
      </ul>
      <p class="jcs-lab-bridge"><a href="#jc-pausa">Y en las pruebas con gente encontramos algo que no buscábamos. <span aria-hidden="true">&darr;</span></a></p>
    </div>
  </section>

  {%- comment -%} 3 · What we found: satiety. A belief we are testing, never a promise. Evidence folded. {%- endcomment -%}
  <section class="jcs-lab-study jcs-pausa" id="jc-pausa" aria-labelledby="jc-pausa-title">
    <span id="jc-estudio" class="jcs-anchor" aria-hidden="true"></span>
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>02</span>Lo que encontramos · Abierto</p>
      <div class="jcs-lab-study__grid">
        <div>
          <h2 class="jcs-display jcs-pausa__title" id="jc-pausa-title">Saciedad.</h2>
          <p class="jcs-lead">Fue lo que más nos dijeron quienes la probaron: se sentían llenos por más tiempo. El antojo de media tarde llegaba más tarde.</p>
          <p class="jcs-pausa__belief">Un antojo dura minutos. Si llega más tarde, ganas tú.</p>
          <p class="jcs-pausa__text">Creemos que es la semilla. Todavía no lo hemos demostrado: lo estamos probando con gente de verdad, cada día.</p>
          <a class="jcs-btn" href="{{ wa }}{{ 'Hola, quiero ser parte del grupo que está probando NUBE.' | url_encode }}" target="_blank" rel="noopener"><span>Quiero ser parte</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
          <p class="jcs-pausa__open">Está abierto.</p>
          <p class="jcs-pausa__batch">{% if settings.jc_sale_mode != 'a_la_venta' %}Los de la primera tanda pueden ser parte. <a href="{{ routes.root_url }}products/nube#jc-buy">Apúntate a la primera tanda &rarr;</a>{% else %}Quienes toman NUBE pueden ser parte. <a href="{{ routes.root_url }}products/nube#jc-buy">Ver NUBE &rarr;</a>{% endif %}</p>
          <p class="jcs-log-small">No hemos demostrado que NUBE cambie los antojos. Es una pregunta abierta, no una promesa. No es un tratamiento ni sustituye la ayuda de un profesional. Usamos tus respuestas sin tu nombre, según nuestra <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">política de privacidad</a>.</p>
        </div>
        <div class="jcs-log-check">
          <div class="jcs-pausa__glp">
            <p class="jcs-pausa__glp-title">¿Y el GLP-1?</p>
            <p>El GLP-1 es una hormona que tu intestino libera cuando comes y que ayuda a sentirte lleno. Medicamentos como Ozempic la imitan con una fuerza cientos de veces mayor, durante toda la semana. Ninguna comida hace eso. Lo que sí estudiamos es cómo una comida acompaña las señales de saciedad que tu cuerpo ya tiene.</p>
          </div>
          <details class="jcs-lab-fold">
            <summary><span class="jcs-lab-fold__q">Por qué creemos que puede funcionar</span><span class="jcs-lab-fold__plus" aria-hidden="true"></span></summary>
            <ul class="jcs-pausa__known">
              <li><strong>La proteína es el nutriente que más llena.</strong> En ensayos controlados aumenta la sensación de llenura y baja el hambre. Cada vaso de NUBE trae 6,3 g de proteína vegetal. <a href="https://pubmed.ncbi.nlm.nih.gov/32768415/" target="_blank" rel="noopener noreferrer">Kohanmoo y col., 2020 &rarr;</a></li>
              <li><strong>Los péptidos de la sacha inchi.</strong> Al digerirse, la proteína se rompe en péptidos: pedazos pequeños que el intestino lee como señales, entre ellas las de saciedad. En laboratorio, péptidos de la proteína de sacha inchi frenaron la DPP-4, la enzima que apaga el GLP-1. Es un resultado de laboratorio, no en personas. Es justo lo que queremos estudiar. <a href="https://doi.org/10.1002/jsfa.12464" target="_blank" rel="noopener noreferrer">Zhang y col., 2023 &rarr;</a></li>
              <li><strong>El ruido de la comida.</strong> Así llaman los pacientes a los pensamientos constantes sobre comida. En una encuesta de Novo Nordisk, el fabricante de Ozempic, a 550 personas con Wegovy, quienes los tenían todo el día pasaron del 62 % al 16 %. Lo que ganaron no fue solo menos hambre: fue silencio. <a href="https://cris.maastrichtuniversity.nl/en/publications/retrospective-assessment-of-food-noise-changes-after-initiation-o/" target="_blank" rel="noopener noreferrer">Arnaut y col., 2026 &rarr;</a></li>
              <li><strong>Un antojo dura minutos.</strong> La psicóloga Jackie Andrade, de la Universidad de Plymouth, lo ha medido. Tres minutos de Tetris lo debilitaron cerca de un 24 %, suficiente para volver tolerable un antojo hasta que pasa solo. <a href="https://doi.org/10.1016/j.appet.2014.01.073" target="_blank" rel="noopener noreferrer">Skorka-Brown, Andrade y May, 2014 &rarr;</a></li>
            </ul>
            <blockquote class="jcs-log-note jcs-pausa__robot"><p>Me pidieron anotar a qué hora llega el antojo. Llevo tres días mirando el reloj. A mí no me llega ninguno.</p><footer>Dato · robot azul</footer></blockquote>
          </details>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} 4 · Questions from the ship: the robots ask, we check. Newest first. {%- endcomment -%}
  <section class="jcs-lab-log" id="jc-bitacora" aria-labelledby="jc-bitacora-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>03</span>Bitácora</p>
      <div class="jcs-lab-head">
        <h2 class="jcs-title" id="jc-bitacora-title">Preguntas desde la nave.</h2>
        <div>
          <p class="jcs-lead">Los robots preguntan. Nosotros comprobamos la respuesta. Toca una para abrirla.</p>
          <p class="jcs-lab-rule jcs-lab-rule--dark">Los robots son ficción. Las cifras, no.</p>
        </div>
      </div>
      <div class="jcs-entries">

        <details class="jcs-entry" id="jc-log-008">
          <summary><span class="jcs-entry__num">008</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Quién fabrica de verdad tu bebida de avena?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">Comprobado</span></span></summary>
          <div class="jcs-entry__body">
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Leí la parte de atrás de cuatro cajas. Cuatro marcas, cuatro plantas. Le di la vuelta a la de avena y a la de arroz: el mismo fabricante. Le pregunté a Lupa si eso cuenta como elegir. No contestó.</p><footer>Dato · robot azul</footer></blockquote>
              <div class="jcs-log-check">
                <h3>Lo que comprobamos</h3>
                <ul>
                  <li><strong>Avena y arroz, la misma casa.</strong> Las dos bebidas de nuestra tabla son Nature’s Heart, la marca de Terrafertil. Nestlé compró la mayoría de Terrafertil en 2018. <a href="https://lexlatin.com/noticias/nestle-adquiere-participacion-mayoritaria-en-terrafertil" target="_blank" rel="noopener noreferrer">Fuente &rarr;</a></li>
                  <li><strong>La de soya.</strong> Silk es una marca de Danone; la versión que se vende en México la fabrica Danone de México. <a href="https://www.amazon.com.mx/Silk-Bebida-Soya-Az%C3%BAcar-946ml/dp/B0DGYJ6Y64" target="_blank" rel="noopener noreferrer">Fuente &rarr;</a></li>
                  <li><strong>Las cifras de cada una,</strong> por vaso de 200 ml, en la tabla completa.</li>
                </ul>
                <a class="jcs-link" href="{{ routes.root_url }}products/nube#jc-nutrition">Ver las cinco, cuenta por cuenta <span aria-hidden="true">&rarr;</span></a>
              </div>
              <p class="jcs-log-open"><span>Sigue abierto</span>Cuántas marcas quedan en el pasillo si se cuentan los dueños y no las cajas.</p>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-007">
          <summary><span class="jcs-entry__num">007</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Por qué todos miran un rectángulo?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">Visto</span></span></summary>
          <div class="jcs-entry__body">
            <div class="jcs-entry__media">
              {%- capture v007 -%}{{ 'jc-bitacora-007.mp4' | asset_url }}{%- endcapture -%}
              {%- capture p007 -%}{{ 'jc-bitacora-007-poster.jpg' | asset_url }}{%- endcapture -%}
              {% render 'jc-tap-video', id: 'jcs-lab-007', src: v007, poster: p007, label: 'Ver la entrada' %}
            </div>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Entrada siete. Transporte humano. Doscientas personas en una caja con ruedas. Nadie habla. Todos miran un rectángulo pequeño. Le pregunté a uno dónde estaba la jungla. Me dijo que me bajara en la setenta y dos.</p><footer>Lupa · robot rojo</footer></blockquote>
              <p class="jcs-log-open"><span>Sigue abierto</span>Si alguien se bajó en la 72 y la encontró.</p>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-006">
          <summary><span class="jcs-entry__num">006</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Qué es NUBE?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">Visto</span></span></summary>
          <div class="jcs-entry__body">
            <div class="jcs-entry__media">
              {%- capture v006 -%}{{ 'jc-bitacora-006.mp4' | asset_url }}{%- endcapture -%}
              {%- capture p006 -%}{{ 'jc-bitacora-006-poster.jpg' | asset_url }}{%- endcapture -%}
              {% render 'jc-tap-video', id: 'jcs-lab-006', src: v006, poster: p006, label: 'Ver la entrada' %}
            </div>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Vimos el anuncio de los humanos. Tenemos preguntas.</p><footer>Lupa, Chispa y Dato</footer></blockquote>
              <div class="jcs-log-check"><h3>Lo que comprobamos</h3><p>Es cierto: una barra del congelador, agua caliente o licuadora. Tres ingredientes. No hay más.</p></div>
              <p class="jcs-log-open"><span>Sigue abierto</span>Si hacen envíos a la órbita. Por ahora, solo a Bogotá.</p>
              <a class="jcs-link" href="#jc-nube">{% if settings.jc_sale_mode != 'a_la_venta' %}Apúntate a la primera tanda{% else %}Comprar NUBE{% endif %} <span aria-hidden="true">&darr;</span></a>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-005">
          <summary><span class="jcs-entry__num">005</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Cuál es la planta 002?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">Abierto</span></span></summary>
          <div class="jcs-entry__body">
            <figure class="jcs-entry__media">
              <img src="{{ 'jc-suelo-planta-002.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 45%" alt="Chispa, sola en una sala de espera, compara una hoja de una planta de plástico con la plántula real que lleva en un frasco">
              <figcaption>Planta 002 · Candidata. Era de plástico.</figcaption>
            </figure>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Vinimos por la jungla. Llevamos una planta. Quedan miles. A este ritmo, el informe estará listo en tres siglos.</p><footer>Lupa, Chispa y Dato</footer></blockquote>
              <p class="jcs-log-open"><span>Sigue abierto</span>Cuál sigue. Si conoces una planta que nadie mira, cuéntanos.</p>
              <a class="jcs-link" href="#jc-viene">Proponer una planta <span aria-hidden="true">&uarr;</span></a>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-004">
          <summary><span class="jcs-entry__num">004</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Qué pasa si aprietas una semilla?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">En curso</span></span></summary>
          <div class="jcs-entry__body">
            <figure class="jcs-entry__media jcs-entry__media--wide">
              <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-exploracion-aceite-cuchara.png?v=1793755044&width=1200" loading="lazy" alt="Una cuchara con aceite de sacha inchi">
            </figure>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Apretamos una semilla. Salió aceite. Los humanos llevan siglos haciendo esto con otras semillas. Con esta, casi nunca.</p><footer>Dato · robot azul</footer></blockquote>
              <div class="jcs-log-check"><h3>Lo que comprobamos</h3><p>{{ 'junglcore_explorations.oil_research.composition' | t }}</p><p class="jcs-log-small">{{ 'junglcore_explorations.oil_research.composition_ref' | t }}</p></div>
              <p class="jcs-log-open"><span>Sigue abierto</span>{{ 'junglcore_explorations.oil_research.open_copy' | t }}</p>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-003">
          <summary><span class="jcs-entry__num">003</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Qué hay entre el antojo y la mano?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">Abierto</span></span></summary>
          <div class="jcs-entry__body">
            <figure class="jcs-entry__media">
              <img src="{{ 'jc-noche-v2.jpg' | asset_url }}" width="768" height="1376" loading="lazy" style="object-position: center 40%" alt="Una mujer de noche junto a la ventana, con una taza caliente entre las manos, un plato vacío y el celular boca abajo en la mesa">
            </figure>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>A media tarde, a un humano se le antoja algo dulce. No tiene hambre. Tiene un mal día, una reunión que salió mal, un mensaje sin contestar. Abre las galletas para comerse una. Cierra el paquete vacío. Entre el antojo y la mano no hay espacio.</p><footer>Lupa · robot rojo</footer></blockquote>
              <p class="jcs-log-open"><span>Sigue abierto</span>Con esta nota empezamos a mirar la saciedad.</p>
              <a class="jcs-link" href="#jc-pausa">Ver lo que encontramos <span aria-hidden="true">&uarr;</span></a>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-002">
          <summary><span class="jcs-entry__num">002</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Qué es la sacha inchi?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">En curso</span></span></summary>
          <div class="jcs-entry__body">
            <figure class="jcs-entry__media jcs-entry__media--wide">
              <img src="{{ 'jc-sacha-inchi-enredadera.jpg' | asset_url }}" width="896" height="1200" loading="lazy" alt="Una enredadera de sacha inchi con hojas en forma de corazón y frutos de cuatro puntas">
              <figcaption>Planta 001 · Sacha inchi</figcaption>
            </figure>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Encontré una planta con frutos en forma de estrella. Cuatro puntas, una semilla en cada una. Aquí la llaman sacha inchi. Fuera de Colombia casi nadie la conoce. Por fin, un pedazo de jungla.</p><footer>Chispa · robot verde</footer></blockquote>
              <div class="jcs-log-check"><h3>Lo que comprobamos</h3><p>{{ 'jc_story.growers' | t }}</p><p>{{ 'jc_story.relationships' | t }}</p></div>
              <p class="jcs-log-open"><span>Sigue abierto</span>{{ 'jc_story.pilot' | t }}</p>
            </div>
          </div>
        </details>

        <details class="jcs-entry" id="jc-log-001">
          <summary><span class="jcs-entry__num">001</span><span class="jcs-entry__main"><span class="jcs-entry__title">¿Por qué siempre las mismas plantas en el pasillo?</span></span><span class="jcs-entry__tags"><span class="jcs-entry__status">Comprobado</span></span></summary>
          <div class="jcs-entry__body">
            <figure class="jcs-entry__media">
              <img src="{{ 'jc-suelo-pasillo.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 78%" alt="Lupa, Chispa y Dato en el pasillo de bebidas vegetales de un supermercado; Dato lee la letra pequeña de una caja mientras una mujer pasa con su carrito sin mirarlos">
              <figcaption>Pasillo de bebidas vegetales · Bogotá</figcaption>
            </figure>
            <div class="jcs-entry__text">
              <blockquote class="jcs-log-note"><p>Los humanos tienen miles de plantas que se pueden comer. En el pasillo de las bebidas vegetales encontré cinco: almendra, avena, soya, arroz y coco. En Bogotá, Nueva York, Londres y Dubái, las mismas cinco. Informe enviado. Nadie respondió.</p><footer>Dato · robot azul</footer></blockquote>
              <div class="jcs-log-check">
            <h3>Lo que comprobamos</h3>
            <ul>
              <li><strong>Almendras por vaso.</strong> Lupa contó tres. Revisamos: unas cuatro. La única etiqueta que declara el porcentaje trae un 2,75 % de almendras, unos 5,5 g por vaso de 200 ml. Corregido. Sigue siendo poco. <a href="https://www.aecoctrade.es/es/producto/ksafuXFUolgkFCUMeJ9p77" target="_blank" rel="noopener noreferrer">Fuente &rarr;</a></li>
              <li><strong>Azúcar que nadie añadió.</strong> La de avena dice «sin azúcar añadida» y trae 7,5 g de azúcares por vaso. Sale de la propia avena al procesarla. <a href="https://www.recetasnestle.com.co/natures-heart/productos/healthy-beverages/natures-heart-bebida-avena-se-12x946ml-co" target="_blank" rel="noopener noreferrer">Fuente &rarr;</a></li>
              <li><strong>Ingredientes.</strong> Una bebida de almendras: trece. NUBE: tres. <a href="https://d1tiendas.vtexassets.com/arquivos/ids/201817-1200-1200?aspect=true&amp;height=1200&amp;width=1200" target="_blank" rel="noopener noreferrer">Fuente &rarr;</a></li>
              <li><strong>Proteína por vaso.</strong> Bebida de almendra: 1,0 g. NUBE: 6,3 g. <a href="https://d1tiendas.vtexassets.com/arquivos/ids/201818-1200-1200?aspect=true&amp;height=1200&amp;width=1200" target="_blank" rel="noopener noreferrer">Fuente &rarr;</a></li>
            </ul>
            <a class="jcs-link" href="{{ routes.root_url }}products/nube#jc-nutrition">La comparación completa, con precios <span aria-hidden="true">&rarr;</span></a>
          </div>
              <p class="jcs-log-open"><span>Sigue abierto</span>Por qué son siempre las mismas cinco. Nadie nos lo ha sabido explicar.</p>
            </div>
          </div>
        </details>

      </div>
    </div>
  </section>

  {%- comment -%} 5 · Follow what we find. {%- endcomment -%}
  <section class="jcs-lab-follow" aria-labelledby="jc-follow-title">
    <div class="jcs-frame">
      <h2 class="jcs-lab-follow__line" id="jc-follow-title">Sigue lo que vamos encontrando.</h2>
      <p class="jcs-lab-follow__small">Lo que nos cuenta el grupo, lo que anotan los robots y la próxima planta. Primero aquí.</p>
      <div class="jcs-lab-follow__actions">
        <a class="jcs-btn jcs-btn--light" href="{{ ig }}" target="_blank" rel="noopener"><span>Síguelos en Instagram</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
        {% form 'customer', id: 'jcs-lab-follow-form', class: 'jcs-lab-follow__form' %}
          {% if form.posted_successfully? %}
            <p class="jcs-lab-follow__ok">Listo. Te escribimos cuando haya algo que contar.</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter,lab">
            <label class="visually-hidden" for="jcs-lab-follow-email">Tu correo</label>
            <div class="jcs-wait__row jcs-lab-follow__row">
              <input type="email" id="jcs-lab-follow-email" name="contact[email]" placeholder="tu@correo.com" autocomplete="email" required>
              <button type="submit">Por correo</button>
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </section>

  {%- comment -%} 6 · The punchline, then NUBE in one line. {%- endcomment -%}
  <section class="jcs-lab-end" id="jc-nube" aria-labelledby="jc-lab-end-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>Cierre</span>Conclusión provisional · Firmado: L · C · D</p>
      <h2 class="jcs-display" id="jc-lab-end-title">La jungla no se perdió. Se dejó de mirar.</h2>
      <p class="jcs-lead jcs-lab-end__lead">Guardar semillas en una bóveda sirve de poco si nadie las usa. Una planta se cuida cuando se usa.</p>
      {% if v and v.price > 0 %}
      <div class="jcs-lab-strip">
        <div class="jcs-lab-strip__top">
          {% if nube.featured_image %}<img src="{{ nube.featured_image | image_url: width: 240 }}" width="120" height="120" loading="lazy" alt="Bolsa JUNGLCORE NUBE">{% endif %}
          <div class="jcs-lab-strip__info"><strong>NUBE · {{ v.price | money_without_trailing_zeros }}</strong><span>Lo que salió de la bitácora, por ahora. 30 vasos por bolsa · solo Bogotá.{% if settings.jc_sale_mode != 'a_la_venta' %} Primera tanda: {{ settings.jc_launch_label | default: '20 de noviembre' }}.{% endif %}</span></div>
        </div>
        {% if settings.jc_sale_mode != 'a_la_venta' %}
          <a class="jcs-btn" href="{{ routes.root_url }}products/nube#jc-buy"><span>Primera tanda · {{ settings.jc_launch_label | default: '20 de noviembre' }}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
        {% else %}
        {% form 'product', nube, id: 'jcs-lab-strip-form', class: 'jcs-lab-strip__form' %}
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="/checkout">
          <button type="submit" class="jcs-btn" {% unless v.available %}disabled{% endunless %}>{% if v.available %}<span>Comprar</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span>{% else %}<span>Agotada</span>{% endif %}</button>
        {% endform %}
        {% endif %}
        <a class="jcs-link" href="{{ routes.root_url }}products/nube">Ver NUBE <span aria-hidden="true">&rarr;</span></a>
      </div>
      {% endif %}
      <div class="jcs-lab-small">
        <p class="jcs-lab-inst">Planta 001: sacha inchi, cultivada con ASIN, la Asociación de Sachaincheros del Nororiente Colombiano. <a href="{{ routes.root_url }}pages/nosotros">Conoce a quienes la cultivan &rarr;</a></p>
        <p class="jcs-lab-inst">¿ONG, universidad, institución? Las plantas olvidadas y la saciedad son preguntas grandes. <a href="{{ wa }}{{ 'Hola, les escribo desde una organización sobre JUNGLCORE LAB:' | url_encode }}" target="_blank" rel="noopener">Escríbenos &rarr;</a></p>
      </div>
    </div>
  </section>

  {% render 'jc-footer' %}
</div>
<script>
  (function () {
    function openFromHash() {
      var id = location.hash.slice(1); if (!id) return;
      var el = document.getElementById(id);
      if (el && el.tagName === 'DETAILS') { el.open = true; el.scrollIntoView({ block: 'start' }); }
    }
    openFromHash(); window.addEventListener('hashchange', openFromHash);
  })();
</script>

{% schema %}
{
  "name": "JUNGLCORE LAB",
  "tag": "section",
  "class": "jc-exploraciones-section",
  "settings": [
    { "type": "header", "content": "Última entrada" },
    { "type": "video", "id": "latest_video", "label": "Vídeo", "info": "Opcional. Sin vídeo, se muestra la película de entrada: Vinieron buscando la jungla." },
    { "type": "text", "id": "latest_number", "label": "Número de entrada", "default": "000" },
    { "type": "text", "id": "latest_title", "label": "Título", "default": "Vinieron buscando la jungla" },
    { "type": "textarea", "id": "latest_line", "label": "Frase del robot", "default": "Cuatro mil días de viaje… para esto." }
  ],
  "presets": [{ "name": "JUNGLCORE LAB" }]
}
{% endschema %}
