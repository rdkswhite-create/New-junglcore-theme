#jc-exp-top .jc-editorial__copy{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:32px 0}
#jc-exp-top .jc-editorial__meta{display:flex;justify-content:space-between;gap:18px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;line-height:1.6;letter-spacing:.035em;color:#5b6058;margin-bottom:36px}
#jc-exp-top .jc-editorial__meta span:last-child{white-space:nowrap}
#jc-exp-top .jc-editorial__copy h2{font-family:inherit;font-size:clamp(34px,3.7vw,56px);font-weight:500;line-height:1.09;letter-spacing:-.035em;text-wrap:balance;color:#20231f;margin:0 0 28px;max-width:20ch}
#jc-exp-top .jc-editorial__description{max-width:49ch}
#jc-exp-top .jc-editorial__description p{font-size:clamp(17px,1.35vw,20px);line-height:1.65;color:#50564e;margin:0 0 16px}
#jc-exp-top .jc-editorial__description p:last-child{margin-bottom:0}
#jc-exp-top #jc-exp-001,#jc-exp-top #jc-exp-002{background:var(--jc-paper);margin-bottom:88px}
#jc-exp-top .jc-exp__chapter-products{display:flex;align-items:center;gap:16px 28px;padding-top:24px}
