.jc-exp__cinema-content{padding:24px 20px}
.jc-exp__scene-meta{font-size:8px;letter-spacing:.07em}
.jc-exp__scene-title{max-width:100%;font-size:clamp(46px,12vw,78px);margin:auto 0 22px}
.jc-exp__scene-caption{font-size:8px;letter-spacing:.1em}
.jc-exp__chapter-detail{grid-template-columns:1fr;gap:28px;padding-block:45px 60px}
.jc-exp__chapter-number{font-size:65px}
.jc-exp__chapter-detail .jc-exp__study-copy h2{font-size:10px;margin-bottom:20px}
.jc-exp__chapter-detail .jc-exp__study-copy h3{font-size:29px}
.jc-exp__botanical{padding-top:22px;padding-bottom:35px}
.jc-exp__botanical-grid{grid-template-columns:1fr;gap:28px;padding-top:35px}
.jc-exp__botanical-title{font-size:clamp(35px,10vw,55px)}
.jc-exp__botanical figcaption{font-size:8px}
.jc-exp__oil-object{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:12px}
.jc-exp__oil-object>img{width:150px;grid-column:2;grid-row:1/3;margin:0;justify-self:end}
.jc-exp__oil-object>a{grid-column:1;font-size:8px;align-self:start;justify-self:start}
.jc-exp__outro{margin-top:35px;padding-top:35px}
}

.jc-exp__oil-detail h2,.jc-exp__oil-detail h3{color:inherit}
.jc-exp__research{margin-top:38px}
.jc-exp__research h4{font-size:18px;font-weight:500;line-height:1.4;margin:30px 0 14px}
.jc-exp__research>p{max-width:600px;font-size:15px;line-height:1.7;color:#545750;margin:0 0 25px}
.jc-exp__paper summary{font-size:14px;letter-spacing:.02em;padding-block:22px}
.jc-exp__paper .jc-exp__paper-type{font-size:10px;letter-spacing:.07em}
.jc-exp__paper .jc-exp__paper-ref{font-size:12px;margin-top:24px}
.jc-exp__study-copy .jc-exp__research-note{font-size:13px;line-height:1.7;color:#63655f}
.jc-exp__paper-link{display:inline-block;font-size:13px;border-bottom:1px solid currentColor;padding-bottom:5px}
.jc-exp .jc-exp__scene-meta{font-size:14px;font-weight:550;letter-spacing:.08em;flex-wrap:wrap;row-gap:8px}
.jc-exp .jc-exp__index a{font-size:14px;font-weight:550;letter-spacing:.05em;line-height:1.5}
.jc-exp .jc-exp__index a>span:first-child{color:#555951}
.jc-exp .jc-exp__chapter-detail .jc-exp__study-copy h2{font-size:14px;font-weight:600;letter-spacing:.1em}
.jc-exp .jc-exp__oil-detail .jc-exp__research>p,.jc-exp .jc-exp__oil-detail .jc-exp__research-note{color:#c5c9bf}
.jc-exp .jc-exp__oil-detail .jc-exp__research h4{color:inherit}
@media(max-width:749px){
.jc-exp .jc-exp__scene-meta,.jc-exp .jc-exp__index a,.jc-exp .jc-exp__chapter-detail .jc-exp__study-copy h2{font-size:12px;letter-spacing:.045em}
.jc-exp .jc-exp__index a{gap:12px}
.jc-exp .jc-exp__index a>span{flex-shrink:0}
}
{% endstyle %}
