{% style %}
/* A shared desktop canvas for the introduction, investigations and footer. */
@media (min-width: 990px) {
  #jc-exp-top { --jc-exp-desktop-width: min(calc(100% - clamp(72px, 7vw, 144px)), 1760px); }
  #jc-exp-top .jc-exp__main > .jc-exp__frame,
  #jc-exp-top .jc-exp__main > .jc-exp__chapter,
  #jc-exp-top .jc-exp__footer > .jc-exp__frame {
    width: var(--jc-exp-desktop-width);
    margin-inline: auto;
  }
  #jc-exp-top .jc-exp__opening-bottom {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
  }
  #jc-exp-top .jc-exp__opening-bottom > p { max-width: 56ch; }
  #jc-exp-top .jc-exp__cinema {
    width: 100%;
    height: clamp(460px, 43vw, 720px);
    min-height: 460px;
    max-height: none;
  }
  #jc-exp-top .jc-exp__cinema-content { padding: 36px 40px 40px; }
  #jc-exp-top #jc-exp-002 .jc-exp__botanical { width: 100%; }
  #jc-exp-top #jc-exp-002 .jc-exp__botanical-grid {
    gap: clamp(40px, 5vw, 80px);
  }
  #jc-exp-top #jc-exp-001 .jc-exp__chapter-lead {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
  }
  #jc-exp-top #jc-exp-001 .jc-exp__chapter-lead p { margin: 0; max-width: 56ch; }
  #jc-exp-top .jc-exp__research-content { padding: 12px 40px 32px; }
  #jc-exp-top .jc-exp__research-panel > summary { padding-inline: 40px; }
  #jc-exp-top .jc-exp__research-row {
    grid-template-columns: minmax(180px, 22%) minmax(0, 1fr);
    gap: clamp(30px, 4vw, 64px);
  }
}
{% endstyle %}


{% style %}
/* One editorial template for every investigation. */
#jc-exp-top .jc-editorial{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(36px,5vw,80px);align-items:stretch;margin-bottom:28px}
#jc-exp-top .jc-editorial__image{margin:0;aspect-ratio:1/1;overflow:hidden;background:#eeefeb}
#jc-exp-top .jc-editorial__image img{display:block;width:100%;height:100%;object-fit:cover}
#jc-exp-top .jc-editorial__image--satiety img{object-position:76% 50%}
