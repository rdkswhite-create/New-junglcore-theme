 #jc-exp-top .jc-editorial{grid-template-columns:minmax(0,1fr);gap:0;margin-bottom:24px}
 #jc-exp-top .jc-editorial__image{aspect-ratio:4/3}
 #jc-exp-top .jc-editorial__copy{padding:28px 0 8px}
 #jc-exp-top .jc-editorial__meta{margin-bottom:24px;font-size:11px}
 #jc-exp-top .jc-editorial__copy h2{font-size:clamp(30px,6.5vw,48px);max-width:22ch;margin-bottom:22px}
 #jc-exp-top .jc-editorial__description{max-width:60ch}
