{{ 'jc-nube-v2.css' | asset_url | stylesheet_tag }}
{{ 'jc-shop.css' | asset_url | stylesheet_tag }}
<div class="jcs" id="top">
  {% render 'jc-header', buy_href: '#jc-buy' %}

  <section class="jcs-shop" id="jc-buy" aria-labelledby="jc-product-title">
    <div class="jcs-frame">
      <nav class="jcs-crumb" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a> / NUBE</nav>
      <div class="jcs-shop__grid">
        <div>
          {%- liquid
            assign v = product.selected_or_first_available_variant
            assign per_glass = v.price | divided_by: 30
          -%}
          <div class="jcs-gal" id="jcs-gal">
            <div class="jcs-gal__track" tabindex="0" aria-label="Fotos de NUBE">
              <figure class="jcs-gal__slide jcs-gal__slide--pack"><img src="{{ 'jc-nube-bolsa-panel.jpg' | asset_url }}" width="1254" height="1254" loading="eager" fetchpriority="high" alt="Bolsa JUNGLCORE NUBE: 30 barras congeladas de sacha inchi, 600 g"><figcaption>30 barras · 600 g · 30 vasos.</figcaption></figure>
              <figure class="jcs-gal__slide jcs-gal__slide--video"><video src="{{ 'jc-preparacion.mp4' | asset_url }}" poster="{{ 'jc-preparacion-poster.jpg' | asset_url }}" width="1280" height="720" muted loop playsinline preload="metadata" aria-label="Una barra de NUBE entra en la licuadora, se le agrega agua, se licúa y se sirve en un vaso"></video><figcaption>Así se prepara.</figcaption></figure>
              <figure class="jcs-gal__slide jcs-gal__slide--pack"><img src="{{ 'jc-nube-bolsa-reverso.jpg' | asset_url }}" width="1024" height="1536" loading="lazy" alt="El reverso de la bolsa de NUBE: preparación, información nutricional e ingredientes"><figcaption>El reverso</figcaption></figure>
              <figure class="jcs-gal__slide"><img src="{{ 'jc-nube-barra-licuadora.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 48%" alt="Una mujer deja caer una barra congelada de NUBE en la licuadora con agua; la bolsa está sobre la mesa"><figcaption>Una barra, agua.</figcaption></figure>
              <figure class="jcs-gal__slide"><img src="{{ 'jc-paso-licuadora.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 48%" alt="Una mujer deja caer una barra de NUBE en la licuadora con agua, junto a la ventana"><figcaption>Licúa 30 segundos.</figcaption></figure>
              <figure class="jcs-gal__slide"><img src="{{ 'jc-nube-vaso.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 55%" alt="Un vaso alto de bebida de NUBE recién servida junto a la ventana, con la mano de una mujer al lado"><figcaption>6,2 g de proteína por vaso.</figcaption></figure>
              <figure class="jcs-gal__slide"><img src="{{ 'jc-nube-congelador.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 42%" alt="Una mano saca una barra de NUBE de la bolsa en la puerta del congelador"><figcaption>Del congelador, una a una.</figcaption></figure>
              <figure class="jcs-gal__slide"><img src="{{ 'jc-nube-taza.jpg' | asset_url }}" width="941" height="1672" loading="lazy" style="object-position: center 50%" alt="Dos manos sostienen una taza de agua caliente donde se deshace una barra de NUBE"><figcaption>De noche, en agua caliente.</figcaption></figure>
            </div>
            <div class="jcs-gal__dots" role="tablist" aria-label="Elegir foto">
              {%- for i in (1..8) -%}<button type="button" class="jcs-gal__dot{% if i == 1 %} is-active{% endif %}" aria-label="Foto {{ i }}"></button>{%- endfor -%}
            </div>
          </div>
          <script>
            (function () {
              var g = document.getElementById('jcs-gal'); if (!g) return;
              var t = g.querySelector('.jcs-gal__track'), dots = g.querySelectorAll('.jcs-gal__dot'), vid = g.querySelector('video');
              dots.forEach(function (d, i) { d.addEventListener('click', function () { t.scrollTo({ left: i * t.clientWidth, behavior: 'smooth' }); }); });
              var raf; t.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(function () {
                var i = Math.round(t.scrollLeft / t.clientWidth); dots.forEach(function (d, j) { d.classList.toggle('is-active', i === j); }); if (vid) { if (i === 1) { var pr = vid.play(); if (pr && pr.catch) pr.catch(function () {}); } else { vid.pause(); } } }); }, { passive: true });
            })();
          </script>
        </div>
        <div>
          <div class="jcs-nube jcs-nube--pdp">
            <p class="jcs-eyebrow">Bebida vegetal de origen</p>
            <h1 class="jcs-product-title" id="jc-product-title">NUBE</h1>
            <p class="jcs-nube__what">Base congelada de sacha inchi para preparar tu bebida vegetal en casa.</p>
            <ul class="jcs-facts">
              <li><strong>6,2 g</strong><span>Proteína</span></li>
              <li><strong>1,4 g</strong><span>Fibra</span></li>
              <li><strong>3</strong><span>Ingredientes</span></li>
            </ul>
            <p class="jcs-nube__ingr"><strong>30 barras · 600 g.</strong> Una barra, agua y 30 segundos de licuadora: un vaso. Una bolsa reemplaza hasta 6 cajas de bebida vegetal.</p>
            {%- if v and v.price > 0 -%}
            <div class="jcs-nube__price"><p><strong>{{ per_glass | money_without_trailing_zeros }}</strong> <span>el vaso</span></p><span class="jcs-nube__when">{% if settings.jc_sale_mode == 'a_la_venta' %}2 bolsas, envío incluido{% else %}Lote 001 · {{ settings.jc_launch_label | default: 'diciembre' }}{% endif %}</span></div>
            {%- endif -%}
          </div>
          <div style="margin-top:28px">{% render 'jc-buy-box', product: product, form_id: 'jcs-product-buy', show_title: false, calm: true %}</div>
        </div>
      </div>
    </div>
  </section>

  {% render 'jc-nube-about', number: '01' %}

  {% render 'jc-texture', number: '02' %}

  {% render 'jc-ingredients', number: '03' %}

  {% render 'jc-nutrition-label', number: '04' %}

  {% render 'jc-noes', number: '05', short: true %}

  {% render 'jc-provenance', number: '06' %}

  {% render 'jc-full-comparison', number: '07' %}

  {% render 'jc-moments', number: '08' %}

  <section class="jcs-uses" aria-labelledby="jc-uses-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>09</span>Formas de tomarla</p>
      <div class="jcs-versus__head">
        <h2 class="jcs-title" id="jc-uses-title">En el vaso. En la avena. En el batido.</h2>
        <p class="jcs-lead">Es una bebida, no un experimento. Si la pones en el café, eso ya es cosa tuya.</p>
      </div>
      <div class="jcs-uses__grid">
        <figure><img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/IMG_6557.jpg?v=1793784459&width=900" width="928" height="1152" loading="lazy" alt="Una mujer vierte NUBE sobre la avena"><figcaption>Con tu avena.</figcaption></figure>
        <figure><img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/IMG_6560.jpg?v=1793784885&width=900" width="928" height="1152" loading="lazy" alt="Un hombre con un batido después de correr"><figcaption>En tu batido.</figcaption></figure>
        <figure><img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/IMG_6559.jpg?v=1793784540&width=900" width="928" height="1152" loading="lazy" alt="Una mujer lee el periódico junto a un vaso de NUBE"><figcaption>Un vaso con el desayuno.</figcaption></figure>
      </div>
    </div>
  </section>


  {% render 'jc-faq', number: '10' %}

  <section class="jcs-final" aria-labelledby="jc-final-title">
    <div class="jcs-frame">
      <h2 id="jc-final-title">Rinde más.</h2>
      <p>30 vasos por bolsa. Dos bolsas y el envío corre por nuestra cuenta.</p>
      <a class="jcs-btn jcs-btn--light" href="#jc-buy"><span>{% if settings.jc_sale_mode == 'a_la_venta' %}Pide tu bolsa{% else %}Avísame · Lote 001{% endif %}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  {% render 'jc-footer' %}
  {% render 'jc-sticky-buy', product: product, always: true %}
</div>

{% schema %}
{
  "name": "JUNGLCORE producto",
  "tag": "div",
  "settings": []
}
{% endschema %}
