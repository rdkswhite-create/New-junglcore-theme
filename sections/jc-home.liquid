          <a class="jcs-invest__item jcs-invest__box" href="{{ routes.root_url }}pages/exploraciones#jc-pausa">
            <span class="jcs-invest__n">01 · Saciedad</span>
            <span class="jcs-invest__q">¿Puede una semilla bajarle el volumen?</span>
