{{ 'jc-shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign nube = section.settings.nube_product
  if nube == blank
    assign nube = all_products['nube']
  endif
  assign v = nube.selected_or_first_available_variant
-%}
<div class="jcs" id="top">
  {% render 'jc-header', buy_href: '#jc-buy' %}

  <section class="jcs-hero" aria-labelledby="jc-hero-title">
    <div class="jcs-hero__media">
      {% if section.settings.hero_video != blank %}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {% else %}
        <video src="{{ 'jc-hero-loop.mp4' | asset_url }}" poster="{{ 'jc-hero-loop-poster.jpg' | asset_url }}" autoplay muted loop playsinline preload="auto" aria-label="Una barra de NUBE cae en la licuadora con agua, se licúa y se sirve"></video>
      {% endif %}
    </div>
    <div class="jcs-hero__shade" aria-hidden="true"></div>
    <div class="jcs-hero__top"><span>Bebida vegetal de origen · Colombia</span></div>
    <div class="jcs-hero__body">
      <h1 class="jcs-hero__title" id="jc-hero-title">¿Quién dijo que una bebida vegetal tiene que venir en caja?</h1>
      <p class="jcs-hero__answer">Esta vive en tu congelador.</p>
      <p class="jcs-hero__why">Congelada, porque no lleva nada que la haga durar.</p>
      <div class="jcs-hero__actions">
        <a class="jcs-btn jcs-btn--light" href="#jc-buy"><span>{% if settings.jc_sale_mode == 'a_la_venta' %}Pide tu bolsa{% else %}Avísame · Lote 001{% endif %}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
        <a class="jcs-link" href="#jc-preparar">Cómo se prepara</a>
      </div>
      {%- if v and v.price > 0 -%}{%- assign hero_pg = v.price | divided_by: 30 -%}
      <p class="jcs-hero__price">{{ hero_pg | money_without_trailing_zeros }} el vaso · 1 bolsa = hasta 6 cajas de 1 litro</p>
      {%- endif -%}
    </div>
    <div class="jcs-hero__bottom">
      <img class="jcs-hero__wordmark" src="{{ 'jc-wordmark-refined-white.svg' | asset_url }}" alt="JUNGLCORE" width="953" height="96">
    </div>
  </section>

  <div class="jcs-steps-band" id="jc-preparar">
  <div class="jcs-strip jcs-steps" aria-label="Del congelador al vaso">
    <figure class="jcs-strip__item"><span class="jcs-steps__t" data-count="0">0 s</span><img src="{{ 'jc-nube-congelador.jpg' | asset_url }}" width="941" height="1671" loading="eager" alt="Una mano saca una barra de la bolsa de NUBE en el congelador"><figcaption><strong>La barra</strong><span>Del congelador</span></figcaption></figure>
    <figure class="jcs-strip__item"><span class="jcs-steps__t" data-count="10">10 s</span><img src="{{ 'jc-paso-licuadora.jpg' | asset_url }}" width="941" height="1672" loading="eager" alt="Una barra de NUBE cae en la licuadora con agua"><figcaption><strong>Licúa</strong><span>30 segundos, con agua</span></figcaption></figure>
    <figure class="jcs-strip__item"><span class="jcs-steps__t" data-count="40">40 s</span><img src="{{ 'jc-nube-vaso.jpg' | asset_url }}" width="941" height="1672" loading="eager" alt="Un vaso de NUBE en una mesa de cocina con luz de mañana"><figcaption><strong>Listo</strong><span>Tu bebida vegetal</span><em class="jcs-steps__joke">30 segundos. La haces tú.</em></figcaption></figure>
  </div>
  </div>


  <script>
    (function () {
      var els = document.querySelectorAll('.jcs-steps__t[data-count]');
      if (!els.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      els.forEach(function (el) { if (+el.dataset.count > 0) el.textContent = '0 s'; });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return; io.unobserve(en.target);
          var el = en.target, to = +el.dataset.count, t0 = null, dur = 900 + to * 15;
          if (!to) return;
          function step(t) { if (!t0) t0 = t; var k = Math.min(1, (t - t0) / dur); el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3))) + ' s'; if (k < 1) requestAnimationFrame(step); }
          requestAnimationFrame(step);
        });
      }, { threshold: 0.6 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
  <section class="jcs-shop" id="{% if settings.jc_sale_mode == 'a_la_venta' %}jc-buy{% else %}jc-nube{% endif %}" aria-labelledby="jc-buy-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>01</span>NUBE · Lote 001</p>
      <div class="jcs-shop__grid">
        <div>
          <div class="jcs-hgal jcs-hgal--panel" id="jcs-hgal">
            <div class="jcs-shop__visual">
              <div class="jcs-hgal__track" tabindex="0" aria-label="NUBE: la bolsa y cómo se prepara">
                <figure class="jcs-hgal__slide">
                  {% if section.settings.nube_image != blank %}
                    {{ section.settings.nube_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Bolsa JUNGLCORE NUBE' }}
                  {% else %}
                    <img class="jcs-pack-photo" src="{{ 'jc-nube-bolsa-panel.jpg' | asset_url }}" width="1254" height="1254" loading="lazy" alt="Bolsa JUNGLCORE NUBE: 30 barras congeladas de sacha inchi">
                  {% endif %}
                </figure>
                <figure class="jcs-hgal__slide jcs-hgal__slide--video">
                  <video src="{{ 'jc-preparacion.mp4' | asset_url }}" poster="{{ 'jc-preparacion-poster.jpg' | asset_url }}" width="1280" height="720" muted loop playsinline preload="metadata" aria-label="Una barra de NUBE entra en la licuadora, se le agrega agua, se licúa y se sirve en un vaso"></video>
                </figure>
                <figure class="jcs-hgal__slide"><img src="{{ 'jc-nube-bolsa-reverso-panel.jpg' | asset_url }}" width="1254" height="1254" loading="lazy" alt="El reverso de la bolsa de NUBE: preparación, información nutricional, ingredientes y registro sanitario"></figure>
              </div>
            </div>
            <div class="jcs-hgal__thumbs" role="tablist" aria-label="Elegir">
              <button type="button" class="jcs-hgal__thumb is-active" aria-label="La bolsa"><img src="{{ 'jc-nube-bolsa-panel.jpg' | asset_url }}" width="1254" height="1254" loading="lazy" alt=""></button>
              <button type="button" class="jcs-hgal__thumb jcs-hgal__thumb--video" aria-label="Ver cómo se prepara"><img src="{{ 'jc-preparacion-poster.jpg' | asset_url }}" width="1280" height="720" loading="lazy" alt=""><span aria-hidden="true">&#9654;</span></button>
              <button type="button" class="jcs-hgal__thumb" aria-label="El reverso: tabla nutricional"><img src="{{ 'jc-nube-bolsa-reverso-panel.jpg' | asset_url }}" width="1254" height="1254" loading="lazy" alt=""></button>
            </div>
          </div>
          <script>
            (function () {
              var g = document.getElementById('jcs-hgal'); if (!g) return;
              var t = g.querySelector('.jcs-hgal__track'), th = g.querySelectorAll('.jcs-hgal__thumb'), v = g.querySelector('video');
              function show(i) { th.forEach(function (b, j) { b.classList.toggle('is-active', i === j); }); if (v) { if (i === 1) { var p = v.play(); if (p && p.catch) p.catch(function () {}); } else { v.pause(); } } }
              th.forEach(function (b, i) { b.addEventListener('click', function () { t.scrollTo({ left: i * t.clientWidth, behavior: 'smooth' }); }); });
              var raf; t.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(function () { show(Math.round(t.scrollLeft / t.clientWidth)); }); }, { passive: true });
            })();
          </script>
        </div>
        <div>
          {% if settings.jc_sale_mode == 'a_la_venta' %}
            <h2 class="visually-hidden" id="jc-buy-title">Comprar NUBE</h2>
            {% if nube != blank %}{% render 'jc-buy-box', product: nube, form_id: 'jcs-home-buy', show_title: true %}{% endif %}
          {% else %}
            {%- assign nv = nube.selected_or_first_available_variant -%}
            <div class="jcs-nube">
              <h2 class="jcs-nube__title" id="jc-buy-title"><span>Tu bebida vegetal.</span> <span>El agua la pones tú.</span></h2>
              <ul class="jcs-facts">
                <li><strong>6,2 g</strong><span>Proteína por vaso</span></li>
                <li><strong>1,4 g</strong><span>Fibra por vaso</span></li>
                <li><strong>3</strong><span>Ingredientes</span></li>
              </ul>
              <p class="jcs-nube__ingr"><strong>Sacha inchi, agua y goma gelana.</strong> Sin azúcares añadidos. Los contamos con una mano y nos sobraron dos dedos.</p>
              {%- if nv and nv.price > 0 -%}{%- assign npg = nv.price | divided_by: 30 -%}
              <div class="jcs-nube__price"><p><strong>{{ npg | money_without_trailing_zeros }}</strong> <span>el vaso</span></p></div>
              {%- endif -%}
              <p class="jcs-nube__litros"><strong>1 bolsa = hasta 6 cajas de 1 litro de bebida vegetal.</strong></p>
              <p class="jcs-nube__when jcs-nube__when--line">Lote 001 llega en {{ settings.jc_launch_label | default: 'diciembre' }}</p>
              <a class="jcs-btn jcs-btn--line jcs-btn--full jcs-nube__go" href="{{ routes.root_url }}products/nube"><span>Conoce NUBE</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
              <div class="jcs-nube__cuentas">
                <p class="jcs-nube__cuentas-t">Hicimos las cuentas</p>
                <p class="jcs-nube__cuentas-s">Por vaso de 200 ml</p>
                {% render 'jc-versus', rows_only: true %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="jcs-mine" aria-labelledby="jc-mine-title">
    <div class="jcs-frame">
      <h2 class="jcs-title" id="jc-mine-title">Elige tu NUBE.</h2>
      <p class="jcs-lead">Tú eliges la textura y cuántas barras preparar. Prepara lo que vas a tomar y conserva las demás congeladas.</p>
      <div class="jcs-mine__row">
        <a class="jcs-mine__opt" href="{{ routes.root_url }}products/nube#jc-textura"><strong>150 ml.</strong><span>1 barra + 150 ml de agua. Con más cuerpo, como una bebida vegetal.</span></a>
        <a class="jcs-mine__opt" href="{{ routes.root_url }}products/nube#jc-textura"><strong>200 ml.</strong><span>1 barra + 200 ml de agua. Más ligera, más refrescante.</span></a>
      </div>
      <p class="jcs-mine__note">Nota a avena tostada, final a nuez.</p>
    </div>
  </section>

  {% render 'jc-moments', number: '02', morning_image: section.settings.morning_image, night_image: section.settings.night_image %}

  {% render 'jc-noes', number: '03' %}


  <section class="jcs-origin-block" id="jc-origen" aria-labelledby="jc-origin-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>04</span>Tu bebida tiene origen</p>
      <div class="jcs-origin-block__grid">
        <figure><img src="{{ 'jc-emilio-asin.jpg' | asset_url }}" width="1280" height="854" loading="lazy" alt="Emilio, agricultor de sacha inchi en Santander, con frutos secos de cuatro puntas en las manos"><figcaption>Emilio · Agricultor de sacha inchi · Santander</figcaption></figure>
        <div class="jcs-origin-block__copy">
          <h2 class="jcs-title" id="jc-origin-title">Le preguntas al barista de dónde viene el café.<br>¿Y la bebida vegetal?</h2>
          <p class="jcs-lead"><strong>La nuestra tiene respuesta.</strong> Sacha inchi de Santander, Norte de Santander y Valle del Cauca.</p>
          <p class="jcs-lead">Ayudamos a crear la Asociación de Sachaincheros del Nororiente Colombiano. En la asociación, el agricultor sabe cuánto va a ganar antes de cosechar.</p>
          <p class="jcs-origin-block__lot"><strong>Cada lote dice de dónde viene.</strong> Lote 001: Santander.</p>
          <a class="jcs-link" href="{{ routes.root_url }}pages/nosotros#jc-about-002">Conoce su origen <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  {%- if nube != blank and settings.jc_sale_mode != 'a_la_venta' -%}
  <section class="jcs-listsec" id="jc-buy" aria-labelledby="jc-lista-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>05</span>La lista</p>
      <h2 class="visually-hidden" id="jc-lista-title">Apúntate a la lista del Lote 001</h2>
      <div class="jcs-listsec__box">
        <div class="jcs-pains" id="jc-pains">
          <h3 class="jcs-pains__title">¿Cuáles te pasan?</h3>
          <p class="jcs-pains__ask">Toca las tuyas.</p>
          <ul class="jcs-pains__list">
            <li><button type="button" aria-pressed="false" data-tag="dolor-etiqueta">Lees la etiqueta y no entiendes la mitad.</button></li>
            <li><button type="button" aria-pressed="false" data-tag="dolor-proteina">Buscas proteína y tu bebida vegetal casi no trae.</button></li>
            <li><button type="button" aria-pressed="false" data-tag="dolor-dulce">Todo lo «saludable» sabe a postre.</button></li>
            <li><button type="button" aria-pressed="false" data-tag="dolor-caja">Abres una caja y se te daña antes de terminarla.</button></li>
            <li><button type="button" aria-pressed="false" data-tag="dolor-noche">A las 11 p.&nbsp;m. abres la nevera buscando algo.</button></li>
          </ul>
          <p class="jcs-pains__result" aria-live="polite" hidden><strong><b>0</b> de 5. Para eso hicimos NUBE.</strong> <span>Y además, sabes de dónde viene.</span></p>
        </div>
        <script>
          (function () {
            var box = document.getElementById('jc-pains'); if (!box) return;
            var res = box.querySelector('.jcs-pains__result'), n = res.querySelector('b');
            box.querySelectorAll('button[data-tag]').forEach(function (b) {
              b.addEventListener('click', function () {
                b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
                var k = box.querySelectorAll('button[aria-pressed="true"]').length;
                n.textContent = k; res.hidden = k === 0;
              });
            });
          })();
        </script>
        {% render 'jc-waitlist', product: nube, form_id: 'jcs-home-list' %}
        {% render 'jc-delivery-check', id: 'jcs-home-list-check' %}
      </div>
    </div>
  </section>
  {%- endif -%}

  <section class="jcs-biz" aria-labelledby="jc-biz-title">
    <div class="jcs-frame jcs-biz__in">
      <h2 class="jcs-title" id="jc-biz-title">¿Tienes un café, restaurante u oficina?</h2>
      <p class="jcs-lead">Pruébala antes que nadie. Te llevamos NUBE y la preparamos contigo.</p>
      {%- if v and v.price > 0 -%}{%- assign biz_pg = v.price | divided_by: 30 -%}<p class="jcs-biz__price"><strong>{{ biz_pg | money_without_trailing_zeros }} por bebida.</strong> Sin cajas abiertas que se dañan.</p>{%- endif -%}
      <a class="jcs-btn" href="https://wa.me/573011571039?text={{ 'Hola, tengo un café / restaurante / oficina en Bogotá y quiero probar NUBE.' | url_encode }}" target="_blank" rel="noopener"><span>Escríbenos por WhatsApp</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  {% render 'jc-film', buy_href: '#jc-buy', desktop_video: section.settings.film_desktop %}





  <section class="jcs-manifesto jcs-manifesto--short" id="jc-manifesto" aria-labelledby="jc-manifesto-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>06</span>Por qué existimos</p>
      <div class="jcs-manifesto__cols">
      <div class="jcs-manifesto__wrap">
      <h2 class="jcs-display" id="jc-manifesto-title"><span>Miles de plantas que se pueden comer.</span> <span>En el supermercado, cinco.</span></h2>
      <p class="jcs-lead jcs-manifesto__lead">Las mismas en Bogotá, Londres y Dubái. Empezamos con una semilla colombiana que nadie estaba mirando, y la investigamos en abierto: <strong>¿puede una semilla bajarle al ruido de la comida?</strong></p>
      <p class="jcs-lead jcs-manifesto__lead">Lo que encontramos, lo que no, y quién pagó cada estudio. <strong>Comida primero.</strong></p>
      <a class="jcs-btn" href="{{ routes.root_url }}pages/exploraciones"><span>Ver el Lab</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
      </div>
      <figure class="jcs-manifesto__photo"><img src="{{ 'jc-planta-001.jpg' | asset_url }}" width="941" height="1176" loading="lazy" alt="Una mano de robot junto a una semilla de sacha inchi sobre una carpeta de archivo"></figure>
      </div>
    </div>
  </section>



  {%- if section.blocks.size > 0 -%}
  <section class="jcs-reviews" id="jc-resenas" aria-labelledby="jc-reviews-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>07</span>Lo que dijeron los humanos</p>
      <div class="jcs-reviews__head">
        <h2 class="jcs-title" id="jc-reviews-title">Lo que dijeron los humanos.</h2>
        <p class="jcs-lead">Personas reales, palabras reales. Los robots no se lo terminan de creer. Lo anotan igual.</p>
      </div>
      <div class="jcs-reviews__grid">
        {%- for block in section.blocks -%}
          <figure class="jcs-review" {{ block.shopify_attributes }}>
            <blockquote>«{{ block.settings.quote | escape }}»</blockquote>
            <figcaption><strong>{{ block.settings.name | escape }}</strong>{% if block.settings.place != blank %} · {{ block.settings.place | escape }}{% endif %}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- liquid
    assign faq_number = '07'
    if section.blocks.size > 0
      assign faq_number = '08'
    endif
  -%}
  {% render 'jc-faq', number: faq_number %}

  <section class="jcs-final" aria-labelledby="jc-final-title">
    <div class="jcs-frame">
      <h2 id="jc-final-title">Rinde más.</h2>
      <p>De una semilla colombiana. 30 vasos por bolsa.</p>
      <a class="jcs-btn jcs-btn--light" href="#jc-buy"><span>{% if settings.jc_sale_mode == 'a_la_venta' %}Pide tu bolsa{% else %}Avísame · Lote 001{% endif %}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
      <p class="jcs-final__line">La jungla no se perdió. Se dejó de mirar.</p>
    </div>
  </section>

  {% render 'jc-footer', legal_name: section.settings.legal_name, legal_nit: section.settings.legal_nit, legal_address: section.settings.legal_address %}
  {% if nube != blank %}{% render 'jc-sticky-buy', product: nube %}{% endif %}
</div>

{% schema %}
{
  "name": "JUNGLCORE inicio",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "nube_product", "label": "Producto NUBE" },
    { "type": "video", "id": "hero_video", "label": "Vídeo de portada (opcional)" },
    { "type": "video", "id": "film_desktop", "label": "Película ¿Qué es NUBE?, versión horizontal para escritorio (opcional)" },
    { "type": "image_picker", "id": "nube_image", "label": "Imagen de la bolsa (opcional)" },
    { "type": "header", "content": "Dos momentos" },
    { "type": "image_picker", "id": "morning_image", "label": "Foto de la mañana" },
    { "type": "image_picker", "id": "night_image", "label": "Foto de la noche" },
    { "type": "header", "content": "Hallazgos" },
    { "type": "url", "id": "hallazgos_url", "label": "Enlace al último hallazgo (Instagram)" },
    { "type": "text", "id": "hallazgo_dia", "label": "Hallazgo del día (opcional)", "info": "Déjalo vacío y cambia solo cada día, entre siete hallazgos. Escribe uno aquí para fijarlo." },
    { "type": "header", "content": "Datos legales" },
    { "type": "text", "id": "legal_name", "label": "Razón social" },
    { "type": "text", "id": "legal_nit", "label": "NIT" },
    { "type": "text", "id": "legal_address", "label": "Dirección" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Lo que dijo, palabra por palabra" },
        { "type": "text", "id": "name", "label": "Nombre (con su permiso)" },
        { "type": "text", "id": "place", "label": "Barrio o ciudad" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "JUNGLCORE inicio" }]
}
{% endschema %}

