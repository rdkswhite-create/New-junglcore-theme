{{ 'jc-shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign nube = section.settings.nube_product
  if nube == blank
    assign nube = all_products['nube']
  endif
  assign v = nube.selected_or_first_available_variant
-%}
<div class="jcs" id="top">
  {% render 'jc-header', buy_href: '#jc-buy' %}

  <section class="jcs-hero" aria-labelledby="jc-hero-title">
    <div class="jcs-hero__media">
      {% if section.settings.hero_video != blank %}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {% else %}
        <picture>
          <source media="(max-width: 749px)" srcset="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-portrait-loop.webp?v=1793647878" type="image/webp">
          <img src="https://cdn.shopify.com/s/files/1/0837/7185/0809/files/junglcore-nube-landscape-loop.webp?v=1793647871" alt="Una barra de NUBE cae en la licuadora con agua" width="910" height="512" loading="eager" fetchpriority="high">
        </picture>
      {% endif %}
    </div>
    <div class="jcs-hero__shade" aria-hidden="true"></div>
    <div class="jcs-hero__top"><span>Colombia / Biodiversidad</span><span>6,3 g de proteína por vaso</span></div>
    <div class="jcs-hero__body">
      <h1 class="jcs-hero__title" id="jc-hero-title">¿Quién dijo que una bebida vegetal tiene que venir en caja?</h1>
      <p class="jcs-hero__sub">NUBE: una barra congelada que se vuelve bebida vegetal proteica.</p>
      <div class="jcs-hero__actions">
        <a class="jcs-btn jcs-btn--light" href="#jc-buy">{% if settings.jc_sale_mode != 'a_la_venta' %}<span>Apártame una bolsa · {{ settings.jc_launch_short | default: '20 nov' }}</span>{% else %}<span>Comprar · {% if v %}{{ v.price | money_without_trailing_zeros }}{% else %}$39.900{% endif %}</span>{% endif %}<span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
        <a class="jcs-link" href="#jc-film">Cómo se prepara</a>
      </div>
    </div>
    <div class="jcs-hero__bottom">
      <img class="jcs-hero__wordmark" src="{{ 'jc-wordmark-refined-white.svg' | asset_url }}" alt="junglcore" width="1329" height="313">
    </div>
  </section>

  <ul class="jcs-badges" aria-label="Lo que puedes confiar">
    {% if settings.jc_invima_number != blank %}<li><strong>Registro sanitario INVIMA</strong><span>{{ settings.jc_invima_number }}</span></li>{% endif %}
    <li><strong>Sin sellos de advertencia</strong><span>Ni uno en la etiqueta</span></li>
    <li><strong>Sin azúcar añadida</strong><span>0 g de azúcares por vaso</span></li>
    <li><strong>3 ingredientes</strong><span>De una semilla con 3.000 años de historia</span></li>
    <li><strong>Hecho en Colombia</strong><span>De la semilla a la barra, todo aquí</span></li>
    {% if settings.jc_backed_by != blank %}<li><strong>Con el apoyo de</strong><span>{{ settings.jc_backed_by }}</span></li>{% endif %}
  </ul>

  {% render 'jc-film', buy_href: '#jc-buy', desktop_video: section.settings.film_desktop %}

  <section class="jcs-foryou" aria-labelledby="jc-foryou-title">
    <div class="jcs-frame">
      <h2 class="jcs-title" id="jc-foryou-title">NUBE es para ti si…</h2>
      <ol class="jcs-foryou__cards">
        <li><span>01</span><p class="jcs-foryou__t">Abres la nevera a las 11 p. m. sin saber qué buscas.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}pages/exploraciones#jc-pausa">Lo que investigamos &rarr;</a></li>
        <li><span>02</span><p class="jcs-foryou__t">Te cobran carísimo por agua con un poquito de almendra.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">Ver el precio por vaso &rarr;</a></li>
        <li><span>03</span><p class="jcs-foryou__t">Dices «solo una» y el paquete se acaba.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}pages/exploraciones#jc-pausa">Lo que investigamos &rarr;</a></li>
        <li><span>04</span><p class="jcs-foryou__t">La proteína en polvo te cae pesada.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">Sin lácteos · Ver ingredientes &rarr;</a></li>
        <li><span>05</span><p class="jcs-foryou__t">Quieres proteína para tu día, no solo para el gimnasio.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">6,3 g por vaso · Ver la tabla &rarr;</a></li>
        <li><span>06</span><p class="jcs-foryou__t">Quieres una bebida vegetal con pocos ingredientes.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">3 ingredientes · Ver la etiqueta &rarr;</a></li>
        <li><span>07</span><p class="jcs-foryou__t">Quieres una proteína completa menos procesada.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">Ver la tabla &rarr;</a></li>
        <li><span>08</span><p class="jcs-foryou__t">Abres la bolsa o la caja y a la semana la botas.</p><a class="jcs-foryou__link" href="#jc-buy">Pagas solo los vasos que te tomas &rarr;</a></li>
        <li><span>09</span><p class="jcs-foryou__t">La leche te cae mal.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">Sin lácteos · Ver ingredientes &rarr;</a></li>
        <li><span>10</span><p class="jcs-foryou__t">Desayunas y a las dos horas ya tienes hambre.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}pages/exploraciones#jc-pausa">Lo que investigamos &rarr;</a></li>
        <li><span>11</span><p class="jcs-foryou__t">Ves un sello negro y lo devuelves de una.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">Sin sellos · Ver la etiqueta &rarr;</a></li>
        <li><span>12</span><p class="jcs-foryou__t">Tu batido de proteína trae una lista que no sabes leer.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">3 ingredientes · Ver la etiqueta &rarr;</a></li>
        <li><span>13</span><p class="jcs-foryou__t">Una bebida vegetal te sale más cara que la leche.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">Ver el precio por vaso &rarr;</a></li>
        <li><span>14</span><p class="jcs-foryou__t">Tu bebida de almendra trae 1 g de proteína por vaso.</p><a class="jcs-foryou__link" href="{{ routes.root_url }}products/nube#jc-nutrition">NUBE: 6,3 g · Ver la tabla &rarr;</a></li>
        <li><span>15</span><p class="jcs-foryou__t">Cargas cajas de bebida del súper hasta la casa.</p><a class="jcs-foryou__link" href="#jc-buy">Una bolsa, 30 vasos &rarr;</a></li>
      </ol>
      <div class="jcs-foryou__nav">
        <button type="button" class="jcs-foryou__btn" data-dir="-1" aria-label="Anterior">&larr;</button>
        <span class="jcs-foryou__count" aria-live="polite"><b>1</b> / <i>7</i></span>
        <button type="button" class="jcs-foryou__btn" data-dir="1" aria-label="Siguiente">&rarr;</button>
      </div>
      <script>
        (function () {
          var track = document.querySelector('.jcs-foryou__cards');
          var nav = document.querySelector('.jcs-foryou__nav');
          if (!track || !nav) return;
          var cards = track.children, count = nav.querySelector('b');
          nav.querySelector('i').textContent = cards.length;
          function step() { return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
          nav.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-dir]'); if (!btn) return;
            track.scrollBy({ left: step() * Number(btn.dataset.dir), behavior: 'smooth' });
          });
          track.addEventListener('scroll', function () {
            var i = Math.round(track.scrollLeft / step()) + 1;
            count.textContent = Math.min(Math.max(i, 1), cards.length);
          }, { passive: true });
        })();
      </script>
    </div>
  </section>

  <section class="jcs-shop" id="jc-buy" aria-labelledby="jc-buy-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>01</span>NUBE</p>
