  <section class="jcs-lab-follow jcs-home-follow" aria-labelledby="jc-home-follow-title">
    <div class="jcs-frame">
      {% if settings.jc_sale_mode != 'a_la_venta' %}
        <h2 class="jcs-lab-follow__line" id="jc-home-follow-title">¿Todavía no? Te escribimos.</h2>
        <p class="jcs-lab-follow__small">El día que sale la primera tanda, antes que a nadie. {% if settings.jc_waitlist_perk != blank %}{{ settings.jc_waitlist_perk }}{% endif %}</p>
      {% else %}
