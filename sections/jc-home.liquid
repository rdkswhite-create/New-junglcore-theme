{{ 'jc-shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign nube = section.settings.nube_product
  if nube == blank
    assign nube = all_products['nube']
  endif
  assign v = nube.selected_or_first_available_variant
-%}
<div class="jcs" id="top">
  {% render 'jc-header', buy_href: '#jc-buy' %}

  <section class="jcs-hero" aria-labelledby="jc-hero-title">
    <div class="jcs-hero__media">
      {% if section.settings.hero_video != blank %}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {% else %}
        <video src="{{ 'jc-hero-loop.mp4' | asset_url }}" poster="{{ 'jc-hero-loop-poster.jpg' | asset_url }}" autoplay muted loop playsinline preload="auto" aria-label="Una barra de NUBE cae en la licuadora con agua, se licúa y se sirve"></video>
      {% endif %}
    </div>
    <div class="jcs-hero__shade" aria-hidden="true"></div>
    <div class="jcs-hero__top"><span>Bebida vegetal de origen · Colombia</span></div>
    <div class="jcs-hero__body">
      <h1 class="jcs-hero__title" id="jc-hero-title">¿Quién dijo que una bebida vegetal tiene que venir en caja?</h1>
      <p class="jcs-hero__answer">Esta vive en tu congelador.</p>
      <div class="jcs-hero__actions">
        <a class="jcs-btn jcs-btn--light" href="#jc-buy"><span>{% if settings.jc_sale_mode == 'a_la_venta' %}Pide tu bolsa{% else %}Avísame · Lote 001{% endif %}</span><span class="jcs-arrow" aria-hidden="true">&rarr;</span></a>
        <a class="jcs-link" href="#jc-preparar">Cómo se prepara</a>
      </div>
      {%- if v and v.price > 0 -%}{%- assign hero_pg = v.price | divided_by: 30 -%}
      <p class="jcs-hero__price">{{ hero_pg | money_without_trailing_zeros }} el vaso · 1 bolsa = hasta 6 cajas</p>
      {%- endif -%}
    </div>
    <div class="jcs-hero__bottom">
      <img class="jcs-hero__wordmark" src="{{ 'jc-wordmark-refined-white.svg' | asset_url }}" alt="JUNGLCORE" width="953" height="96">
    </div>
  </section>

  <div class="jcs-steps-band" id="jc-preparar">
  <div class="jcs-strip jcs-steps" aria-label="Del congelador al vaso">
    <figure class="jcs-strip__item"><span class="jcs-steps__t" data-count="0">0 s</span><img src="{{ 'jc-nube-congelador.jpg' | asset_url }}" width="941" height="1671" loading="eager" alt="Una mano saca una barra de la bolsa de NUBE en el congelador"><figcaption><strong>La barra</strong><span>Del congelador</span></figcaption></figure>
    <figure class="jcs-strip__item"><span class="jcs-steps__t" data-count="10">10 s</span><video src="{{ 'jc-preparacion.mp4' | asset_url }}" poster="{{ 'jc-preparacion-poster.jpg' | asset_url }}" width="1280" height="720" autoplay muted loop playsinline preload="metadata" aria-label="Una barra de NUBE cae en la licuadora, se le agrega agua, se licúa y se sirve en un vaso"></video><figcaption><strong>Licúa</strong><span>30 segundos, con agua</span></figcaption></figure>
    <figure class="jcs-strip__item"><span class="jcs-steps__t" data-count="40">40 s</span><img src="{{ 'jc-nube-vaso.jpg' | asset_url }}" width="941" height="1672" loading="eager" alt="Un vaso de NUBE en una mesa de cocina con luz de mañana"><figcaption><strong>Listo</strong><span>Tu bebida vegetal</span><em class="jcs-steps__joke">30 segundos. La haces tú.</em></figcaption></figure>
  </div>
  </div>

  <section class="jcs-mine" aria-labelledby="jc-mine-title">
    <div class="jcs-frame">
      <h2 class="jcs-title" id="jc-mine-title">Elige tu NUBE.</h2>
      <p class="jcs-lead">Tú eliges la textura y cuántas barras preparar. Prepara lo que vas a tomar y conserva las demás congeladas.</p>
      <div class="jcs-mine__row">
        <a class="jcs-mine__opt" href="{{ routes.root_url }}products/nube#jc-textura"><strong>Cremosa.</strong><span>1 barra + 150 ml de agua. Espesa, para la avena o el desayuno.</span></a>
        <a class="jcs-mine__opt" href="{{ routes.root_url }}products/nube#jc-textura"><strong>Ligera.</strong><span>1 barra + 200 ml de agua. Fresca, para tomar sola.</span></a>
      </div>
      <p class="jcs-mine__note">Nota a avena tostada, final a nuez.</p>
    </div>
  </section>

  <script>
    (function () {
      var els = document.querySelectorAll('.jcs-steps__t[data-count]');
      if (!els.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      els.forEach(function (el) { if (+el.dataset.count > 0) el.textContent = '0 s'; });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return; io.unobserve(en.target);
          var el = en.target, to = +el.dataset.count, t0 = null, dur = 900 + to * 15;
          if (!to) return;
          function step(t) { if (!t0) t0 = t; var k = Math.min(1, (t - t0) / dur); el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3))) + ' s'; if (k < 1) requestAnimationFrame(step); }
          requestAnimationFrame(step);
        });
      }, { threshold: 0.6 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
  <section class="jcs-shop" id="{% if settings.jc_sale_mode == 'a_la_venta' %}jc-buy{% else %}jc-nube{% endif %}" aria-labelledby="jc-buy-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>01</span>NUBE · Lote 001</p>
      <div class="jcs-shop__grid">
        <div>
          <div class="jcs-shop__visual">
            {% if section.settings.nube_image != blank %}
              {{ section.settings.nube_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Bolsa JUNGLCORE NUBE' }}
            {% else %}
              <img class="jcs-pack-photo" src="{{ 'jc-nube-bolsa.jpg' | asset_url }}" width="1254" height="1254" loading="lazy" alt="Bolsa JUNGLCORE NUBE: 30 barras congeladas de sacha inchi">
            {% endif %}
          </div>
        </div>
        <div>
          <h2 class="visually-hidden" id="jc-buy-title">Comprar NUBE</h2>
          {% if nube != blank %}
            {% render 'jc-buy-box', product: nube, form_id: 'jcs-home-buy', show_title: true, list_separate: true %}
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% render 'jc-noes', number: '02' %}

  <section class="jcs-origin-block" id="jc-origen" aria-labelledby="jc-origin-title">
    <div class="jcs-frame">
      <p class="jcs-chapter"><span>03</span>Tu bebida tiene origen</p>
