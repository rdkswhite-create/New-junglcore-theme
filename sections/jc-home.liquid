  {% if nube != blank %}{% render 'jc-sticky-buy', product: nube %}{% endif %}
</div>

{% schema %}
{
  "name": "JUNGLCORE inicio",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "nube_product", "label": "Producto NUBE" },
    { "type": "video", "id": "hero_video", "label": "Vídeo de portada (opcional)" },
    { "type": "video", "id": "film_desktop", "label": "Película ¿Qué es NUBE?, versión horizontal para escritorio (opcional)" },
    { "type": "image_picker", "id": "nube_image", "label": "Imagen de la bolsa (opcional)" },
    { "type": "header", "content": "Dos momentos" },
    { "type": "image_picker", "id": "morning_image", "label": "Foto de la mañana" },
    { "type": "image_picker", "id": "night_image", "label": "Foto de la noche" },
    { "type": "header", "content": "Hallazgos" },
    { "type": "url", "id": "hallazgos_url", "label": "Enlace al último hallazgo (Instagram)" },
    { "type": "text", "id": "hallazgo_dia", "label": "Hallazgo del día (opcional)", "info": "Déjalo vacío y cambia solo cada día, entre siete hallazgos. Escribe uno aquí para fijarlo." },
    { "type": "header", "content": "Datos legales" },
    { "type": "text", "id": "legal_name", "label": "Razón social" },
    { "type": "text", "id": "legal_nit", "label": "NIT" },
    { "type": "text", "id": "legal_address", "label": "Dirección" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Lo que dijo, palabra por palabra" },
        { "type": "text", "id": "name", "label": "Nombre (con su permiso)" },
        { "type": "text", "id": "place", "label": "Barrio o ciudad" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "JUNGLCORE inicio" }]
}
{% endschema %}
